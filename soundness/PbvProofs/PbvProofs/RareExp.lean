/-- RARE rule `exp-const-base-zero`. -/
theorem exp_const_base_zero (t : Int) :
    (smtExp 0 t) = (if (t = 0) then 1 else 0) := by
  unfold smtExp
  by_cases h0 : t = 0
  · subst h0; simp
  · rw [ite_eq_right h0]
    split_ifs with h
    · exact zero_pow (by omega)
    · simp [zero_pow (show (-t).toNat ≠ 0 by omega)]

/-- RARE rule `exp-const-neg`. -/
theorem exp_const_neg (s t : Int) (h0 : ((t < 0) ∧ (¬(s = 1)) ∧ (¬(s = (-1))))) :
    (smtExp s t) = 0 := by
  obtain ⟨ht, hs1, hs2⟩ := h0
  rw [smtExp_of_neg ht]
  have hn1 : 1 ≤ (-t).toNat := by omega
  by_cases hs0 : s = 0
  · subst hs0; simp [zero_pow (show (-t).toNat ≠ 0 by omega)]
  · apply Int.ediv_eq_zero_of_lt_abs (by norm_num)
    have h2 : (2 : Int) ≤ |s| := by
      rcases abs_cases s with ⟨h, _⟩ | ⟨h, _⟩ <;> omega
    rw [abs_pow]
    calc (1 : Int) < 2 := by norm_num
      _ ≤ |s| := h2
      _ = |s| ^ 1 := (pow_one _).symm
      _ ≤ |s| ^ (-t).toNat := pow_le_pow_right₀ (by omega) hn1

/-- RARE rule `exp-normalize`. -/
theorem exp_normalize (a e c : Int) (h0 : ((e ≥ 0) ∧ (c ≥ 2))) :
    (smtExp (smtExp a e) c) = ((smtExp a e) * (smtExp (smtExp a e) (c - 1))) := by
  exact smtExp_succ (by omega)

/-- RARE rule `exp-unroll`. -/
theorem exp_unroll (s c : Int) (h0 : ((c ≥ 2) ∧ (c ≤ 8))) :
    (smtExp s c) = (s * (smtExp s (c - 1))) := by
  exact smtExp_succ (by omega)

/-- RARE rule `exp-reduce-mul`. -/
theorem exp_reduce_mul (b e c : Int) (h0 : ((e ≥ 0) ∧ (c ≥ 0))) :
    (smtExp b (e + c)) = ((smtExp b c) * (smtExp b e)) := by
  rw [smtExp_add h0.1 h0.2, mul_comm]

/-- RARE rule `exp-reduce-mul-neg-one`. -/
theorem exp_reduce_mul_neg_one (e c : Int) (h0 : (c ≥ 0)) :
    (smtExp (-1) (e + c)) = ((smtExp (-1) c) * (smtExp (-1) e)) := by
  obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le h0
  simp [smtExp_negOne, negOne_pow_natAbs_add]

/-- RARE rule `exp-reduce-div`. -/
theorem exp_reduce_div (b f c : Int) (h0 : ((¬(b = 0)) ∧ (c ≥ 0) ∧ (((f - c) ≥ 0) ∨ (b = 1) ∨ (b = (-1))))) :
    (smtExp b (f - c)) = ((smtExp b f) / (smtExp b c)) := by
  obtain ⟨hb, hc, hu⟩ := h0
  obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hc
  have h := smtExp_add_nat_guarded (b := b) (e := f - n) n hu
  rw [show f - (n : Int) + n = f by omega] at h
  rw [h, smtExp_natCast, Int.mul_ediv_cancel_left _ (pow_ne_zero n hb)]

/-- RARE rule `exp-div-fuse`. -/
theorem exp_div_fuse (x p q : Int) (h0 : ((p > 0) ∧ (q > 0))) :
    ((x / p) / q) = (x / (p * q)) := by
  exact Int.ediv_ediv_of_nonneg h0.1.le

/-- RARE rule `exp-shl-past`. -/
theorem exp_shl_past (a e k r : Int) (h0 : ((k ≥ 0) ∧ (e ≥ k))) :
    (((a * (smtExp 2 e)) + r) % (smtExp 2 k)) = (r % (smtExp 2 k)) := by
  obtain ⟨hk, hek⟩ := h0
  have hd : smtExp 2 k ∣ smtExp 2 e := by
    rw [smtExp_of_nonneg hk, smtExp_of_nonneg (by omega)]
    exact pow_dvd_pow 2 (by omega)
  obtain ⟨d, hd⟩ := hd
  rw [hd, show a * (smtExp 2 k * d) + r = r + smtExp 2 k * (a * d) by ring,
    Int.add_mul_emod_self_left]

/-- RARE rule `exp-shl-past-single`. -/
theorem exp_shl_past_single (a e k : Int) (h0 : ((k ≥ 0) ∧ (e ≥ k))) :
    ((a * (smtExp 2 e)) % (smtExp 2 k)) = 0 := by
  obtain ⟨hk, hek⟩ := h0
  have hd : smtExp 2 k ∣ smtExp 2 e := by
    rw [smtExp_of_nonneg hk, smtExp_of_nonneg (by omega)]
    exact pow_dvd_pow 2 (by omega)
  obtain ⟨d, hd⟩ := hd
  rw [hd, show a * (smtExp 2 k * d) = smtExp 2 k * (a * d) by ring]
  exact Int.mul_emod_right _ _

/-! ### The side conditions cannot be dropped -/

/-- **unroll** is NOT sound for a negative numeral exponent read as a product
(SwInE's `s^|c|` reading): `exp(2, -1) = 0 ≠ 2`. -/
theorem exp_unroll_neg_unsound : smtExp 2 (-1) ≠ 2 := by decide

/-- **reduce-mul** without `e ≥ 0`: `b = 2, e = -1, c = 1` gives `exp(2,0) = 1`
but `exp(2,1) · exp(2,-1) = 0`. -/
theorem exp_reduce_mul_unguarded_unsound :
    ¬ ∀ (b e c : Int), c ≥ 0 → smtExp b (e + c) = smtExp b c * smtExp b e := by
  intro h; have := h 2 (-1) 1 (by decide); revert this; decide

/-- **reduce-div** without `b ≠ 0`: `exp(0,0) = 1` but `exp(0,1) div exp(0,1) = 0`. -/
theorem exp_reduce_div_unguarded_unsound_base_zero :
    ¬ ∀ (b f c : Int), c ≥ 0 → f - c ≥ 0 → smtExp b (f - c) = smtExp b f / smtExp b c := by
  intro h; have := h 0 1 1 (by decide) (by decide); revert this; decide

/-- **reduce-div** without `f - c ≥ 0` for a non-unit base: `b = -2, f = 1, c = 2`:
`exp(-2,-1) = 0` but `(-2) div 4 = -1` (Euclidean). -/
theorem exp_reduce_div_unguarded_unsound_neg_exp :
    ¬ ∀ (b f c : Int), b ≠ 0 → c ≥ 0 → smtExp b (f - c) = smtExp b f / smtExp b c := by
  intro h; have := h (-2) 1 2 (by decide) (by decide); revert this; decide

/-- **shl-past** without `k ≥ 0`: with `k = -1`, `2^k = 0`, so `mod 2^k` is the
identity, and `1 · 2^0` does not vanish: `1 mod 0 = 1 ≠ 0 = 0 mod 0`. -/
theorem exp_shl_past_unguarded_unsound :
    ¬ ∀ (a e k r : Int), e ≥ k → (a * smtExp 2 e + r) % smtExp 2 k = r % smtExp 2 k := by
  intro h; have := h 1 0 (-1) 0 (by decide); revert this; decide

