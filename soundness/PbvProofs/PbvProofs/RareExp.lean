/-! ### Helper facts about `smtExp` -/

theorem smtExp_add {s a b : Int} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    smtExp s (a + b) = smtExp s a * smtExp s b := by
  rw [smtExp_of_nonneg (by omega), smtExp_of_nonneg ha, smtExp_of_nonneg hb,
    Int.toNat_add ha hb, pow_add]

theorem smtExp_add_nat {s e : Int} (c : Nat) (he : 0 ≤ e) :
    smtExp s (e + c) = s ^ c * smtExp s e := by
  rw [smtExp_add he (by omega), smtExp_natCast, mul_comm]

/-- One step of unrolling: `s^c = s * s^(c-1)` for `c ≥ 1`. -/
theorem smtExp_succ {s c : Int} (hc : 1 ≤ c) : smtExp s c = s * smtExp s (c - 1) := by
  rw [smtExp_of_nonneg (by omega), smtExp_of_nonneg (by omega),
    show c.toNat = (c - 1).toNat + 1 by omega, pow_succ, mul_comm]

/-- `(-1) ** t = (-1)^|t|` for every integer `t` (negative `t`: `1 div ±1 = ±1`). -/
theorem smtExp_negOne (t : Int) : smtExp (-1) t = (-1) ^ t.natAbs := by
  unfold smtExp
  split_ifs with h
  · congr 1; omega
  · have : (-t).toNat = t.natAbs := by omega
    rw [this]
    rcases neg_one_pow_eq_or ℤ t.natAbs with h1 | h1 <;> rw [h1] <;> decide

theorem smtExp_one (t : Int) : smtExp 1 t = 1 := by
  unfold smtExp; split_ifs <;> simp

theorem negOne_pow_natAbs_add (e : Int) (c : Nat) :
    ((-1 : Int) ^ (e + c).natAbs) = (-1) ^ c * (-1) ^ e.natAbs := by
  rw [← pow_add]
  rw [neg_one_pow_eq_pow_mod_two (R := ℤ), neg_one_pow_eq_pow_mod_two (R := ℤ) (n := c + e.natAbs)]
  congr 1
  omega

/-- reduce-mul under either guard of the paper: `e ≥ 0`, or a unit base. -/
theorem smtExp_add_nat_guarded {b e : Int} (c : Nat) (he : 0 ≤ e ∨ b = 1 ∨ b = -1) :
    smtExp b (e + c) = b ^ c * smtExp b e := by
  rcases he with he | rfl | rfl
  · exact smtExp_add_nat c he
  · simp [smtExp_one]
  · simp [smtExp_negOne, negOne_pow_natAbs_add]


/-- RARE rule `exp-const-zero`. -/
theorem exp_const_zero (s : Int) :
    (smtExp s 0) = 1 := by
  first
      | (rfl; done)
      | (simp; done)
      | (simp_all [smtExp, piandZ, piand]; done)
      | ((unfold smtExp; split_ifs <;> simp_all); done)
      | ((unfold piandZ; split_ifs <;> simp_all [piand]); done)
      | (omega; done)

/-- RARE rule `exp-const-one`. -/
theorem exp_const_one (s : Int) :
    (smtExp s 1) = s := by
  first
      | (rfl; done)
      | (simp; done)
      | (simp_all [smtExp, piandZ, piand]; done)
