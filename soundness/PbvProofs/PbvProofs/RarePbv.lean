/-- RARE rule `pbv-merge-lshr`. -/
theorem pbv_merge_lshr {w : Nat} (x y z : BitVec w) (hw : 0 < w) :
    ((x >>> y) >>> z) = (if (y.ule (y + z)) then (x >>> (y + z)) else (0#w)) := by
  have hw2 : w < 2 ^ w := Nat.lt_two_pow_self
  have hs := toNat_add_cases y z
  by_cases h : y.toNat + z.toNat < 2 ^ w
  · have hu : y.ule (y + z) = true :=
      BitVec.ule_iff_toNat_le.mpr (by rw [hs, ite_eq_left h]; omega)
    rw [ite_eq_left hu]
    apply BitVec.eq_of_getLsbD_eq; intro t ht
    simp only [BitVec.ushiftRight_eq', BitVec.getLsbD_ushiftRight]
    rw [hs, ite_eq_left h]; congr 1; omega
  · have hn : ¬ y.toNat ≤ (y + z).toNat := by
      rw [hs, ite_eq_right h]; have := z.isLt; omega
    have hu : y.ule (y + z) = false := by
      rw [Bool.eq_false_iff]; intro hh; exact hn (BitVec.ule_iff_toNat_le.mp hh)
    rw [hu]; simp only [Bool.false_eq_true, ↓reduceIte]
    apply BitVec.eq_of_getLsbD_eq; intro t ht
    simp only [BitVec.ushiftRight_eq', BitVec.getLsbD_ushiftRight, BitVec.getLsbD_zero]
    apply BitVec.getLsbD_of_ge; omega

