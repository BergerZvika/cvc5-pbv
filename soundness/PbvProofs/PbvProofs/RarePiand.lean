open BitVec

/-- `piand` at an integer width, as cvc5 has it: `0` for `k ≤ 0`, and
otherwise the bitwise AND of the `k`-bit residues of `x` and `y`. -/
def piandZ (k x y : Int) : Int := if 0 < k then piand k.toNat x y else 0

theorem piand_comm' (n : Nat) (x y : Int) : piand n x y = piand n y x := by
  unfold piand; rw [Nat.land_comm]

theorem piand_range (n : Nat) (x y : Int) : 0 ≤ piand n x y ∧ piand n x y < 2 ^ n := by
  unfold piand
  have hp : (0 : Int) < 2 ^ n := by positivity
  have h2 := Int.emod_nonneg y (ne_of_gt hp)
  have h1 := Int.emod_lt_of_pos y hp
  have hy : (y % 2 ^ n).toNat < 2 ^ n := by
    have : (((y % 2 ^ n).toNat : Nat) : Int) < 2 ^ n := by
      rw [Int.toNat_of_nonneg h2]; exact h1
    exact_mod_cast this
  constructor
  · positivity
  · exact_mod_cast Nat.and_lt_two_pow _ hy

/-- Absorption at a natural width: `x & (x & y) = x & y`. -/
theorem piand_absorb_nat (n : Nat) (x y : Int) : piand n x (piand n x y) = piand n x y := by
  obtain ⟨h0, h1⟩ := piand_range n x y
  have hm : piand n x y % 2 ^ n = piand n x y := Int.emod_eq_of_lt h0 h1
  show ((((x % 2 ^ n).toNat &&& (piand n x y % 2 ^ n).toNat : Nat)) : Int) = piand n x y
  rw [hm]
  unfold piand
  rw [Int.toNat_natCast, ← Nat.and_assoc, Nat.and_self]


/-- RARE rule `piand-zero-left`. -/
theorem piand_zero_left (k y : Int) :
    (piandZ k 0 y) = 0 := by
  first
      | (rfl; done)
      | (simp; done)
      | (simp_all [smtExp, piandZ, piand]; done)
      | ((unfold smtExp; split_ifs <;> simp_all); done)
      | ((unfold piandZ; split_ifs <;> simp_all [piand]); done)
      | (omega; done)

/-- RARE rule `piand-zero-right`. -/
theorem piand_zero_right (k x : Int) :
    (piandZ k x 0) = 0 := by
  first
      | (rfl; done)
      | (simp; done)
      | (simp_all [smtExp, piandZ, piand]; done)
      | ((unfold smtExp; split_ifs <;> simp_all); done)
      | ((unfold piandZ; split_ifs <;> simp_all [piand]); done)
      | (omega; done)

/-- RARE rule `piand-idem`. -/
theorem piand_idem (k x : Int) :
    (piandZ k x x) = (if (k > 0) then (x % (smtExp 2 k)) else 0) := by
  unfold piandZ
  by_cases hk : 0 < k
  · rw [ite_eq_left hk, ite_eq_left hk, smtExp_of_nonneg (by omega)]
    unfold piand
    rw [Nat.and_self, Int.toNat_of_nonneg (Int.emod_nonneg _ (by positivity))]
  · rw [ite_eq_right hk, ite_eq_right (by omega)]

/-- RARE rule `piand-absorb-ll`. -/
theorem piand_absorb_ll (k x y : Int) :
    (piandZ k x (piandZ k x y)) = (piandZ k x y) := by
  unfold piandZ
  split_ifs with hk
  · exact piand_absorb_nat _ _ _
  · rfl

/-- RARE rule `piand-absorb-lr`. -/
theorem piand_absorb_lr (k x y : Int) :
    (piandZ k x (piandZ k y x)) = (piandZ k y x) := by
  unfold piandZ
  split_ifs with hk
  · rw [piand_comm' _ y x]; exact piand_absorb_nat _ _ _
  · rfl

/-- RARE rule `piand-absorb-rl`. -/
theorem piand_absorb_rl (k x y : Int) :
    (piandZ k (piandZ k x y) x) = (piandZ k x y) := by
  unfold piandZ
  split_ifs with hk
  · rw [piand_comm' _ (piand _ x y) x]; exact piand_absorb_nat _ _ _
  · rfl

/-- RARE rule `piand-absorb-rr`. -/
theorem piand_absorb_rr (k x y : Int) :
    (piandZ k (piandZ k y x) x) = (piandZ k y x) := by
  unfold piandZ
  split_ifs with hk
  · rw [piand_comm' _ y x, piand_comm' _ (piand _ x y) x]; exact piand_absorb_nat _ _ _
  · rfl

