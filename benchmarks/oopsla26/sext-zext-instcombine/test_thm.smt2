; ∀ (x : BitVec 8), (signExtend 32 x).sshiftRight' 8#32 = signExtend 32 (x.sshiftRight' 7#8)
(set-logic PBV)
(declare-const w32 Int)
(declare-const w8 Int)
(declare-const w7 Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) w8))
(assert (= (+ w7 1) w8))
(assert (< w8 w32))
(assert (not (= (pbvashr (psign_extend (- w32 w8) x) (int_to_pbv w32 w8)) (psign_extend (- w32 w8) (pbvashr x (int_to_pbv w8 w7))))))
(check-sat)
