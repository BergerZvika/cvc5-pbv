; ∀ (x y : BitVec wa) (wt : Int), wa < wt →
;   ofBool (zeroExtend wt x <=ᵤ zeroExtend wt y) = ofBool (x <=ᵤ y)
(set-logic PBV)
(declare-const wa Int)
(declare-const wt Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) wa))
(declare-const y PBitVec)
(assert (= (pbvsize y) wa))
(assert (< wa wt))
(assert (not (= (ite (pbvule (pzero_extend (- wt wa) x) (pzero_extend (- wt wa) y)) (int_to_pbv 1 1) (int_to_pbv 1 0)) (ite (pbvule x y) (int_to_pbv 1 1) (int_to_pbv 1 0)))))
(check-sat)
