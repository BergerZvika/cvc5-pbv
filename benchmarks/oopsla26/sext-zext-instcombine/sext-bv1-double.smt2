; ∀ (c : BitVec 1) (wt : Int), 1 < wt →
;   signExtend wt c + signExtend wt c = 0 - (zeroExtend wt c + zeroExtend wt c)
; (2*sext(c): c=0→0=-(0+0); c=1→-2=-(1+1))
(set-logic PBV)
(declare-const wt Int)
(declare-const c PBitVec)
(assert (= (pbvsize c) 1))
(assert (< 1 wt))
(assert (not (= (pbvadd (psign_extend (- wt 1) c) (psign_extend (- wt 1) c)) (pbvsub (int_to_pbv wt 0) (pbvadd (pzero_extend (- wt 1) c) (pzero_extend (- wt 1) c))))))
(check-sat)
