; ∀ (c : BitVec 1) (x y : BitVec wt) (wt : Int), 1 < wt →
;   x &&& signExtend wt c ||| y &&& bvnot(signExtend wt c)
;   = ite(c = 1, x, y)
(set-logic PBV)
(declare-const wt Int)
(declare-const c PBitVec)
(assert (= (pbvsize c) 1))
(declare-const x PBitVec)
(assert (= (pbvsize x) wt))
(declare-const y PBitVec)
(assert (= (pbvsize y) wt))
(assert (< 1 wt))
(assert (not (= (pbvor (pbvand x (psign_extend (- wt 1) c)) (pbvand y (pbvnot (psign_extend (- wt 1) c)))) (ite (= c (int_to_pbv 1 1)) x y))))
(check-sat)
