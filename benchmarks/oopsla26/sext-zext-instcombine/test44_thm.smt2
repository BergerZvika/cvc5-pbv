(set-logic PBV)
(declare-const w1 Int)
(declare-const w2 Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) w1))
(declare-const K PBitVec)
(assert (= (pbvsize K) w2))
(assert (<= w1 w2))
(assert (pbvult K (pbvshl (int_to_pbv w2 1) (int_to_pbv w2 (- w2 1)))))
(assert (not (= (int_to_pbv w2 0) (pbvand (pbvshl (int_to_pbv w2 1) (int_to_pbv w2 (- w2 1))) (pbvor (pzero_extend (- w2 w1) x) K)))))
(check-sat)
