(set-logic PBV)
(declare-const w1 Int)
(declare-const w2 Int)
(declare-const w3 Int)
(declare-const w4 Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) w1))
(assert (<= w1 w2))
(assert (<= w2 w3))
(assert (<= w3 w4))
(assert (not (= (pzero_extend (- w4 w3) (pzero_extend (- w3 w2) (pzero_extend (- w2 w1) x))) (pzero_extend (- w4 w1) x))))
(check-sat)
