; fold_zext_xor_sandwich_thm (generalized)
; ∀ (x c : BitVec wa) (d : BitVec wt), wa < wt →
;   zeroExtend wt (x ^^^ c) ^^^ d = zeroExtend wt x ^^^ (zeroExtend wt c ^^^ d)
(set-logic PBV)
(declare-const wa Int)
(declare-const wt Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) wa))
(declare-const c PBitVec)
(assert (= (pbvsize c) wa))
(declare-const d PBitVec)
(assert (= (pbvsize d) wt))
(assert (< wa wt))
(assert (not (= (pbvxor (pzero_extend (- wt wa) (pbvxor x c)) d) (pbvxor (pzero_extend (- wt wa) x) (pbvxor (pzero_extend (- wt wa) c) d)))))
(check-sat)
