; fold_zext_xor_sandwich (with parameter c)
; ∀ (x c : BitVec wa) (d : BitVec wt), wa < wt →
;   zeroExtend wt (x ^^^ c) ^^^ d = zeroExtend wt x ^^^ (zeroExtend wt c ^^^ d)
; (already have fold-zext-xor-sandwich.smt2, this is same thing - skip dup)
; Instead: andzextor: zext(x &&& c) &&& d = zext(x) &&& (zext(c) &&& d)
(set-logic PBV)
(declare-const wa Int)
(declare-const wt Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) wa))
(declare-const c PBitVec)
(assert (= (pbvsize c) wa))
(declare-const d PBitVec)
(assert (= (pbvsize d) wt))
(assert (< wa wt))
(assert (not (= (pbvand (pzero_extend (- wt wa) (pbvand x c)) d) (pbvand (pzero_extend (- wt wa) x) (pbvand (pzero_extend (- wt wa) c) d)))))
(check-sat)
