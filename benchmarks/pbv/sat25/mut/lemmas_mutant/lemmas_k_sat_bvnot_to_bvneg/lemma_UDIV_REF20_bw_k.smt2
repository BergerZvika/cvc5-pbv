(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_UDIV_REF20 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (distinct s (pbvneg (pbvlshr s (pbvlshr t (int_to_pbv (pbvsize x) 1))))))
(assert (= t (pbvudiv x s)))
(assert (not (lemma_UDIV_REF20 x s t)))
(check-sat)
