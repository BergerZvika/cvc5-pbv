(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_UDIV_REF10 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (distinct (pbvor s t) (pbvand x (pbvneg (int_to_pbv (pbvsize x) 1)))))
(assert (= t (pbvudiv x s)))
(assert (not (lemma_UDIV_REF10 x s t)))
(check-sat)
