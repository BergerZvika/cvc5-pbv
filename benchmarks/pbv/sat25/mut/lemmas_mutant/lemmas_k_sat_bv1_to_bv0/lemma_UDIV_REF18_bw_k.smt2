(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_UDIV_REF18 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (pbvuge x (pbvand (pbvor x s) (pbvshl t (int_to_pbv (pbvsize x) 0)))))
(assert (= t (pbvudiv x s)))
(assert (not (lemma_UDIV_REF18 x s t)))
(check-sat)
