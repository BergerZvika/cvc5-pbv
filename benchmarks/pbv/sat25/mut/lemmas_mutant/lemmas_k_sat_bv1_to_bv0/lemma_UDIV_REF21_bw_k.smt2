(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_UDIV_REF21 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (distinct x (pbvnot (pbvand x (pbvshl t (int_to_pbv (pbvsize x) 0))))))
(assert (= t (pbvudiv x s)))
(assert (not (lemma_UDIV_REF21 x s t)))
(assert (> (pbvsize x) 1))
(check-sat)
