(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_UDIV_REF16 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (pbvuge t (pbvshl (pbvlshr x s) (int_to_pbv (pbvsize x) 0))))
