(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_MUL_REFN13 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (distinct s (pbvadd (int_to_pbv (pbvsize x) 0) (pbvshl s (pbvsub x t)))))
(assert (= t (pbvmul x s)))
(assert (not (lemma_MUL_REFN13 x s t)))
(check-sat)
