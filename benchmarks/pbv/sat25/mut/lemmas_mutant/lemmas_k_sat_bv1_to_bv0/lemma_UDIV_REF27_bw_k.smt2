(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_UDIV_REF27 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (pbvuge x (pbvxor s (pbvlshr s (pbvlshr t (int_to_pbv (pbvsize x) 0))))))
(assert (= t (pbvudiv x s)))
(assert (not (lemma_UDIV_REF27 x s t)))
