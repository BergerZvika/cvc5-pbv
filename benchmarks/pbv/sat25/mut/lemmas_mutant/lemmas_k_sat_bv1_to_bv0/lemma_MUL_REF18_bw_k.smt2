(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_MUL_REF18 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (distinct x (pbvsub (int_to_pbv (pbvsize x) 0) (pbvshl x (pbvsub s t)))))
(assert (= t (pbvmul x s)))
(assert (not (lemma_MUL_REF18 x s t)))
(check-sat)
