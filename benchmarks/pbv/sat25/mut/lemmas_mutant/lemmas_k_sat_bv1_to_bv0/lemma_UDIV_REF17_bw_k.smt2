(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_UDIV_REF17 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (pbvuge x (pbvand (pbvor x t) (pbvshl s (int_to_pbv (pbvsize x) 0)))))
(assert (= t (pbvudiv x s)))
(assert (not (lemma_UDIV_REF17 x s t)))
(check-sat)
