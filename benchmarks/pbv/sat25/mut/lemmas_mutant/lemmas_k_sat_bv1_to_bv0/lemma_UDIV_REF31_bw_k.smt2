(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_UDIV_REF31 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (distinct x (pbvadd t (pbvadd (int_to_pbv (pbvsize x) 0) (pbvshl (int_to_pbv (pbvsize x) 1) x)))))
(assert (= t (pbvudiv x s)))
(assert (not (lemma_UDIV_REF31 x s t)))
(assert (> (pbvsize x) 2))
(check-sat)
