(set-logic PBV)
(declare-fun C () PBitVec)
(declare-fun %Y () PBitVec)
(declare-fun C2 () PBitVec)
(declare-fun %X () PBitVec)
(assert (and (pbvult C (int_to_pbv (pbvsize C) 0)) (not (= (pbvshl (pbvxor %Y (pbvand (pbvlshr %X C) C2)) C) (pbvxor (pbvand %X (pbvshl C2 C)) (pbvshl %Y C))))))
(check-sat)