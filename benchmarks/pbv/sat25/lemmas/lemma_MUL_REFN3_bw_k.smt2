(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_MUL_REFN3 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (distinct t (pbvshl (pbvor s (int_to_pbv (pbvsize x) 1)) (pbvshl t x))))
(assert (= t (pbvmul x s)))
(assert (not (lemma_MUL_REFN3 x s t)))
(assert (> (pbvsize x) 1))
(check-sat)
