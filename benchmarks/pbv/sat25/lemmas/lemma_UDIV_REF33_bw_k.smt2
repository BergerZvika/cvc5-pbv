(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_UDIV_REF33 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (distinct x (pbvadd t (pbvadd t (pbvor x s)))))
(assert (= t (pbvudiv x s)))
(assert (not (lemma_UDIV_REF33 x s t)))
(assert (> (pbvsize x) 1))
(check-sat)
(get-value (x s t))