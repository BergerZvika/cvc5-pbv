(set-logic PBV)

(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_MUL_REFN5 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (pbvuge t (pbvand (int_to_pbv (pbvsize x) 1) (pbvlshr (pbvand x s) (int_to_pbv (pbvsize x) 1)))))
(assert (= t (pbvmul x s)))
(assert (not (lemma_MUL_REFN5 x s t)))
(assert (distinct (pbvsize x) 2))
(check-sat)
