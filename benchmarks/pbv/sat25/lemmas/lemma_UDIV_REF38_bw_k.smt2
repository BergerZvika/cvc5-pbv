(set-logic PBV)
(declare-const x PBitVec)
(declare-const s PBitVec)
(declare-const t PBitVec)
(define-fun lemma_UDIV_REF38 ((x PBitVec) (s PBitVec) (t PBitVec)) Bool (distinct x (pbvsub (int_to_pbv (pbvsize x) 1) (pbvshl x (pbvsub x t)))))
(assert (= t (pbvudiv x s)))
(assert (not (lemma_UDIV_REF38 x s t)))
(assert (distinct (pbvsize x) 2))
(check-sat)
