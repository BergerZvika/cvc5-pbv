(set-logic PBV)
(declare-const m Int)
(declare-const k Int)
(declare-const n Int)
(declare-const i Int)
(declare-const j Int)
(declare-const l Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) m))
(declare-const y PBitVec)
(assert (= (pbvsize y) m))
(declare-const z PBitVec)
(assert (= (pbvsize z) m))
(assert (and (<= 0 l) (< l m)))
(assert (and (<= 0 k) (< k m)))
(assert (and (<= 0 i) (< i m)))
(assert (and (<= 0 j) (< j m)))
(assert (<= l k))
(assert (<= k (- i j)))
(assert (not (= (pextract (pbvnot (pextract x i j)) k l) (pextract (pbvnot x) (+ k j) (+ l j)))))
(check-sat)
