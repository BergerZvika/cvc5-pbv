(set-logic PBV)
(declare-const k Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) k))
(declare-const y PBitVec)
(assert (= (pbvsize y) k))
(declare-const z PBitVec)
(assert (= (pbvsize z) k))
(declare-const a PBitVec)
(assert (= (pbvsize a) k))
(declare-const b PBitVec)
(assert (= (pbvsize b) k))
(assert (= a (pbvxor x (pbvxor y z))))
(assert (= b (pbvor (pbvand x y) (pbvor (pbvand x z) (pbvand y z)))))
(assert (not (= (pbvadd x (pbvadd y z)) (pbvadd a (pbvmul (int_to_pbv k 2) b)))))
(check-sat)
