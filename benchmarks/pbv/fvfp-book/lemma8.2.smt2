(set-logic PBV)
(declare-const k Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) k))
(declare-const y PBitVec)
(assert (= (pbvsize y) k))
(declare-const p PBitVec)
(assert (= (pbvsize p) k))
(declare-const g PBitVec)
(assert (= (pbvsize g) k))
(assert (= p (pbvxor x y)))
(assert (= g (pbvand x y)))
(assert (not (= (pbvadd x y) (pbvadd p (pbvmul (int_to_pbv k 2) g)))))
(check-sat)
