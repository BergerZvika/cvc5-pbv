(set-logic PBV)
(declare-const k Int)
(declare-const n Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) k))
(declare-const y PBitVec)
(assert (= (pbvsize y) k))
(declare-const z PBitVec)
(assert (= (pbvsize z) k))
(assert (<= 0 n))
(assert (< n k))
(assert (= (pextract (pbvnot x) n n) (pextract x n n)))
(check-sat)
