(set-logic PBV)
(declare-const k Int)
(declare-const n Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) k))
(declare-const y PBitVec)
(assert (= (pbvsize y) k))
(declare-const z PBitVec)
(assert (= (pbvsize z) k))
(assert (not (= (pbvand (pbvnot (pextract x (- n 1) 0)) y) (pbvand (pextract (pbvnot x) (- n 1) 0) y))))
(check-sat)
