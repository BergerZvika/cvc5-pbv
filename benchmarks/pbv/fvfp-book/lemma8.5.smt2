(set-logic PBV)
(declare-const n Int)
(declare-const k Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) n))
(declare-const y PBitVec)
(assert (= (pbvsize y) n))
(assert (> n 0))
(assert (>= k 0))
(assert (< k n))
(assert (not (= (= (pextract (pbvadd (pbvadd x y) (int_to_pbv n 1)) k 0) (int_to_pbv (+ k 1) 0)) (= (pextract (pbvnot (pbvxor x y)) k 0) (int_to_pbv (+ k 1) 0)))))
(check-sat)
