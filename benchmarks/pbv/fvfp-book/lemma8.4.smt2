(set-logic PBV)
(declare-const k Int)
(declare-const n Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) k))
(declare-const y PBitVec)
(assert (= (pbvsize y) k))
(declare-const s PBitVec)
(assert (= (pbvsize s) k))
(declare-const p PBitVec)
(assert (= (pbvsize p) k))
(assert (>= n 1))
(assert (<= n k))
(assert (= s (pbvadd x y)))
(assert (= p (pbvxor x y)))
(assert (not (= (= (pextract s (- n 1) 0) (pbvnot (int_to_pbv n 0))) (= (pextract p (- n 1) 0) (pbvnot (int_to_pbv n 0))))))
(check-sat)
