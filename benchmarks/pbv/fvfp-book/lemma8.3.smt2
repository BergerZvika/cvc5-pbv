(set-logic PBV)
(declare-const m Int)
(declare-const k Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) m))
(declare-const y PBitVec)
(assert (= (pbvsize y) m))
(declare-const c PBitVec)
(assert (= (pbvsize c) m))
(declare-const t PBitVec)
(assert (= (pbvsize t) m))
(assert (>= k 0))
(assert (< k m))
(assert (or (= c (int_to_pbv k 0)) (= c (int_to_pbv k 1))))
(assert (= t (pbvxor (pbvxor x y) (pbvor (pbvmul (int_to_pbv k 2) (pbvor x y)) c))))
(assert (not (= (= (pextract (pbvadd (pbvadd x y) c) k 0) (int_to_pbv m 0)) (= (pextract t k 0) (int_to_pbv m 0)))))
(check-sat)
