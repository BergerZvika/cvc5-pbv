(set-logic PBV)
(declare-const k Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) k))
(declare-const y PBitVec)
(assert (= (pbvsize y) k))
(declare-const z PBitVec)
(assert (= (pbvsize z) k))
(assert (not (= (pbvor (pbvand x y) (pbvor (pbvand x z) (pbvand y z))) (pbvor (pbvand x y) (pbvand (pbvxor x y) z)))))
(check-sat)
