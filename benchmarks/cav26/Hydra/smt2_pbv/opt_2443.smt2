(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-fun newvar0 () PBitVec)
(assert (= (pbvsize newvar0) r))
(assert (< 1 u))
(assert (> r u))
(assert (distinct (pzero_extend (- u 1) (ite (distinct (int_to_pbv r 0) (pbvand (int_to_pbv r 1) newvar0)) (int_to_pbv 1 1) (int_to_pbv 1 0))) (pextract (pbvand (int_to_pbv r 1) newvar0) (- u 1) 0)))
(check-sat)
