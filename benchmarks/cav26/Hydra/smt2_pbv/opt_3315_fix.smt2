(set-logic PBV)
(declare-const s Int)
(declare-const t Int)
(declare-const u Int)
(declare-fun newvar5 () Bool)
(declare-fun v0 () Bool)
(assert (< t u))
(assert (< 1 s))
(assert (< 1 u))
(assert (> s t))
(assert (> t 0))
(assert (distinct (distinct (pzero_extend (- u 1) (ite v0 (int_to_pbv 1 1) (int_to_pbv 1 0))) (pzero_extend (- u t) (pextract (pzero_extend (- s 1) (ite newvar5 (int_to_pbv 1 1) (int_to_pbv 1 0))) (- t 1) 0))) (xor v0 newvar5)))
(check-sat)
