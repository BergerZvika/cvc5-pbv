(set-logic PBV)
(declare-const r Int)
(declare-const t Int)
(declare-fun newvar1 () PBitVec)
(assert (= (pbvsize newvar1) t))
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(assert (< t r))
(assert (> r t))
(assert (> r t))
(assert (distinct (pextract (pbvadd symconst_1 (pzero_extend (- r t) newvar1)) (- t 1) 0) (pbvadd newvar1 (pextract symconst_1 (- t 1) 0))))
(check-sat)
