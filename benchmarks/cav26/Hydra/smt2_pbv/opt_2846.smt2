(set-logic PBV)
(declare-const r Int)
(declare-const v Int)
(declare-fun newvar1 () Bool)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) r))
(declare-fun symconst_3 () PBitVec)
(assert (= (pbvsize symconst_3) r))
(assert (> r v))
(assert (> r v))
(assert (> r v))
(assert (distinct (pextract (pbvxor symconst_3 (ite newvar1 symconst_1 symconst_2)) (- v 1) 0) (ite newvar1 (pextract (pbvxor symconst_3 symconst_1) (- v 1) 0) (pextract (pbvxor symconst_3 symconst_2) (- v 1) 0))))
(check-sat)
