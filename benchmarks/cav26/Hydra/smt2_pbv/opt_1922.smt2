(set-logic PBV)
(declare-const r Int)
(declare-const t Int)
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) t))
(declare-fun v0 () Bool)
(declare-fun v3 () PBitVec)
(assert (= (pbvsize v3) t))
(assert (< 1 r))
(assert (distinct (ite (distinct (int_to_pbv r 0) (pzero_extend (- r 1) (ite v0 (int_to_pbv 1 1) (int_to_pbv 1 0)))) symconst_2 v3) (ite v0 symconst_2 v3)))
(check-sat)
