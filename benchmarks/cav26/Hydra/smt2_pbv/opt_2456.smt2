(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) r))
(declare-fun v0 () Bool)
(assert (< r u))
(assert (< r u))
(assert (< r u))
(assert (distinct (pzero_extend (- u r) (ite v0 symconst_1 symconst_2)) (ite v0 (pzero_extend (- u r) symconst_1) (pzero_extend (- u r) symconst_2))))
(check-sat)
