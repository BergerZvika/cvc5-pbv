(set-logic PBV)
(declare-const s Int)
(declare-const u Int)
(declare-const x Int)
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) s))
(assert (< 1 x))
(assert (> s x))
(assert (distinct (pzero_extend (- x 1) (ite (distinct (int_to_pbv u 0) (ite (distinct (int_to_pbv s 0) (pbvand (int_to_pbv s 1) v0)) (int_to_pbv u 1) (int_to_pbv u 0))) (int_to_pbv 1 1) (int_to_pbv 1 0))) (pextract (pbvand (int_to_pbv s 1) v0) (- x 1) 0)))
(check-sat)
