(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-fun v1 () PBitVec)
(assert (= (pbvsize v1) r))
(declare-fun v4 () PBitVec)
(assert (= (pbvsize v4) r))
(assert (< r s))
(assert (< r s))
(assert (> s r))
(assert (distinct (pextract (pbvsub (pzero_extend (- s r) v4) (pzero_extend (- s r) v1)) (- r 1) 0) (pbvsub v4 v1)))
(check-sat)
