(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) r))
(declare-fun v3 () PBitVec)
(assert (= (pbvsize v3) r))
(assert (< r s))
(assert (< r s))
(assert (> s r))
(assert (distinct (pextract (pbvadd (pzero_extend (- s r) v0) (pzero_extend (- s r) v3)) (- r 1) 0) (pbvadd v0 v3)))
(check-sat)
