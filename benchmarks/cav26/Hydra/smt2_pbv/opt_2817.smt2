(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-fun newvar0 () PBitVec)
(assert (= (pbvsize newvar0) u))
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(assert (< u r))
(assert (> r u))
(assert (> r u))
(assert (distinct (pextract (pbvsub (pzero_extend (- r u) newvar0) symconst_1) (- u 1) 0) (pbvadd newvar0 (pextract (pbvsub (int_to_pbv r 0) symconst_1) (- u 1) 0))))
(check-sat)
