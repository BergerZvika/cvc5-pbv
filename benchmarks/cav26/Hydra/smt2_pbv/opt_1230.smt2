(set-logic PBV)
(declare-const s Int)
(declare-const t Int)
(declare-const x Int)
(declare-fun newvar1 () PBitVec)
(assert (= (pbvsize newvar1) x))
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) t))
(assert (< s t))
(assert (< x t))
(assert (> t x))
(assert (pbvule symconst_1 (pbvsub (pbvshl (int_to_pbv t 1) (pzero_extend (- t x) (int_to_pbv x x))) (int_to_pbv t 1))))
(assert (distinct (not (distinct symconst_1 (pzero_extend (- t x) newvar1))) (= newvar1 (pextract symconst_1 (- x 1) 0))))
(check-sat)
