(set-logic PBV)
(declare-const s Int)
(declare-const t Int)
(declare-const v Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) t))
(declare-fun v1 () PBitVec)
(assert (= (pbvsize v1) v))
(assert (< s t))
(assert (< v t))
(assert (> t v))
(assert (and (pbvult (int_to_pbv t 0) symconst_1) (pbvule symconst_1 (pzero_extend (- t v) (int_to_pbv v v)))))
(assert (distinct (= symconst_1 (pzero_extend (- t v) v1)) (= v1 (pextract symconst_1 (- v 1) 0))))
(check-sat)
