(set-logic PBV)
(declare-const q Int)
(declare-fun newvar1 () Bool)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) q))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) q))
(assert (distinct symconst_1 symconst_2))
(assert (distinct (distinct symconst_1 (ite newvar1 symconst_2 symconst_1)) newvar1))
(check-sat)
