(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-fun newvar4 () PBitVec)
(assert (= (pbvsize newvar4) r))
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) q))
(assert (< q r))
(assert (> r q))
(assert (> r q))
(assert (= symconst_1 (pzero_extend (- r q) symconst_2)))
(assert (distinct (pbvsub (pextract (pbvadd symconst_1 newvar4) (- q 1) 0) symconst_2) (pextract newvar4 (- q 1) 0)))
(check-sat)
