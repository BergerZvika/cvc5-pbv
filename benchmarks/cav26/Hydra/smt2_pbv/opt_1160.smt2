(set-logic PBV)
(declare-const t Int)
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) t))
(declare-fun symconst_3 () PBitVec)
(assert (= (pbvsize symconst_3) t))
(declare-fun v1 () PBitVec)
(assert (= (pbvsize v1) t))
(assert (distinct (pbvor (pbvand v1 symconst_3) (ite (distinct (int_to_pbv t 0) (pbvand v1 symconst_2)) symconst_2 (int_to_pbv t 0))) (pbvand v1 (pbvor symconst_3 symconst_2))))
(check-sat)
