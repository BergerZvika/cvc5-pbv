(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) r))
(declare-fun v2 () PBitVec)
(assert (= (pbvsize v2) r))
(assert (< r s))
(assert (< r s))
(assert (> s r))
(assert (distinct (pextract (pbvand (pzero_extend (- s r) v0) (pzero_extend (- s r) v2)) (- r 1) 0) (pbvand v0 v2)))
(check-sat)
