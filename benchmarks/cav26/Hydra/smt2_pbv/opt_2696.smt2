(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-fun newvar1 () Bool)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) r))
(assert (< r u))
(assert (< r u))
(assert (< r u))
(assert (distinct (psign_extend (- u r) (ite newvar1 symconst_1 symconst_2)) (ite newvar1 (psign_extend (- u r) symconst_1) (psign_extend (- u r) symconst_2))))
(check-sat)
