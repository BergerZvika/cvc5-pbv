(set-logic PBV)
(declare-const r Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) r))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) r))
(assert (distinct (pbvsub (pbvadd v0 symconst_1) symconst_2) (pbvadd v0 (pbvsub symconst_1 symconst_2))))
(check-sat)
