(set-logic PBV)
(declare-const r Int)
(declare-const t Int)
(declare-const u Int)
(declare-fun newvar6 () PBitVec)
(assert (= (pbvsize newvar6) r))
(assert (< u r))
(assert (> t u))
(assert (> u 0))
(assert (distinct (pzero_extend (- r u) (pextract (ite (distinct (int_to_pbv r 0) (pbvand (int_to_pbv r 1) newvar6)) (int_to_pbv t 1) (int_to_pbv t 0)) (- u 1) 0)) (pbvand (int_to_pbv r 1) newvar6)))
(check-sat)
