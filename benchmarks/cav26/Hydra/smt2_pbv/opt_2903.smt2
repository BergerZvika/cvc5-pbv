(set-logic PBV)
(declare-const s Int)
(declare-const t Int)
(declare-const w Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) t))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) w))
(assert (< s t))
(assert (< w t))
(assert (> t w))
(assert (> t w))
(assert (and (pbvult (int_to_pbv t 0) symconst_1) (pbvult symconst_1 (pzero_extend (- t w) (int_to_pbv w w)))))
(assert (distinct (pextract (pbvashr (pzero_extend (- t w) v0) symconst_1) (- w 1) 0) (pbvlshr v0 (pextract symconst_1 (- w 1) 0))))
(check-sat)
