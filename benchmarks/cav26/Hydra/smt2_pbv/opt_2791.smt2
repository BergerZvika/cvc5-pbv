(set-logic PBV)
(declare-const s Int)
(declare-const x Int)
(declare-fun newvar0 () Bool)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) s))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) s))
(declare-fun symconst_3 () PBitVec)
(assert (= (pbvsize symconst_3) s))
(assert (> s x))
(assert (> s x))
(assert (> s x))
(assert (distinct (pextract (pbvor symconst_3 (ite newvar0 symconst_1 symconst_2)) (- x 1) 0) (ite newvar0 (pextract (pbvor symconst_3 (ite true symconst_1 symconst_2)) (- x 1) 0) (pextract (pbvor symconst_3 (ite false symconst_1 symconst_2)) (- x 1) 0))))
(check-sat)
