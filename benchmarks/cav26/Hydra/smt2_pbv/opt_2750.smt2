(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-fun newvar1 () PBitVec)
(assert (= (pbvsize newvar1) r))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) r))
(assert (< r s))
(assert (< r s))
(assert (> s r))
(assert (distinct (pextract (pbvor (pzero_extend (- s r) v0) (pzero_extend (- s r) newvar1)) (- r 1) 0) (pbvor v0 newvar1)))
(check-sat)
