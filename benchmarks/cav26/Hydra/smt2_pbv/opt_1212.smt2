(set-logic PBV)
(declare-const q Int)
(declare-fun newvar0 () PBitVec)
(assert (= (pbvsize newvar0) q))
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) q))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) q))
(assert (distinct symconst_1 symconst_2))
(assert (distinct (not (distinct symconst_1 (ite (distinct symconst_1 newvar0) symconst_2 symconst_1))) (= symconst_1 newvar0)))
(check-sat)
