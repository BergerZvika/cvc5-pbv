(set-logic PBV)
(declare-const v Int)
(declare-fun newvar0 () PBitVec)
(assert (= (pbvsize newvar0) v))
(declare-fun symconst_3 () PBitVec)
(assert (= (pbvsize symconst_3) v))
(assert (< 1 v))
(assert (distinct (pbvmul symconst_3 (pzero_extend (- v 1) (ite (not (not (distinct (int_to_pbv v 0) (pbvand (int_to_pbv v 1) newvar0)))) (int_to_pbv 1 1) (int_to_pbv 1 0)))) (pbvmul symconst_3 (pbvand (int_to_pbv v 1) newvar0))))
(check-sat)
