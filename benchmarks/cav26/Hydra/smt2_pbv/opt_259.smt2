(set-logic PBV)
(declare-const q Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) q))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) q))
(declare-fun v1 () PBitVec)
(assert (= (pbvsize v1) q))
(assert (= (int_to_pbv q 1) (pbvsub symconst_2 symconst_1)))
(assert (distinct (pbvsub (pbvadd symconst_1 v1) symconst_2) (pbvadd (pbvnot (int_to_pbv q 0)) v1)))
(check-sat)
