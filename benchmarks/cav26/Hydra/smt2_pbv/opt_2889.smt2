(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) u))
(assert (< u r))
(assert (> r u))
(assert (> r u))
(assert (distinct (pextract (pbvshl (pzero_extend (- r u) v0) symconst_1) (- u 1) 0) (pbvmul v0 (pextract (pbvshl (int_to_pbv r 1) symconst_1) (- u 1) 0))))
(check-sat)
