(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-const t Int)
(declare-fun newvar3 () PBitVec)
(assert (= (pbvsize newvar3) q))
(assert (< q r))
(assert (< q t))
(assert (< 1 t))
(assert (= q 1))
(assert (distinct (pzero_extend (- t 1) (ite (distinct (int_to_pbv r 0) (pzero_extend (- r q) newvar3)) (int_to_pbv 1 1) (int_to_pbv 1 0))) (pzero_extend (- t q) newvar3)))
(check-sat)
