(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) r))
(declare-fun v2 () PBitVec)
(assert (= (pbvsize v2) r))
(assert (< r s))
(assert (< r s))
(assert (distinct (= (psign_extend (- s r) v0) (psign_extend (- s r) v2)) (= v0 v2)))
(check-sat)
