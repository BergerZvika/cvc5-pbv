(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) q))
(assert (< q r))
(assert (> r q))
(assert (> r q))
(assert (distinct (pextract (pbvsub symconst_1 (pzero_extend (- r q) v0)) (- q 1) 0) (pbvsub (pextract symconst_1 (- q 1) 0) v0)))
(check-sat)
