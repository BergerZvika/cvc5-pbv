(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const s Int)
(declare-fun newvar1 () PBitVec)
(assert (= (pbvsize newvar1) p))
(assert (< p q))
(assert (< p s))
(assert (> q s))
(assert (distinct (pextract (pzero_extend (- q p) newvar1) (- s 1) 0) (pzero_extend (- s p) newvar1)))
(check-sat)
