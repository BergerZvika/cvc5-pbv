(set-logic PBV)
(declare-const s Int)
(declare-const t Int)
(declare-fun newvar0 () Bool)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) s))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) s))
(declare-fun symconst_3 () PBitVec)
(assert (= (pbvsize symconst_3) t))
(assert (> s t))
(assert (> s t))
(assert (> s t))
(assert (distinct (pbvand symconst_3 (pextract (ite newvar0 symconst_1 symconst_2) (- t 1) 0)) (ite newvar0 (pbvand symconst_3 (pextract (ite true symconst_1 symconst_2) (- t 1) 0)) (pbvand symconst_3 (pextract (ite false symconst_1 symconst_2) (- t 1) 0)))))
(check-sat)
