(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-fun newvar2 () Bool)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) r))
(assert (> r u))
(assert (> r u))
(assert (> r u))
(assert (distinct (pextract (ite newvar2 symconst_1 symconst_2) (- u 1) 0) (ite newvar2 (pextract symconst_1 (- u 1) 0) (pextract symconst_2 (- u 1) 0))))
(check-sat)
