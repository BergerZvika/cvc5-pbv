(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-const v Int)
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) r))
(assert (< r s))
(assert (< r v))
(assert (< 1 v))
(assert (< 1 v))
(assert (= r 1))
(assert (distinct (pzero_extend (- v 1) (ite (not (distinct (int_to_pbv s 0) (pzero_extend (- s r) v0))) (int_to_pbv 1 1) (int_to_pbv 1 0))) (pbvsub (pzero_extend (- v 1) (ite true (int_to_pbv 1 1) (int_to_pbv 1 0))) (pzero_extend (- v r) v0))))
(check-sat)
