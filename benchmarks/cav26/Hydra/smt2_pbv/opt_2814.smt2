(set-logic PBV)
(declare-const r Int)
(declare-const v Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) r))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) v))
(assert (< v r))
(assert (< 1 r))
(assert (> r v))
(assert (> r v))
(assert (= symconst_1 (pbvxor symconst_2 (psign_extend (- r 1) (ite true (int_to_pbv 1 1) (int_to_pbv 1 0))))))
(assert (distinct (pextract (pbvor symconst_2 (pbvand symconst_1 (pzero_extend (- r v) v0))) (- v 1) 0) (pbvor v0 (pextract symconst_2 (- v 1) 0))))
(check-sat)
