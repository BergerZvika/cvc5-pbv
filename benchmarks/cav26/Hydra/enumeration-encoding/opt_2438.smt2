(set-logic PBV)
(declare-const r Int)
(declare-const t Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) t))
(assert (< r t))
(assert (< r t))
(assert (> t r))
(assert (distinct (pzero_extend (- t r) (pbvand symconst_1 (pextract v0 (- r 1) 0))) (pbvand v0 (pzero_extend (- t r) symconst_1))))
(check-sat)
