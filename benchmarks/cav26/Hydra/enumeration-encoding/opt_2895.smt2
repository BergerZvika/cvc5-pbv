(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const s Int)
(declare-fun newvar0 () PBitVec)
(assert (= (pbvsize newvar0) p))
(assert (> p q))
(assert (> p s))
(assert (> q s))
(assert (distinct (pextract (pextract newvar0 (- q 1) 0) (- s 1) 0) (pextract newvar0 (- s 1) 0)))
(check-sat)
