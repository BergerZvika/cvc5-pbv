(set-logic PBV)
(declare-const q Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) q))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) q))
(declare-fun v1 () PBitVec)
(assert (= (pbvsize v1) q))
(assert (= symconst_2 (pbvmul (int_to_pbv q 2) symconst_1)))
(assert (distinct (= symconst_2 (pbvadd symconst_1 v1)) (= symconst_1 v1)))
(check-sat)
