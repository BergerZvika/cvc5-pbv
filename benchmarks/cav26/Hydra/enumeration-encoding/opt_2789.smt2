(set-logic PBV)
(declare-const r Int)
(declare-const t Int)
(declare-fun newvar2 () PBitVec)
(assert (= (pbvsize newvar2) t))
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(assert (< t r))
(assert (> r t))
(assert (> r t))
(assert (distinct (pextract (pbvor symconst_1 (pzero_extend (- r t) newvar2)) (- t 1) 0) (pbvor newvar2 (pextract symconst_1 (- t 1) 0))))
(check-sat)
