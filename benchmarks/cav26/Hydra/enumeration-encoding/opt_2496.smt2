(set-logic PBV)
(declare-const r Int)
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) r))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) r))
(assert (< 1 r))
(assert (pbvult symconst_2 (int_to_pbv r r)))
(assert (distinct (pzero_extend (- r 1) (ite (= (int_to_pbv r 0) (pbvand symconst_2 v0)) (int_to_pbv 1 1) (int_to_pbv 1 0))) (pbvashr (pbvadd symconst_2 (pbvsub (int_to_pbv r 1) symconst_2)) (pbvand symconst_2 v0))))
(check-sat)
