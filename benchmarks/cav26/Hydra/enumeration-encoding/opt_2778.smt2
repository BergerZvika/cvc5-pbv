(set-logic PBV)
(declare-const r Int)
(declare-const t Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) t))
(assert (< t r))
(assert (> r t))
(assert (> r t))
(assert (distinct (pextract (pbvor symconst_1 (psign_extend (- r t) v0)) (- t 1) 0) (pbvor v0 (pextract symconst_1 (- t 1) 0))))
(check-sat)
