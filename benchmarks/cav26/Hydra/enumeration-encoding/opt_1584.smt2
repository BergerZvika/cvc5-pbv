(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-const u Int)
(declare-fun newvar0 () PBitVec)
(assert (= (pbvsize newvar0) r))
(assert (< r s))
(assert (< r u))
(assert (distinct (ite (distinct (int_to_pbv s 0) (pzero_extend (- s r) (pbvand (int_to_pbv r 1) newvar0))) (int_to_pbv u 1) (int_to_pbv u 0)) (pzero_extend (- u r) (pbvand (int_to_pbv r 1) newvar0))))
(check-sat)
