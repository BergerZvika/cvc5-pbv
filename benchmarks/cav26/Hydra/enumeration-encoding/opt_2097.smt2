(assert (distinct (ite (distinct (int_to_pbv t 0) (pbvand (int_to_pbv t 1) newvar0)) symconst_3 (int_to_pbv t 0)) (pbvmul symconst_3 (pbvand (int_to_pbv t 1) newvar0))))
