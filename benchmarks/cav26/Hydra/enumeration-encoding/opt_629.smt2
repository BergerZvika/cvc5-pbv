(set-logic PBV)
(declare-const q Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) q))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) q))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) q))
(assert (= symconst_2 (pbvxor (pbvnot (int_to_pbv q 0)) symconst_1)))
(assert (distinct (pbvand symconst_2 (pbvand symconst_1 v0)) (int_to_pbv q 0)))
(check-sat)
