(set-logic PBV)
(declare-const q Int)
(declare-const u Int)
(declare-fun newvar1 () PBitVec)
(assert (= (pbvsize newvar1) q))
(declare-fun newvar2 () PBitVec)
(assert (= (pbvsize newvar2) q))
(assert (< q u))
(assert (< q u))
(assert (distinct (distinct (int_to_pbv u 0) (pbvor (pzero_extend (- u q) newvar2) (pzero_extend (- u q) (pbvnot newvar1)))) (pbvule newvar1 newvar2)))
(check-sat)
