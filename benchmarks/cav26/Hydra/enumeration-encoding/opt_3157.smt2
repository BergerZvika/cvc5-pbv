(set-logic PBV)
(declare-const s Int)
(declare-const t Int)
(declare-const w Int)
(declare-fun newvar0 () PBitVec)
(assert (= (pbvsize newvar0) w))
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) t))
(assert (< s t))
(assert (< w t))
(assert (> t w))
(assert (pbvule symconst_1 (pbvsub (pbvshl (int_to_pbv t 1) (pzero_extend (- t w) (int_to_pbv w w))) (int_to_pbv t 1))))
(assert (distinct (= symconst_1 (pzero_extend (- t w) newvar0)) (= newvar0 (pextract symconst_1 (- w 1) 0))))
(check-sat)
