(set-logic PBV)
(declare-const p Int)
(declare-fun newvar1 () Bool)
(declare-fun newvar4 () Bool)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) p))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) p))
(assert (pbvult symconst_2 symconst_1))
(assert (distinct (distinct (ite newvar1 symconst_1 symconst_2) (ite newvar4 symconst_1 symconst_2)) (xor newvar1 newvar4)))
(check-sat)
