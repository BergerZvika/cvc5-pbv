(set-logic PBV)
(declare-const q Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) q))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) q))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) q))
(assert (distinct (pbvor symconst_1 (pbvor symconst_2 v0)) (pbvor v0 (pbvor symconst_1 symconst_2))))
(check-sat)
