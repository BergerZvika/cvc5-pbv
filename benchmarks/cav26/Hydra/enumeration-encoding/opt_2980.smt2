(set-logic PBV)
(declare-const r Int)
(declare-fun newvar0 () PBitVec)
(assert (= (pbvsize newvar0) r))
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) r))
(assert (distinct (= symconst_1 (pbvsub newvar0 symconst_2)) (= newvar0 (pbvadd symconst_1 symconst_2))))
(check-sat)
