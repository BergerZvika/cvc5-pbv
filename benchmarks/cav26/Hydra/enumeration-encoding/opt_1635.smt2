(set-logic PBV)
(declare-const u Int)
(declare-fun symconst_6 () PBitVec)
(assert (= (pbvsize symconst_6) u))
(declare-fun symconst_7 () PBitVec)
(assert (= (pbvsize symconst_7) u))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) u))
(assert (= (int_to_pbv u 1) (pbvsub symconst_6 symconst_7)))
(assert (distinct (ite (distinct (int_to_pbv u 0) (pbvand (int_to_pbv u 1) v0)) symconst_6 symconst_7) (pbvadd symconst_7 (pbvand (int_to_pbv u 1) v0))))
(check-sat)
