(set-logic PBV)
(declare-const q Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) q))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) q))
(declare-fun v2 () PBitVec)
(assert (= (pbvsize v2) q))
(assert (distinct (= (pbvadd v0 symconst_1) (pbvadd symconst_1 v2)) (= v0 v2)))
(check-sat)
