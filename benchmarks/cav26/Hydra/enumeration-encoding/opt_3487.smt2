(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-fun newvar0 () PBitVec)
(assert (= (pbvsize newvar0) r))
(assert (< r s))
(assert (> r 1))
(assert (distinct (ite (distinct (int_to_pbv s 0) (pzero_extend (- s r) (pbvand (int_to_pbv r 1) newvar0))) (int_to_pbv 1 1) (int_to_pbv 1 0)) (pextract newvar0 (- 1 1) 0)))
(check-sat)
