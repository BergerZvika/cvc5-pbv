(set-logic PBV)
(declare-const q Int)
(declare-const s Int)
(declare-const t Int)
(declare-const w Int)
(declare-const x Int)
(declare-fun newvar2 () PBitVec)
(assert (= (pbvsize newvar2) q))
(declare-fun newvar7 () PBitVec)
(assert (= (pbvsize newvar7) s))
(assert (< q t))
(assert (< q w))
(assert (< s t))
(assert (< s w))
(assert (< 1 x))
(assert (> w x))
(assert (distinct (pzero_extend (- x 1) (ite (distinct (int_to_pbv t 0) (pbvor (pzero_extend (- t q) newvar2) (pzero_extend (- t s) newvar7))) (int_to_pbv 1 1) (int_to_pbv 1 0))) (pextract (pbvor (pzero_extend (- w q) newvar2) (pzero_extend (- w s) newvar7)) (- x 1) 0)))
(check-sat)
