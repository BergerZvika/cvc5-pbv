(set-logic PBV)
(declare-const q Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) q))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) q))
(declare-fun symconst_3 () PBitVec)
(assert (= (pbvsize symconst_3) q))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) q))
(assert (distinct (pbvshl (pbvand symconst_1 (pbvand symconst_3 (pbvlshr v0 symconst_2))) symconst_2) (pbvand v0 (pbvshl (pbvand symconst_1 symconst_3) symconst_2))))
(check-sat)
