(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) r))
(assert (< r s))
(assert (< 1 r))
(assert (distinct (pzero_extend (- r 1) (ite (distinct (int_to_pbv s 0) (pzero_extend (- s r) (pbvand (int_to_pbv r 1) v0))) (int_to_pbv 1 1) (int_to_pbv 1 0))) (pbvand (int_to_pbv r 1) v0)))
(check-sat)
