(set-logic PBV)
(declare-const r Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) r))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) r))
(assert (distinct (pbvor (pbvand symconst_2 v0) (pbvand v0 symconst_1)) (pbvand v0 (pbvor symconst_2 symconst_1))))
(check-sat)
