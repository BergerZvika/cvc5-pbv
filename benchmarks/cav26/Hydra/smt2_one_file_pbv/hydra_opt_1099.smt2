(set-logic PBV)
(declare-const s Int)
(declare-fun newvar5 () Bool)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) s))
(declare-fun symconst_3 () PBitVec)
(assert (= (pbvsize symconst_3) s))
(assert (distinct (pbvor symconst_3 (ite newvar5 symconst_1 (int_to_pbv s 0))) (ite newvar5 (pbvor symconst_3 symconst_1) symconst_3)))
(check-sat)
