(set-logic PBV)
(declare-const r Int)
(declare-const v Int)
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) r))
(declare-fun newvar1 () PBitVec)
(assert (= (pbvsize newvar1) 1))
(declare-fun symconst_3 () PBitVec)
(assert (= (pbvsize symconst_3) r))
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) r))
(assert (> r v))
(assert (distinct (ite (> v r) (pzero_extend (- v r) (pbvxor symconst_3 (ite (= (pextract newvar1 0 0) (int_to_pbv 1 1)) symconst_1 symconst_2))) (ite (= v r) (pbvxor symconst_3 (ite (= (pextract newvar1 0 0) (int_to_pbv 1 1)) symconst_1 symconst_2)) (pextract (pbvxor symconst_3 (ite (= (pextract newvar1 0 0) (int_to_pbv 1 1)) symconst_1 symconst_2)) (- v 1) 0))) (ite (> v r) (ite (= (pextract newvar1 0 0) (int_to_pbv 1 1)) (pzero_extend (- v r) (pbvxor symconst_3 symconst_1)) (pzero_extend (- v r) (pbvxor symconst_3 symconst_2))) (ite (= v r) (ite (= (pextract newvar1 0 0) (int_to_pbv 1 1)) (pbvxor symconst_3 symconst_1) (pbvxor symconst_3 symconst_2)) (ite (= (pextract newvar1 0 0) (int_to_pbv 1 1)) (pextract (pbvxor symconst_3 symconst_1) (- v 1) 0) (pextract (pbvxor symconst_3 symconst_2) (- v 1) 0))))))
(check-sat)
