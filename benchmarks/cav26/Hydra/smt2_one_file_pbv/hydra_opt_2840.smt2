(assert (= (pbvsize symconst_1) r))
(declare-fun newvar1 () PBitVec)
(assert (= (pbvsize newvar1) t))
(assert (< t r))
(assert (> r t))
(assert (distinct (ite (and (> t r) (> r t)) (pzero_extend (- t r) (pbvadd symconst_1 (pzero_extend (- r t) newvar1))) (ite (and (= t r) (> r t)) (pbvadd symconst_1 (pzero_extend (- r t) newvar1)) (ite (and (< t r) (> r t)) (pextract (pbvadd symconst_1 (pzero_extend (- r t) newvar1)) (- t 1) 0) (ite (and (> t r) (= r t)) (pzero_extend (- t r) (pbvadd symconst_1 newvar1)) (ite (and (= t r) (= r t)) (pbvadd symconst_1 newvar1) (ite (and (< t r) (= r t)) (pextract (pbvadd symconst_1 newvar1) (- t 1) 0) (ite (and (> t r) (< r t)) (pzero_extend (- t r) (pbvadd symconst_1 (pextract newvar1 (- r 1) 0))) (ite (and (= t r) (< r t)) (pbvadd symconst_1 (pextract newvar1 (- r 1) 0)) (pextract (pbvadd symconst_1 (pextract newvar1 (- r 1) 0)) (- t 1) 0))))))))) (ite (> t r) (pbvadd newvar1 (pzero_extend (- t r) symconst_1)) (ite (= t r) (pbvadd newvar1 symconst_1) (pbvadd newvar1 (pextract symconst_1 (- t 1) 0))))))
(check-sat)
