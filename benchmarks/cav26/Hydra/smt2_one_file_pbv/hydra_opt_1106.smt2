(set-logic PBV)
(declare-const s Int)
(declare-fun symconst_1 () PBitVec)
(assert (= (pbvsize symconst_1) s))
(declare-fun symconst_2 () PBitVec)
(assert (= (pbvsize symconst_2) s))
(declare-fun symconst_3 () PBitVec)
(assert (= (pbvsize symconst_3) s))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) s))
(assert (distinct (pbvor (pbvand v0 symconst_2) (pbvand symconst_1 (pbvand v0 symconst_3))) (pbvand v0 (pbvor symconst_2 (pbvand symconst_1 symconst_3)))))
(check-sat)
