(assert (= (pbvsize v2) r))
(declare-fun v0 () PBitVec)
(assert (= (pbvsize v0) r))
(assert (< r s))
(assert (> s r))
(assert (distinct (ite (and (> r s) (> s r) (= r r)) (pzero_extend (- r s) (pbvxor (psign_extend (- s r) v0) (psign_extend (- s r) v2))) (ite (and (= r s) (> s r) (= r r)) (pbvxor (psign_extend (- s r) v0) (psign_extend (- s r) v2)) (ite (and (< r s) (> s r) (= r r)) (pextract (pbvxor (psign_extend (- s r) v0) (psign_extend (- s r) v2)) (- r 1) 0) (ite (and (> r s) (= s r) (= r r)) (pzero_extend (- r s) (pbvxor v0 v2)) (ite (and (= r s) (= s r) (= r r)) (pbvxor v0 v2) (ite (and (< r s) (= s r) (= r r)) (pextract (pbvxor v0 v2) (- r 1) 0) (ite (and (> r s) (< s r) (= r r)) (pzero_extend (- r s) (pbvxor (pextract v0 (- s 1) 0) (pextract v2 (- s 1) 0))) (ite (and (= r s) (< s r) (= r r)) (pbvxor (pextract v0 (- s 1) 0) (pextract v2 (- s 1) 0)) (pextract (pbvxor (pextract v0 (- s 1) 0) (pextract v2 (- s 1) 0)) (- r 1) 0))))))))) (pbvxor v0 v2)))
(check-sat)
