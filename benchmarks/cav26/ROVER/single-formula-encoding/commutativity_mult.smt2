(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (distinct (ite (and (> r p) (> r q)) (pbvmul (pzero_extend (- r p) a) (pzero_extend (- r q) b)) (ite (and (= r p) (> p q)) (pbvmul a (pzero_extend (- p q) b)) (ite (and (= r p) (= p q)) (pbvmul a b) (ite (and (= r q) (< p q)) (pbvmul (pzero_extend (- q p) a) b) (ite (and (< r q) (> q p)) (pextract (pbvmul (pzero_extend (- q p) a) b) (- r 1) 0) (ite (and (< r p) (= p q)) (pextract (pbvmul a b) (- r 1) 0) (pextract (pbvmul a (pzero_extend (- p q) b)) (- r 1) 0))))))) (ite (and (> r q) (> r p)) (pbvmul (pzero_extend (- r q) b) (pzero_extend (- r p) a)) (ite (and (= r q) (> q p)) (pbvmul b (pzero_extend (- q p) a)) (ite (and (= r q) (= q p)) (pbvmul b a) (ite (and (= r p) (< q p)) (pbvmul (pzero_extend (- p q) b) a) (ite (and (< r p) (> p q)) (pextract (pbvmul (pzero_extend (- p q) b) a) (- r 1) 0) (ite (and (< r q) (= q p)) (pextract (pbvmul b a) (- r 1) 0) (pextract (pbvmul b (pzero_extend (- q p) a)) (- r 1) 0)))))))))
(check-sat)
