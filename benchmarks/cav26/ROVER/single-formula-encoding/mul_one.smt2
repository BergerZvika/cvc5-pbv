(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (distinct (ite (and (= p p) (> p q)) (pbvmul a (pzero_extend (- p q) (int_to_pbv q 1))) (ite (and (= p p) (= p q)) (pbvmul a (int_to_pbv q 1)) (pextract (pbvmul (pzero_extend (- q p) a) (int_to_pbv q 1)) (- p 1) 0))) a))
(check-sat)
