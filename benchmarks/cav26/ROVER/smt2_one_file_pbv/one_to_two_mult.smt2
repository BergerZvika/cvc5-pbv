(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-fun x () PBitVec)
(assert (= (pbvsize x) p))
(assert (> q (+ p 2)))
(assert (> q p))
(assert (distinct (ite (and (= p 1) (= 1 p)) (pbvmul (int_to_pbv 1 1) x) (pbvmul (pzero_extend (- p 1) (int_to_pbv 1 1)) x)) (ite (and (< p q) (> q p) (> q 2)) (pextract (pbvsub (pbvmul (pzero_extend (- q 2) (int_to_pbv 2 2)) (pzero_extend (- q p) x)) (pzero_extend (- q p) x)) (- p 1) 0) (ite (and (< p q) (> q p) (= q 2) (> 2 p)) (pextract (pbvsub (pbvmul (int_to_pbv 2 2) (pzero_extend (- 2 p) x)) (pzero_extend (- q p) x)) (- p 1) 0) (ite (and (= p q) (= q p) (= q 2) (= 2 p)) (pbvsub (pbvmul (int_to_pbv 2 2) x) x) (ite (and (= p q) (= q p) (< 2 p)) (pbvsub (pbvmul (pzero_extend (- p 2) (int_to_pbv 2 2)) x) x) (ite (and (= p p) (< q p) (> p 2)) (pbvsub (pzero_extend (- p q) (pextract (pbvmul (pzero_extend (- p 2) (int_to_pbv 2 2)) x) (- q 1) 0)) x) (ite (and (= p p) (< q p) (< q 2) (= 2 p)) (pbvsub (pzero_extend (- p q) (pextract (pbvmul (int_to_pbv 2 2) x) (- q 1) 0)) x) (pbvsub (pextract (pbvmul (int_to_pbv 2 2) (pzero_extend (- 2 p) x)) (- q 1) 0) x)))))))))
(check-sat)
