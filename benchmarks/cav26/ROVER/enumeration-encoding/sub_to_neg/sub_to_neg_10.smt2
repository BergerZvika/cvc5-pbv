(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (< r p))
(assert (< r q))
(assert (> p q))
(assert (> p r))
(assert (distinct (pextract (pbvsub a (pzero_extend (- p q) b)) (- r 1) 0) (pextract (pbvadd a (pzero_extend (- p r) (pextract (pbvneg b) (- r 1) 0))) (- r 1) 0)))
(check-sat)
