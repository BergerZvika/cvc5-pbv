(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) q))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) 1))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= p 1))
(assert (>= q 1))
(assert (< r p))
(assert (> p q))
(assert (distinct (pextract (pbvmul (ite (= (pextract b 0 0) (int_to_pbv 1 1)) (int_to_pbv p 0) a) (pzero_extend (- p q) c)) (- r 1) 0) (pextract (pbvmul a (pzero_extend (- p q) (ite (= (pextract b 0 0) (int_to_pbv 1 1)) (int_to_pbv q 0) c))) (- r 1) 0)))
(check-sat)
