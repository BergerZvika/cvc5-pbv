(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const r Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) q))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) 1))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= p 1))
(assert (>= q 1))
(assert (> q p))
(assert (< r q))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) (ite (= (pextract b 0 0) (int_to_pbv 1 1)) (int_to_pbv p 0) a)) c) (- r 1) 0) (pextract (pbvmul (pzero_extend (- q p) a) (ite (= (pextract b 0 0) (int_to_pbv 1 1)) (int_to_pbv q 0) c)) (- r 1) 0)))
(check-sat)
