(set-logic PBV)
(declare-const t Int)
(declare-const s Int)
(declare-const p Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (> t s))
(assert (> t q))
(assert (= p q))
(assert (> t p))
(assert (> t q))
(assert (> t s))
(assert (< r t))
(assert (distinct (pbvlshr (pbvlshr a b) c) (pextract (pbvlshr (pzero_extend (- t p) a) (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c))) (- r 1) 0)))
(check-sat)
