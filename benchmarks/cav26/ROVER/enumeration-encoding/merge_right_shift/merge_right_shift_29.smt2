(set-logic PBV)
(declare-const r Int)
(declare-const q Int)
(declare-const s Int)
(declare-const u Int)
(declare-const t Int)
(declare-const p Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u p))
(assert (> t s))
(assert (> t q))
(assert (< r p))
(assert (> t q))
(assert (> t s))
(assert (< r u))
(assert (= u p))
(assert (> p q))
(assert (> p t))
(assert (> u s))
(assert (distinct (pextract (pbvlshr (pbvlshr a (pzero_extend (- p q) b)) (pzero_extend (- u s) c)) (- r 1) 0) (pextract (pbvlshr a (pzero_extend (- p t) (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c)))) (- r 1) 0)))
(check-sat)
