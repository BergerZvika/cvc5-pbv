(set-logic PBV)
(declare-const u Int)
(declare-const p Int)
(declare-const r Int)
(declare-const s Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (< p q))
(assert (< p r))
(assert (= u r))
(assert (> u s))
(assert (= q r))
(assert (> r s))
(assert (distinct (pbvmul (pbvmul (pzero_extend (- r p) a) b) (pzero_extend (- u s) c)) (pbvmul (pzero_extend (- q p) a) (pbvmul b (pzero_extend (- r s) c)))))
(check-sat)
