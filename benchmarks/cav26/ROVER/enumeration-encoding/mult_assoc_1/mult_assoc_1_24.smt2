(set-logic PBV)
(declare-const t Int)
(declare-const p Int)
(declare-const u Int)
(declare-const r Int)
(declare-const s Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (>= q t))
(assert (>= u t))
(assert (> u r))
(assert (> u p))
(assert (< t u))
(assert (= q r))
(assert (= t q))
(assert (> r s))
(assert (> u s))
(assert (< p q))
(assert (distinct (pextract (pbvmul (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u r) b)) (pzero_extend (- u s) c)) (- t 1) 0) (pbvmul (pzero_extend (- q p) a) (pbvmul b (pzero_extend (- r s) c)))))
(check-sat)
