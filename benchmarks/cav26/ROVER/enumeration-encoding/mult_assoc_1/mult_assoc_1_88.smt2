(set-logic PBV)
(declare-const p Int)
(declare-const t Int)
(declare-const u Int)
(declare-const r Int)
(declare-const s Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q t))
(assert (>= u t))
(assert (> q r))
(assert (< t q))
(assert (> u s))
(assert (= p r))
(assert (< t u))
(assert (= u p))
(assert (> q p))
(assert (> q s))
(assert (distinct (pextract (pbvmul (pbvmul a b) (pzero_extend (- u s) c)) (- t 1) 0) (pextract (pbvmul (pzero_extend (- q p) a) (pbvmul (pzero_extend (- q r) b) (pzero_extend (- q s) c))) (- t 1) 0)))
(check-sat)
