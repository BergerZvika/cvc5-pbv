(set-logic PBV)
(declare-const q Int)
(declare-const u Int)
(declare-const s Int)
(declare-const p Int)
(declare-const t Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> t s))
(assert (> t q))
(assert (> t s))
(assert (> p q))
(assert (> t q))
(assert (> p t))
(assert (> u s))
(assert (= u p))
(assert (distinct (pbvshl (pbvshl a (pzero_extend (- p q) b)) (pzero_extend (- u s) c)) (pbvshl a (pzero_extend (- p t) (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c))))))
(check-sat)
