(set-logic PBV)
(declare-const s Int)
(declare-const p Int)
(declare-const u Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (= q r))
(assert (= r s))
(assert (> u s))
(assert (> p q))
(assert (= u p))
(assert (> p r))
(assert (distinct (pbvmul (pbvmul a (pzero_extend (- p r) b)) (pzero_extend (- u s) c)) (pbvmul a (pzero_extend (- p q) (pbvmul b c)))))
(check-sat)
