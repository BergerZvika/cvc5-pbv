(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (= r s))
(assert (= p r))
(assert (distinct (pbvmul (pbvmul a b) c) (pbvmul a (pbvmul b c))))
(check-sat)
