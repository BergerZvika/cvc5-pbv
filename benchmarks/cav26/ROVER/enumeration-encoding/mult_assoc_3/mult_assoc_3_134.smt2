(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const r Int)
(declare-const s Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (> t p))
(assert (> t q))
(assert (= r s))
(assert (< p r))
(assert (< q r))
(assert (distinct (pbvmul (pbvmul (pzero_extend (- r p) a) b) c) (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) (pextract (pbvmul b c) (- q 1) 0)))))
(check-sat)
