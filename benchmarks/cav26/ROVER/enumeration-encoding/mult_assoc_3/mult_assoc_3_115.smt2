(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (> p q))
(assert (= r s))
(assert (< q r))
(assert (= p r))
(assert (distinct (pbvmul (pbvmul a b) c) (pbvmul a (pzero_extend (- p q) (pextract (pbvmul b c) (- q 1) 0)))))
(check-sat)
