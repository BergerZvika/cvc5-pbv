(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const s Int)
(declare-const r Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (<= (+ r s) q))
(assert (= r s))
(assert (< p r))
(assert (= t q))
(assert (< p q))
(assert (< q r))
(assert (distinct (pextract (pbvmul (pbvmul (pzero_extend (- r p) a) b) c) (- t 1) 0) (pbvmul (pzero_extend (- q p) a) (pextract (pbvmul b c) (- q 1) 0))))
(check-sat)
