(set-logic PBV)
(declare-const t Int)
(declare-const p Int)
(declare-const r Int)
(declare-const u Int)
(declare-const s Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (>= q t))
(assert (<= (+ p r) u))
(assert (= t u))
(assert (> q p))
(assert (> r s))
(assert (< q r))
(assert (= u s))
(assert (< t q))
(assert (> r p))
(assert (< u r))
(assert (distinct (pbvmul (pextract (pbvmul (pzero_extend (- r p) a) b) (- u 1) 0) c) (pextract (pbvmul (pzero_extend (- q p) a) (pextract (pbvmul b (pzero_extend (- r s) c)) (- q 1) 0)) (- t 1) 0)))
(check-sat)
