(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const s Int)
(declare-const u Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (<= (+ p r) u))
(assert (< r s))
(assert (= q s))
(assert (= u s))
(assert (> u p))
(assert (> u r))
(assert (< p q))
(assert (distinct (pbvmul (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u r) b)) c) (pbvmul (pzero_extend (- q p) a) (pbvmul (pzero_extend (- s r) b) c))))
(check-sat)
