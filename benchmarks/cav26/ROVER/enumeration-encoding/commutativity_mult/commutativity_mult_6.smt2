(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> p q))
(assert (< r p))
(assert (distinct (pextract (pbvmul a (pzero_extend (- p q) b)) (- r 1) 0) (pextract (pbvmul (pzero_extend (- p q) b) a) (- r 1) 0)))
(check-sat)
