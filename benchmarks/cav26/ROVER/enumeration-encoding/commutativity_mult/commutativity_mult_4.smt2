(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> q p))
(assert (< r q))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) b) (- r 1) 0) (pextract (pbvmul b (pzero_extend (- q p) a)) (- r 1) 0)))
(check-sat)
