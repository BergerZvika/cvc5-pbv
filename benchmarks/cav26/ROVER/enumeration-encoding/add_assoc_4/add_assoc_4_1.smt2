(set-logic PBV)
(declare-const s Int)
(declare-const p Int)
(declare-const r Int)
(declare-const t Int)
(declare-const u Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (< r q))
(assert (< s q))
(assert (< p u))
(assert (< r u))
(assert (> q r))
(assert (< p q))
(assert (> u r))
(assert (> q s))
(assert (> u p))
(assert (= t q))
(assert (> t s))
(assert (> t u))
(assert (distinct (pbvadd (pzero_extend (- t u) (pbvadd (pzero_extend (- u p) a) (pzero_extend (- u r) b))) (pzero_extend (- t s) c)) (pbvadd (pzero_extend (- q p) a) (pbvadd (pzero_extend (- q r) b) (pzero_extend (- q s) c)))))
(check-sat)
