(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const s Int)
(declare-const u Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> q p))
(assert (> s t))
(assert (> u p))
(assert (= u u))
(assert (> q t))
(assert (< s q))
(assert (> u t))
(assert (< u q))
(assert (distinct (pbvshl (pextract (pbvadd (pzero_extend (- q p) a) b) (- s 1) 0) (pzero_extend (- s t) c)) (pbvadd (pbvshl (pzero_extend (- u p) a) (pzero_extend (- u t) c)) (pextract (pbvshl b (pzero_extend (- q t) c)) (- u 1) 0))))
(check-sat)
