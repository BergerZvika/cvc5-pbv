(set-logic PBV)
(declare-const p Int)
(declare-const t Int)
(declare-const u Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u r))
(assert (< r u))
(assert (< u q))
(assert (< p q))
(assert (= q t))
(assert (= u u))
(assert (< u t))
(assert (> t p))
(assert (distinct (pextract (pbvshl (pbvadd (pzero_extend (- q p) a) b) c) (- r 1) 0) (pextract (pbvadd (pextract (pbvshl (pzero_extend (- t p) a) c) (- u 1) 0) (pextract (pbvshl b c) (- u 1) 0)) (- r 1) 0)))
(check-sat)
