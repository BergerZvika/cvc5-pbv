(set-logic PBV)
(declare-const u Int)
(declare-const q Int)
(declare-const p Int)
(declare-const r Int)
(declare-const t Int)
(declare-const s Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= u r))
(assert (>= s r))
(assert (< s q))
(assert (> q p))
(assert (< r u))
(assert (= u p))
(assert (= s t))
(assert (> q t))
(assert (< r s))
(assert (< u q))
(assert (= p t))
(assert (= u u))
(assert (distinct (pextract (pbvshl (pextract (pbvadd (pzero_extend (- q p) a) b) (- s 1) 0) c) (- r 1) 0) (pextract (pbvadd (pbvshl a c) (pextract (pbvshl b (pzero_extend (- q t) c)) (- u 1) 0)) (- r 1) 0)))
(check-sat)
