(set-logic PBV)
(declare-const t Int)
(declare-const u Int)
(declare-const r Int)
(declare-const q Int)
(declare-const s Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= u r))
(assert (>= s r))
(assert (< r s))
(assert (< u p))
(assert (> q t))
(assert (= u u))
(assert (> s t))
(assert (= r u))
(assert (< u q))
(assert (< p q))
(assert (= p t))
(assert (= s q))
(assert (distinct (pextract (pbvshl (pbvadd (pzero_extend (- q p) a) b) (pzero_extend (- s t) c)) (- r 1) 0) (pbvadd (pextract (pbvshl a c) (- u 1) 0) (pextract (pbvshl b (pzero_extend (- q t) c)) (- u 1) 0))))
(check-sat)
