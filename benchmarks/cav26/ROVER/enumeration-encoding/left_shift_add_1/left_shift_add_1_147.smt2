(set-logic PBV)
(declare-const u Int)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const s Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (= s t))
(assert (< u q))
(assert (> q t))
(assert (= u u))
(assert (= u t))
(assert (< p t))
(assert (< s q))
(assert (> q p))
(assert (distinct (pbvshl (pextract (pbvadd (pzero_extend (- q p) a) b) (- s 1) 0) c) (pbvadd (pbvshl (pzero_extend (- t p) a) c) (pextract (pbvshl b (pzero_extend (- q t) c)) (- u 1) 0))))
(check-sat)
