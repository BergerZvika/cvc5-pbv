(set-logic PBV)
(declare-const r Int)
(declare-const q Int)
(declare-const p Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (= p t))
(assert (= p q))
(assert (= q t))
(assert (distinct (pextract (pbvshl (pbvadd a b) c) (- r 1) 0) (pextract (pbvadd (pbvshl a c) (pbvshl b c)) (- r 1) 0)))
(check-sat)
