(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const s Int)
(declare-const r Int)
(declare-const u Int)
(declare-const t Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= u r))
(assert (>= s r))
(assert (> s t))
(assert (= s p))
(assert (= u t))
(assert (< r u))
(assert (> p t))
(assert (< u p))
(assert (< r s))
(assert (> p q))
(assert (= u u))
(assert (< q t))
(assert (distinct (pextract (pbvshl (pbvadd a (pzero_extend (- p q) b)) (pzero_extend (- s t) c)) (- r 1) 0) (pextract (pbvadd (pextract (pbvshl a (pzero_extend (- p t) c)) (- u 1) 0) (pbvshl (pzero_extend (- t q) b) c)) (- r 1) 0)))
(check-sat)
