(set-logic PBV)
(declare-const q Int)
(declare-const s Int)
(declare-const r Int)
(declare-const p Int)
(declare-const t Int)
(declare-const u Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u r))
(assert (>= s r))
(assert (= p t))
(assert (< r t))
(assert (> q p))
(assert (= u u))
(assert (< s q))
(assert (< u p))
(assert (> t s))
(assert (< u q))
(assert (= r u))
(assert (> q t))
(assert (distinct (pextract (pbvshl (pzero_extend (- t s) (pextract (pbvadd (pzero_extend (- q p) a) b) (- s 1) 0)) c) (- r 1) 0) (pbvadd (pextract (pbvshl a c) (- u 1) 0) (pextract (pbvshl b (pzero_extend (- q t) c)) (- u 1) 0))))
(check-sat)
