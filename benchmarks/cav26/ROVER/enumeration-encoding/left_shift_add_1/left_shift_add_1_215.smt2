(set-logic PBV)
(declare-const r Int)
(declare-const t Int)
(declare-const p Int)
(declare-const q Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= s r))
(assert (< s p))
(assert (< r s))
(assert (> p t))
(assert (= s t))
(assert (= p q))
(assert (> q t))
(assert (distinct (pextract (pbvshl (pextract (pbvadd a b) (- s 1) 0) c) (- r 1) 0) (pextract (pbvadd (pbvshl a (pzero_extend (- p t) c)) (pbvshl b (pzero_extend (- q t) c))) (- r 1) 0)))
(check-sat)
