(set-logic PBV)
(declare-const t Int)
(declare-const q Int)
(declare-const p Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (= p t))
(assert (= q t))
(assert (= p q))
(assert (distinct (pbvshl (pbvadd a b) c) (pbvadd (pbvshl a c) (pbvshl b c))))
(check-sat)
