(set-logic PBV)
(declare-const u Int)
(declare-const p Int)
(declare-const t Int)
(declare-const q Int)
(declare-const r Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u r))
(assert (= u u))
(assert (< u q))
(assert (= q t))
(assert (< u p))
(assert (= r u))
(assert (= p t))
(assert (= p q))
(assert (distinct (pextract (pbvshl (pbvadd a b) c) (- r 1) 0) (pbvadd (pextract (pbvshl a c) (- u 1) 0) (pextract (pbvshl b c) (- u 1) 0))))
(check-sat)
