(set-logic PBV)
(declare-const r Int)
(declare-const q Int)
(declare-const p Int)
(declare-const s Int)
(declare-const u Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u r))
(assert (> s p))
(assert (> s q))
(assert (< u p))
(assert (= u u))
(assert (< r s))
(assert (> p t))
(assert (= r u))
(assert (< u q))
(assert (= q t))
(assert (> s t))
(assert (> s q))
(assert (> s p))
(assert (distinct (pextract (pbvshl (pbvadd (pzero_extend (- s p) a) (pzero_extend (- s q) b)) (pzero_extend (- s t) c)) (- r 1) 0) (pbvadd (pextract (pbvshl a (pzero_extend (- p t) c)) (- u 1) 0) (pextract (pbvshl b c) (- u 1) 0))))
(check-sat)
