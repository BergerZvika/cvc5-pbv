(set-logic PBV)
(declare-const u Int)
(declare-const s Int)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (< p u))
(assert (< r u))
(assert (< p q))
(assert (> u p))
(assert (= u s))
(assert (= q s))
(assert (< r s))
(assert (> u r))
(assert (distinct (pbvadd (pbvadd (pzero_extend (- u p) a) (pzero_extend (- u r) b)) c) (pbvadd (pzero_extend (- q p) a) (pbvadd (pzero_extend (- s r) b) c))))
(check-sat)
