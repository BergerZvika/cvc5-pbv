(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const u Int)
(declare-const t Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (< p u))
(assert (< r u))
(assert (> u s))
(assert (< t p))
(assert (> u r))
(assert (> u p))
(assert (< t u))
(assert (< r s))
(assert (distinct (pextract (pbvadd (pbvadd (pzero_extend (- u p) a) (pzero_extend (- u r) b)) (pzero_extend (- u s) c)) (- t 1) 0) (pextract (pbvadd a (pbvadd (pzero_extend (- s r) b) c)) (- t 1) 0)))
(check-sat)
