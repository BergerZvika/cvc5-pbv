(set-logic PBV)
(declare-const u Int)
(declare-const q Int)
(declare-const p Int)
(declare-const t Int)
(declare-const s Int)
(declare-const r Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (>= q t))
(assert (< p u))
(assert (< r u))
(assert (> u r))
(assert (= r s))
(assert (> u s))
(assert (> p q))
(assert (< t u))
(assert (> u p))
(assert (= q r))
(assert (< t p))
(assert (distinct (pextract (pbvadd (pbvadd (pzero_extend (- u p) a) (pzero_extend (- u r) b)) (pzero_extend (- u s) c)) (- t 1) 0) (pextract (pbvadd a (pzero_extend (- p q) (pbvadd b c))) (- t 1) 0)))
(check-sat)
