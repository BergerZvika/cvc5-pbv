(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-const s Int)
(declare-const u Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (< u p))
(assert (= p r))
(assert (< q r))
(assert (= r s))
(assert (< u s))
(assert (> p q))
(assert (distinct (pbvmul (pzero_extend (- s u) (pextract (pbvmul a b) (- u 1) 0)) c) (pbvmul a (pzero_extend (- p q) (pextract (pbvmul b c) (- q 1) 0)))))
(check-sat)
