(set-logic PBV)
(declare-const t Int)
(declare-const q Int)
(declare-const u Int)
(declare-const p Int)
(declare-const r Int)
(declare-const s Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (< t p))
(assert (> r s))
(assert (= q r))
(assert (< t u))
(assert (> u s))
(assert (< u p))
(assert (> p q))
(assert (> p r))
(assert (distinct (pextract (pbvmul (pextract (pbvmul a (pzero_extend (- p r) b)) (- u 1) 0) (pzero_extend (- u s) c)) (- t 1) 0) (pextract (pbvmul a (pzero_extend (- p q) (pbvmul b (pzero_extend (- r s) c)))) (- t 1) 0)))
(check-sat)
