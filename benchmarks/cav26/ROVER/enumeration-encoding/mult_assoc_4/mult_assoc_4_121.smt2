(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const r Int)
(declare-const s Int)
(declare-const t Int)
(declare-const u Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> p r))
(assert (< t s))
(assert (> q p))
(assert (< q s))
(assert (> s r))
(assert (< t q))
(assert (= u p))
(assert (> s u))
(assert (distinct (pextract (pbvmul (pzero_extend (- s u) (pbvmul a (pzero_extend (- p r) b))) c) (- t 1) 0) (pextract (pbvmul (pzero_extend (- q p) a) (pextract (pbvmul (pzero_extend (- s r) b) c) (- q 1) 0)) (- t 1) 0)))
(check-sat)
