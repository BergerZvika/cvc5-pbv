(set-logic PBV)
(declare-const u Int)
(declare-const s Int)
(declare-const p Int)
(declare-const t Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (< p r))
(assert (> t p))
(assert (> u s))
(assert (> r s))
(assert (< q r))
(assert (= t u))
(assert (> t q))
(assert (= u r))
(assert (distinct (pbvmul (pbvmul (pzero_extend (- r p) a) b) (pzero_extend (- u s) c)) (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) (pextract (pbvmul b (pzero_extend (- r s) c)) (- q 1) 0)))))
(check-sat)
