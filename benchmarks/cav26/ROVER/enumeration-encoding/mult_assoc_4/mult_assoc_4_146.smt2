(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-const p Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (<= (+ p r) u))
(assert (> r s))
(assert (= p r))
(assert (> u s))
(assert (= u p))
(assert (distinct (pbvmul (pbvmul a b) (pzero_extend (- u s) c)) (pbvmul a (pbvmul b (pzero_extend (- r s) c)))))
(check-sat)
