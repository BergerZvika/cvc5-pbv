(set-logic PBV)
(declare-const t Int)
(declare-const r Int)
(declare-const u Int)
(declare-const p Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (<= (+ p r) u))
(assert (> r s))
(assert (< t u))
(assert (> u s))
(assert (= t p))
(assert (> u r))
(assert (> u p))
(assert (distinct (pextract (pbvmul (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u r) b)) (pzero_extend (- u s) c)) (- t 1) 0) (pbvmul a (pbvmul b (pzero_extend (- r s) c)))))
(check-sat)
