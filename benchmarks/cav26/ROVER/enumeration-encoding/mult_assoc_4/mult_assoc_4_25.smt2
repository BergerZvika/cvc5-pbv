(set-logic PBV)
(declare-const s Int)
(declare-const q Int)
(declare-const p Int)
(declare-const r Int)
(declare-const u Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (< t q))
(assert (> u r))
(assert (< t s))
(assert (> q p))
(assert (> u p))
(assert (< r s))
(assert (= q s))
(assert (> s u))
(assert (distinct (pextract (pbvmul (pzero_extend (- s u) (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u r) b))) c) (- t 1) 0) (pextract (pbvmul (pzero_extend (- q p) a) (pbvmul (pzero_extend (- s r) b) c)) (- t 1) 0)))
(check-sat)
