(set-logic PBV)
(declare-const t Int)
(declare-const u Int)
(declare-const p Int)
(declare-const r Int)
(declare-const q Int)
(declare-const s Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> u r))
(assert (> s r))
(assert (= t s))
(assert (> t p))
(assert (< q s))
(assert (> t q))
(assert (> u p))
(assert (< u s))
(assert (distinct (pbvmul (pzero_extend (- s u) (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u r) b))) c) (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) (pextract (pbvmul (pzero_extend (- s r) b) c) (- q 1) 0)))))
(check-sat)
