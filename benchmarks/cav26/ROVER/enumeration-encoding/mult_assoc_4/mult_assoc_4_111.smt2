(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-const p Int)
(declare-const s Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (<= (+ r s) q))
(assert (> p q))
(assert (< q s))
(assert (> s r))
(assert (> p r))
(assert (distinct (pbvmul (pbvmul a (pzero_extend (- p r) b)) c) (pbvmul a (pzero_extend (- p q) (pextract (pbvmul (pzero_extend (- s r) b) c) (- q 1) 0)))))
(check-sat)
