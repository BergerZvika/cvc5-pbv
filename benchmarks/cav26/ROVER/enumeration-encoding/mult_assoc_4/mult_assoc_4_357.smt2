(set-logic PBV)
(declare-const p Int)
(declare-const s Int)
(declare-const r Int)
(declare-const q Int)
(declare-const t Int)
(declare-const u Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> t s))
(assert (< u p))
(assert (> p r))
(assert (= q r))
(assert (> t u))
(assert (> t q))
(assert (> r s))
(assert (> t p))
(assert (distinct (pbvmul (pzero_extend (- t u) (pextract (pbvmul a (pzero_extend (- p r) b)) (- u 1) 0)) (pzero_extend (- t s) c)) (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) (pbvmul b (pzero_extend (- r s) c))))))
(check-sat)
