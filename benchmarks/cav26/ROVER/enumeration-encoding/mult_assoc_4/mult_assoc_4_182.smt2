(set-logic PBV)
(declare-const r Int)
(declare-const q Int)
(declare-const p Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (= r s))
(assert (= q r))
(assert (< p q))
(assert (< p r))
(assert (distinct (pbvmul (pbvmul (pzero_extend (- r p) a) b) c) (pbvmul (pzero_extend (- q p) a) (pbvmul b c))))
(check-sat)
