(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const u Int)
(declare-const s Int)
(declare-const r Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> r p))
(assert (< t u))
(assert (< t p))
(assert (= u s))
(assert (> p q))
(assert (< q r))
(assert (> r s))
(assert (< u r))
(assert (distinct (pextract (pbvmul (pextract (pbvmul (pzero_extend (- r p) a) b) (- u 1) 0) c) (- t 1) 0) (pextract (pbvmul a (pzero_extend (- p q) (pextract (pbvmul b (pzero_extend (- r s) c)) (- q 1) 0))) (- t 1) 0)))
(check-sat)
