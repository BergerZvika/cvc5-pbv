(set-logic PBV)
(declare-const r Int)
(declare-const t Int)
(declare-const s Int)
(declare-const q Int)
(declare-const u Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> s r))
(assert (= p r))
(assert (> t p))
(assert (< t s))
(assert (> s u))
(assert (< q s))
(assert (> t q))
(assert (< u p))
(assert (distinct (pextract (pbvmul (pzero_extend (- s u) (pextract (pbvmul a b) (- u 1) 0)) c) (- t 1) 0) (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) (pextract (pbvmul (pzero_extend (- s r) b) c) (- q 1) 0)))))
(check-sat)
