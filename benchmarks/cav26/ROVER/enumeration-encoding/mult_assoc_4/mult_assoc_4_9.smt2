(set-logic PBV)
(declare-const s Int)
(declare-const q Int)
(declare-const u Int)
(declare-const r Int)
(declare-const t Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> q s))
(assert (> t q))
(assert (> q r))
(assert (= t u))
(assert (> t p))
(assert (> u s))
(assert (> u r))
(assert (> u p))
(assert (distinct (pbvmul (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u r) b)) (pzero_extend (- u s) c)) (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) (pbvmul (pzero_extend (- q r) b) (pzero_extend (- q s) c))))))
(check-sat)
