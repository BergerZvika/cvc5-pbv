(set-logic PBV)
(declare-const p Int)
(declare-const s Int)
(declare-const q Int)
(declare-const r Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> t p))
(assert (> t 1))
(assert (>= s (+ p q)))
(assert (< r s))
(assert (< r t))
(assert (> t 1))
(assert (> s q))
(assert (> s p))
(assert (= t q))
(assert (> t p))
(assert (distinct (pextract (pbvadd (pbvmul (pzero_extend (- s p) a) (pzero_extend (- s q) b)) (pzero_extend (- s q) b)) (- r 1) 0) (pextract (pbvmul (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1))) b) (- r 1) 0)))
(check-sat)
