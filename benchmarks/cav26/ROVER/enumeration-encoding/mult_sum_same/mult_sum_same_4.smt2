(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> t p))
(assert (> t 1))
(assert (>= s (+ p q)))
(assert (> s p))
(assert (> t q))
(assert (> t p))
(assert (> s q))
(assert (> t 1))
(assert (distinct (pbvadd (pbvmul (pzero_extend (- s p) a) (pzero_extend (- s q) b)) (pzero_extend (- s q) b)) (pbvmul (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1))) (pzero_extend (- t q) b))))
(check-sat)
