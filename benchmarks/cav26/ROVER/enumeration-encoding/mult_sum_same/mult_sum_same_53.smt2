(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> t p))
(assert (> t 1))
(assert (>= s (+ p q)))
(assert (< r t))
(assert (> p q))
(assert (> t p))
(assert (= s q))
(assert (< s p))
(assert (> t q))
(assert (> t 1))
(assert (< r s))
(assert (distinct (pextract (pbvadd (pextract (pbvmul a (pzero_extend (- p q) b)) (- s 1) 0) b) (- r 1) 0) (pextract (pbvmul (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1))) (pzero_extend (- t q) b)) (- r 1) 0)))
(check-sat)
