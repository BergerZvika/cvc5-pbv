(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> t p))
(assert (> t 1))
(assert (> t 1))
(assert (> t p))
(assert (< t q))
(assert (< p q))
(assert (distinct (pbvadd (pbvmul (pzero_extend (- q p) a) b) b) (pbvmul (pzero_extend (- q t) (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1)))) b)))
(check-sat)
