(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-const t Int)
(declare-const q Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> t p))
(assert (> t 1))
(assert (>= s (+ p q)))
(assert (> r s))
(assert (< s p))
(assert (= p q))
(assert (> t p))
(assert (> r t))
(assert (> t 1))
(assert (> r q))
(assert (distinct (pbvadd (pzero_extend (- r s) (pextract (pbvmul a b) (- s 1) 0)) (pzero_extend (- r q) b)) (pbvmul (pzero_extend (- r t) (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1)))) (pzero_extend (- r q) b))))
(check-sat)
