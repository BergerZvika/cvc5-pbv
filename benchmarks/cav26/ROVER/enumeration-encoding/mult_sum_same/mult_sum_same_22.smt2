(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const q Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> t p))
(assert (> t 1))
(assert (> t 1))
(assert (= p q))
(assert (< r t))
(assert (> t p))
(assert (> t q))
(assert (distinct (pextract (pbvadd (pbvmul a b) b) (- r 1) 0) (pextract (pbvmul (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1))) (pzero_extend (- t q) b)) (- r 1) 0)))
(check-sat)
