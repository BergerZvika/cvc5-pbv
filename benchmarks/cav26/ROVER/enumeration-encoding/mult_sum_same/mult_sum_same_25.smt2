(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const r Int)
(declare-const t Int)
(declare-const s Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> t p))
(assert (> t 1))
(assert (>= s (+ p q)))
(assert (< r t))
(assert (> r s))
(assert (= s q))
(assert (> t 1))
(assert (> t q))
(assert (> r q))
(assert (< p q))
(assert (> t p))
(assert (distinct (pbvadd (pzero_extend (- r s) (pbvmul (pzero_extend (- q p) a) b)) (pzero_extend (- r q) b)) (pextract (pbvmul (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1))) (pzero_extend (- t q) b)) (- r 1) 0)))
(check-sat)
