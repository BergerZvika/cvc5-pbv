(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> t p))
(assert (> t 1))
(assert (> t p))
(assert (> t 1))
(assert (< p q))
(assert (> q t))
(assert (< r q))
(assert (distinct (pextract (pbvadd (pbvmul (pzero_extend (- q p) a) b) b) (- r 1) 0) (pextract (pbvmul (pzero_extend (- q t) (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1)))) b) (- r 1) 0)))
(check-sat)
