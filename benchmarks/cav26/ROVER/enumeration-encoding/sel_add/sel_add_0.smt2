(set-logic PBV)
(declare-const w Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) w))
(declare-fun d () PBitVec)
(assert (= (pbvsize d) w))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) w))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) w))
(declare-fun s () PBitVec)
(assert (= (pbvsize s) 1))
(assert (distinct (ite (= (pextract s 0 0) (int_to_pbv 1 1)) (pbvadd a b) (pbvadd c d)) (pbvadd (ite (= (pextract s 0 0) (int_to_pbv 1 1)) a c) (ite (= (pextract s 0 0) (int_to_pbv 1 1)) b d))))
(check-sat)
