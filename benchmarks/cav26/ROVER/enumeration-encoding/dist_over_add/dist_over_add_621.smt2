(set-logic PBV)
(declare-const u Int)
(declare-const r Int)
(declare-const p Int)
(declare-const s Int)
(declare-const t Int)
(declare-const q Int)
(declare-const v Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (= v t))
(assert (< p t))
(assert (< q s))
(assert (> u p))
(assert (< r u))
(assert (= s t))
(assert (< r p))
(assert (> u s))
(assert (= p q))
(assert (> u v))
(assert (distinct (pextract (pbvmul a (pextract (pbvadd b c) (- q 1) 0)) (- r 1) 0) (pextract (pbvadd (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u s) b)) (pzero_extend (- u v) (pbvmul (pzero_extend (- t p) a) c))) (- r 1) 0)))
(check-sat)
