(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const t Int)
(declare-const q Int)
(declare-const v Int)
(declare-const u Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (< p t))
(assert (> q p))
(assert (> q s))
(assert (> v u))
(assert (< r v))
(assert (< r q))
(assert (> q t))
(assert (= v t))
(assert (= u p))
(assert (= p s))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pbvadd (pzero_extend (- q s) b) (pzero_extend (- q t) c))) (- r 1) 0) (pextract (pbvadd (pzero_extend (- v u) (pbvmul a b)) (pbvmul (pzero_extend (- t p) a) c)) (- r 1) 0)))
(check-sat)
