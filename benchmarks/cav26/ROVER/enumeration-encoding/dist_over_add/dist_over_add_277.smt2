(set-logic PBV)
(declare-const v Int)
(declare-const t Int)
(declare-const r Int)
(declare-const p Int)
(declare-const s Int)
(declare-const u Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= u r))
(assert (>= v r))
(assert (= u v))
(assert (= p s))
(assert (< r u))
(assert (= p t))
(assert (< u p))
(assert (< v p))
(assert (= s t))
(assert (< r p))
(assert (distinct (pextract (pbvmul a (pbvadd b c)) (- r 1) 0) (pextract (pbvadd (pextract (pbvmul a b) (- u 1) 0) (pextract (pbvmul a c) (- v 1) 0)) (- r 1) 0)))
(check-sat)
