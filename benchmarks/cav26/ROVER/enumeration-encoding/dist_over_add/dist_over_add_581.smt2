(set-logic PBV)
(declare-const p Int)
(declare-const s Int)
(declare-const t Int)
(declare-const q Int)
(declare-const u Int)
(declare-const v Int)
(declare-const r Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (= p q))
(assert (< q s))
(assert (= r p))
(assert (> v u))
(assert (> v p))
(assert (> v t))
(assert (= s t))
(assert (< p s))
(assert (= u s))
(assert (< r v))
(assert (distinct (pbvmul a (pextract (pbvadd b c) (- q 1) 0)) (pextract (pbvadd (pzero_extend (- v u) (pbvmul (pzero_extend (- s p) a) b)) (pbvmul (pzero_extend (- v p) a) (pzero_extend (- v t) c))) (- r 1) 0)))
(check-sat)
