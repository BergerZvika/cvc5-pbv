(set-logic PBV)
(declare-const p Int)
(declare-const s Int)
(declare-const r Int)
(declare-const t Int)
(declare-const u Int)
(declare-const q Int)
(declare-const v Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (= p q))
(assert (< r p))
(assert (< q s))
(assert (< v p))
(assert (= r u))
(assert (> s p))
(assert (= u v))
(assert (> s t))
(assert (< u s))
(assert (= p t))
(assert (distinct (pextract (pbvmul a (pextract (pbvadd b (pzero_extend (- s t) c)) (- q 1) 0)) (- r 1) 0) (pbvadd (pextract (pbvmul (pzero_extend (- s p) a) b) (- u 1) 0) (pextract (pbvmul a c) (- v 1) 0))))
(check-sat)
