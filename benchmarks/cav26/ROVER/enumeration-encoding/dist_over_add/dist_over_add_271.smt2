(set-logic PBV)
(declare-const s Int)
(declare-const r Int)
(declare-const t Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (= s t))
(assert (< r p))
(assert (= p t))
(assert (= p s))
(assert (distinct (pextract (pbvmul a (pbvadd b c)) (- r 1) 0) (pextract (pbvadd (pbvmul a b) (pbvmul a c)) (- r 1) 0)))
(check-sat)
