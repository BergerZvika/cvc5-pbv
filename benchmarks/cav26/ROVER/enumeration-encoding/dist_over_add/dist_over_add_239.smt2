(set-logic PBV)
(declare-const u Int)
(declare-const s Int)
(declare-const r Int)
(declare-const v Int)
(declare-const t Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u r))
(assert (>= v r))
(assert (> u p))
(assert (> v t))
(assert (< r v))
(assert (> v u))
(assert (> u s))
(assert (> v p))
(assert (= r p))
(assert (= s t))
(assert (distinct (pbvmul a (pbvadd b c)) (pextract (pbvadd (pzero_extend (- v u) (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u s) b))) (pbvmul (pzero_extend (- v p) a) (pzero_extend (- v t) c))) (- r 1) 0)))
(check-sat)
