(set-logic PBV)
(declare-const t Int)
(declare-const v Int)
(declare-const u Int)
(declare-const p Int)
(declare-const s Int)
(declare-const q Int)
(declare-const r Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (> u p))
(assert (< r u))
(assert (> v t))
(assert (> u s))
(assert (> v p))
(assert (> q p))
(assert (< q s))
(assert (> s t))
(assert (< r q))
(assert (= u v))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pextract (pbvadd b (pzero_extend (- s t) c)) (- q 1) 0)) (- r 1) 0) (pextract (pbvadd (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u s) b)) (pbvmul (pzero_extend (- v p) a) (pzero_extend (- v t) c))) (- r 1) 0)))
(check-sat)
