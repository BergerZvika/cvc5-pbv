(set-logic PBV)
(declare-const v Int)
(declare-const u Int)
(declare-const r Int)
(declare-const p Int)
(declare-const s Int)
(declare-const t Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (< v t))
(assert (< u s))
(assert (> q s))
(assert (= r u))
(assert (= u v))
(assert (> t p))
(assert (> s p))
(assert (< r q))
(assert (> q p))
(assert (> q t))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pbvadd (pzero_extend (- q s) b) (pzero_extend (- q t) c))) (- r 1) 0) (pbvadd (pextract (pbvmul (pzero_extend (- s p) a) b) (- u 1) 0) (pextract (pbvmul (pzero_extend (- t p) a) c) (- v 1) 0))))
(check-sat)
