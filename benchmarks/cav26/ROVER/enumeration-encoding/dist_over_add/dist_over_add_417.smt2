(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const r Int)
(declare-const u Int)
(declare-const v Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (< r v))
(assert (> t s))
(assert (< p s))
(assert (= r q))
(assert (< p t))
(assert (= v t))
(assert (= u s))
(assert (< p q))
(assert (< q t))
(assert (> v u))
(assert (distinct (pbvmul (pzero_extend (- q p) a) (pextract (pbvadd (pzero_extend (- t s) b) c) (- q 1) 0)) (pextract (pbvadd (pzero_extend (- v u) (pbvmul (pzero_extend (- s p) a) b)) (pbvmul (pzero_extend (- t p) a) c)) (- r 1) 0)))
(check-sat)
