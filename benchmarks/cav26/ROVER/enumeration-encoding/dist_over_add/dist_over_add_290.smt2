(set-logic PBV)
(declare-const v Int)
(declare-const t Int)
(declare-const p Int)
(declare-const u Int)
(declare-const r Int)
(declare-const q Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (> v u))
(assert (< r v))
(assert (< u p))
(assert (= q s))
(assert (= s t))
(assert (< r p))
(assert (< v p))
(assert (> p s))
(assert (> p q))
(assert (> p t))
(assert (distinct (pextract (pbvmul a (pzero_extend (- p q) (pbvadd b c))) (- r 1) 0) (pextract (pbvadd (pzero_extend (- v u) (pextract (pbvmul a (pzero_extend (- p s) b)) (- u 1) 0)) (pextract (pbvmul a (pzero_extend (- p t) c)) (- v 1) 0)) (- r 1) 0)))
(check-sat)
