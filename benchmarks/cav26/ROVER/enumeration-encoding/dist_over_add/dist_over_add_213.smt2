(set-logic PBV)
(declare-const s Int)
(declare-const p Int)
(declare-const r Int)
(declare-const v Int)
(declare-const u Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= u r))
(assert (>= v r))
(assert (> v t))
(assert (> s t))
(assert (< r p))
(assert (< r u))
(assert (> u v))
(assert (> u p))
(assert (> u s))
(assert (> v p))
(assert (distinct (pextract (pbvmul a (pbvadd b (pzero_extend (- s t) c))) (- r 1) 0) (pextract (pbvadd (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u s) b)) (pzero_extend (- u v) (pbvmul (pzero_extend (- v p) a) (pzero_extend (- v t) c)))) (- r 1) 0)))
(check-sat)
