(set-logic PBV)
(declare-const v Int)
(declare-const s Int)
(declare-const r Int)
(declare-const u Int)
(declare-const p Int)
(declare-const t Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (> q s))
(assert (< u p))
(assert (= p t))
(assert (< r u))
(assert (= u v))
(assert (> q t))
(assert (< v p))
(assert (< r q))
(assert (> q p))
(assert (> p s))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pbvadd (pzero_extend (- q s) b) (pzero_extend (- q t) c))) (- r 1) 0) (pextract (pbvadd (pextract (pbvmul a (pzero_extend (- p s) b)) (- u 1) 0) (pextract (pbvmul a c) (- v 1) 0)) (- r 1) 0)))
(check-sat)
