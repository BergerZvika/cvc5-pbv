(set-logic PBV)
(declare-const t Int)
(declare-const u Int)
(declare-const s Int)
(declare-const v Int)
(declare-const q Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (> v p))
(assert (> s t))
(assert (> s p))
(assert (> v t))
(assert (< u s))
(assert (< q s))
(assert (< p q))
(assert (= u v))
(assert (distinct (pbvmul (pzero_extend (- q p) a) (pextract (pbvadd b (pzero_extend (- s t) c)) (- q 1) 0)) (pbvadd (pextract (pbvmul (pzero_extend (- s p) a) b) (- u 1) 0) (pbvmul (pzero_extend (- v p) a) (pzero_extend (- v t) c)))))
(check-sat)
