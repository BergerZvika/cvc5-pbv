(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const r Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (< p r))
(assert (= q r))
(assert (= r s))
(assert (< p q))
(assert (distinct (pbvadd (pbvadd (pzero_extend (- r p) a) b) c) (pbvadd (pzero_extend (- q p) a) (pbvadd b c))))
(check-sat)
