(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const u Int)
(declare-const r Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (< u r))
(assert (> r s))
(assert (< q r))
(assert (= u s))
(assert (> r p))
(assert (= p q))
(assert (distinct (pbvadd (pextract (pbvadd (pzero_extend (- r p) a) b) (- u 1) 0) c) (pbvadd a (pextract (pbvadd b (pzero_extend (- r s) c)) (- q 1) 0))))
(check-sat)
