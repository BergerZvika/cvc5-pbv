(set-logic PBV)
(declare-const u Int)
(declare-const r Int)
(declare-const s Int)
(declare-const p Int)
(declare-const t Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q t))
(assert (>= u t))
(assert (< r s))
(assert (> p r))
(assert (< t q))
(assert (> s u))
(assert (< t s))
(assert (= u p))
(assert (= q s))
(assert (> q p))
(assert (distinct (pextract (pbvadd (pzero_extend (- s u) (pbvadd a (pzero_extend (- p r) b))) c) (- t 1) 0) (pextract (pbvadd (pzero_extend (- q p) a) (pbvadd (pzero_extend (- s r) b) c)) (- t 1) 0)))
(check-sat)
