(set-logic PBV)
(declare-const p Int)
(declare-const u Int)
(declare-const v Int)
(declare-const t Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> t u))
(assert (> v p))
(assert (> v u))
(assert (= v q))
(assert (= t q))
(assert (< p q))
(assert (distinct (pbvshl (pbvmul (pzero_extend (- q p) a) b) (pzero_extend (- t u) c)) (pbvmul (pbvshl (pzero_extend (- v p) a) (pzero_extend (- v u) c)) b)))
(check-sat)
