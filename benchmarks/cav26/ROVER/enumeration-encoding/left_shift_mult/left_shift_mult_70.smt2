(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-const p Int)
(declare-const u Int)
(declare-const v Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= v r))
(assert (= p u))
(assert (< r v))
(assert (> v q))
(assert (> p q))
(assert (< v p))
(assert (distinct (pextract (pbvshl (pbvmul a (pzero_extend (- p q) b)) c) (- r 1) 0) (pextract (pbvmul (pextract (pbvshl a c) (- v 1) 0) (pzero_extend (- v q) b)) (- r 1) 0)))
(check-sat)
