(set-logic PBV)
(declare-const u Int)
(declare-const q Int)
(declare-const r Int)
(declare-const t Int)
(declare-const v Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= t r))
(assert (>= v r))
(assert (< r q))
(assert (= t u))
(assert (> q v))
(assert (> q p))
(assert (< r t))
(assert (> p u))
(assert (< v p))
(assert (< t q))
(assert (distinct (pextract (pbvshl (pextract (pbvmul (pzero_extend (- q p) a) b) (- t 1) 0) c) (- r 1) 0) (pextract (pbvmul (pzero_extend (- q v) (pextract (pbvshl a (pzero_extend (- p u) c)) (- v 1) 0)) b) (- r 1) 0)))
(check-sat)
