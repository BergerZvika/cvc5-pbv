(set-logic PBV)
(declare-const q Int)
(declare-const u Int)
(declare-const v Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(assert (> v q))
(assert (= p u))
(assert (> p q))
(assert (= v p))
(assert (distinct (pbvshl (pbvmul a (pzero_extend (- p q) b)) c) (pbvmul (pbvshl a c) (pzero_extend (- v q) b))))
(check-sat)
