(set-logic PBV)
(declare-const t Int)
(declare-const u Int)
(declare-const r Int)
(declare-const q Int)
(declare-const p Int)
(declare-const v Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= t r))
(assert (>= v r))
(assert (< r u))
(assert (= t q))
(assert (> v q))
(assert (> u t))
(assert (< v u))
(assert (< p q))
(assert (< r v))
(assert (> u p))
(assert (distinct (pextract (pbvshl (pzero_extend (- u t) (pbvmul (pzero_extend (- q p) a) b)) c) (- r 1) 0) (pextract (pbvmul (pextract (pbvshl (pzero_extend (- u p) a) c) (- v 1) 0) (pzero_extend (- v q) b)) (- r 1) 0)))
(check-sat)
