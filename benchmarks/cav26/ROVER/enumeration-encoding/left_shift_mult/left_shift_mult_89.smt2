(set-logic PBV)
(declare-const q Int)
(declare-const u Int)
(declare-const r Int)
(declare-const p Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (= p q))
(assert (= p u))
(assert (distinct (pextract (pbvshl (pbvmul a b) c) (- r 1) 0) (pextract (pbvmul (pbvshl a c) b) (- r 1) 0)))
(check-sat)
