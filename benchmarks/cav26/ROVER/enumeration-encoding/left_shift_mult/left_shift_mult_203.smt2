(set-logic PBV)
(declare-const u Int)
(declare-const t Int)
(declare-const r Int)
(declare-const p Int)
(declare-const v Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(assert (>= t r))
(assert (>= v r))
(assert (< r u))
(assert (> u t))
(assert (< t p))
(assert (= r v))
(assert (< v p))
(assert (= p u))
(assert (> p q))
(assert (> v q))
(assert (distinct (pextract (pbvshl (pzero_extend (- u t) (pextract (pbvmul a (pzero_extend (- p q) b)) (- t 1) 0)) c) (- r 1) 0) (pbvmul (pextract (pbvshl a c) (- v 1) 0) (pzero_extend (- v q) b))))
(check-sat)
