(set-logic PBV)
(declare-const q Int)
(declare-const u Int)
(declare-const p Int)
(declare-const v Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (= v q))
(assert (> p q))
(assert (< v p))
(assert (> p u))
(assert (< t p))
(assert (> t u))
(assert (distinct (pbvshl (pextract (pbvmul a (pzero_extend (- p q) b)) (- t 1) 0) (pzero_extend (- t u) c)) (pbvmul (pextract (pbvshl a (pzero_extend (- p u) c)) (- v 1) 0) b)))
(check-sat)
