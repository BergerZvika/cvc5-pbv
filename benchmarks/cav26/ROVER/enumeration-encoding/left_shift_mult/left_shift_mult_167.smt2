(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const u Int)
(declare-const q Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= t r))
(assert (< t p))
(assert (= p q))
(assert (< r u))
(assert (> u t))
(assert (= p u))
(assert (distinct (pextract (pbvshl (pzero_extend (- u t) (pextract (pbvmul a b) (- t 1) 0)) c) (- r 1) 0) (pextract (pbvmul (pbvshl a c) b) (- r 1) 0)))
(check-sat)
