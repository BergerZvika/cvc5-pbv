(set-logic PBV)
(declare-const t Int)
(declare-const u Int)
(declare-const p Int)
(declare-const v Int)
(declare-const q Int)
(declare-const r Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= t r))
(assert (>= v r))
(assert (> t q))
(assert (> t p))
(assert (> t u))
(assert (> q v))
(assert (< v p))
(assert (< r t))
(assert (= p u))
(assert (< r q))
(assert (distinct (pextract (pbvshl (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) b)) (pzero_extend (- t u) c)) (- r 1) 0) (pextract (pbvmul (pzero_extend (- q v) (pextract (pbvshl a c) (- v 1) 0)) b) (- r 1) 0)))
(check-sat)
