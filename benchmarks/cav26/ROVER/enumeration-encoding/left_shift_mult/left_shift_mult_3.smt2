(set-logic PBV)
(declare-const v Int)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const u Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (< p u))
(assert (= t u))
(assert (= v u))
(assert (> t p))
(assert (> v q))
(assert (> t q))
(assert (distinct (pbvshl (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) b)) c) (pbvmul (pbvshl (pzero_extend (- u p) a) c) (pzero_extend (- v q) b))))
(check-sat)
