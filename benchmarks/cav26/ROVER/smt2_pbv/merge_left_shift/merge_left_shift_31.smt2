(set-logic PBV)
(declare-const s Int)
(declare-const r Int)
(declare-const q Int)
(declare-const u Int)
(declare-const p Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= u r))
(assert (> t s))
(assert (> t q))
(assert (> u s))
(assert (> t q))
(assert (< r t))
(assert (> t s))
(assert (< r u))
(assert (= u q))
(assert (< p q))
(assert (> t p))
(assert (distinct (pextract (pbvshl (pbvshl (pzero_extend (- q p) a) b) (pzero_extend (- u s) c)) (- r 1) 0) (pextract (pbvshl (pzero_extend (- t p) a) (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c))) (- r 1) 0)))
(check-sat)
