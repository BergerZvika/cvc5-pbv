(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-const s Int)
(declare-const p Int)
(declare-const t Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= u r))
(assert (> t s))
(assert (> t q))
(assert (= p t))
(assert (> t q))
(assert (< r p))
(assert (= r u))
(assert (< u p))
(assert (> p q))
(assert (> u s))
(assert (> t s))
(assert (distinct (pbvshl (pextract (pbvshl a (pzero_extend (- p q) b)) (- u 1) 0) (pzero_extend (- u s) c)) (pextract (pbvshl a (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c))) (- r 1) 0)))
(check-sat)
