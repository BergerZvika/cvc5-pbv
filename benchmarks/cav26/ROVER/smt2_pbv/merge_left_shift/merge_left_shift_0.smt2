(set-logic PBV)
(declare-const u Int)
(declare-const q Int)
(declare-const r Int)
(declare-const t Int)
(declare-const p Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= u r))
(assert (> t s))
(assert (> t q))
(assert (> t s))
(assert (> r p))
(assert (= r u))
(assert (> r t))
(assert (> u q))
(assert (> t q))
(assert (> u p))
(assert (> u s))
(assert (distinct (pbvshl (pbvshl (pzero_extend (- u p) a) (pzero_extend (- u q) b)) (pzero_extend (- u s) c)) (pbvshl (pzero_extend (- r p) a) (pzero_extend (- r t) (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c))))))
(check-sat)
