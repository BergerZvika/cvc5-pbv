(set-logic PBV)
(declare-const u Int)
(declare-const s Int)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const r Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= u r))
(assert (> t s))
(assert (> t q))
(assert (< r t))
(assert (> s u))
(assert (> t q))
(assert (> t p))
(assert (> t s))
(assert (< u p))
(assert (= p q))
(assert (< r s))
(assert (distinct (pextract (pbvshl (pzero_extend (- s u) (pextract (pbvshl a b) (- u 1) 0)) c) (- r 1) 0) (pextract (pbvshl (pzero_extend (- t p) a) (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c))) (- r 1) 0)))
(check-sat)
