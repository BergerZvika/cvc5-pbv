(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (= r r))
(assert (> r p))
(assert (> r q))
(assert (< p r))
(assert (distinct (pbvsub (pzero_extend (- r p) a) (pzero_extend (- r q) b)) (pbvadd (pzero_extend (- r p) a) (pbvneg (pzero_extend (- r q) b)))))
(check-sat)
