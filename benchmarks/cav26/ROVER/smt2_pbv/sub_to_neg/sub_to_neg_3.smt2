(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const r Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (< p r))
(assert (= r r))
(assert (< p q))
(assert (= r q))
(assert (distinct (pbvsub (pzero_extend (- q p) a) b) (pbvadd (pzero_extend (- r p) a) (pbvneg b))))
(check-sat)
