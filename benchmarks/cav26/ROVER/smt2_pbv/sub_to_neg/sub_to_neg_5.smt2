(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const r Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (< p r))
(assert (= r r))
(assert (< r q))
(assert (> q p))
(assert (distinct (pextract (pbvsub (pzero_extend (- q p) a) b) (- r 1) 0) (pbvadd (pzero_extend (- r p) a) (pextract (pbvneg b) (- r 1) 0))))
(check-sat)
