(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (= r p))
(assert (> p q))
(assert (= p r))
(assert (> r q))
(assert (distinct (pbvsub a (pzero_extend (- p q) b)) (pbvadd a (pbvneg (pzero_extend (- r q) b)))))
(check-sat)
