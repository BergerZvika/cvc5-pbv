(set-logic PBV)
(declare-const u Int)
(declare-const s Int)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const r Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (>= q t))
(assert (>= u t))
(assert (< t q))
(assert (> q s))
(assert (> p r))
(assert (< u p))
(assert (> q r))
(assert (< t s))
(assert (> s u))
(assert (> q p))
(assert (distinct (pextract (pbvmul (pzero_extend (- s u) (pextract (pbvmul a (pzero_extend (- p r) b)) (- u 1) 0)) c) (- t 1) 0) (pextract (pbvmul (pzero_extend (- q p) a) (pbvmul (pzero_extend (- q r) b) (pzero_extend (- q s) c))) (- t 1) 0)))
(check-sat)
