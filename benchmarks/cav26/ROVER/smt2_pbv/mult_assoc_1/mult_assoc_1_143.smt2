(set-logic PBV)
(declare-const s Int)
(declare-const p Int)
(declare-const u Int)
(declare-const r Int)
(declare-const t Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= q t))
(assert (>= u t))
(assert (> p q))
(assert (> r p))
(assert (< u r))
(assert (< q r))
(assert (< t p))
(assert (= r s))
(assert (> s u))
(assert (< t s))
(assert (distinct (pextract (pbvmul (pzero_extend (- s u) (pextract (pbvmul (pzero_extend (- r p) a) b) (- u 1) 0)) c) (- t 1) 0) (pextract (pbvmul a (pzero_extend (- p q) (pextract (pbvmul b c) (- q 1) 0))) (- t 1) 0)))
(check-sat)
