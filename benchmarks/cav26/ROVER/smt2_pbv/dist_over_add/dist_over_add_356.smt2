(set-logic PBV)
(declare-const s Int)
(declare-const r Int)
(declare-const p Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (< r p))
(assert (< s t))
(assert (> p s))
(assert (= p t))
(assert (distinct (pextract (pbvmul a (pbvadd (pzero_extend (- t s) b) c)) (- r 1) 0) (pextract (pbvadd (pbvmul a (pzero_extend (- p s) b)) (pbvmul a c)) (- r 1) 0)))
(check-sat)
