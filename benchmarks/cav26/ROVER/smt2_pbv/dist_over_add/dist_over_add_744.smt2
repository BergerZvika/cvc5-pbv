(set-logic PBV)
(declare-const s Int)
(declare-const p Int)
(declare-const t Int)
(declare-const u Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q r))
(assert (>= u r))
(assert (< r q))
(assert (= r u))
(assert (< u s))
(assert (< q s))
(assert (> q p))
(assert (= p t))
(assert (> s t))
(assert (> s p))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pextract (pbvadd b (pzero_extend (- s t) c)) (- q 1) 0)) (- r 1) 0) (pbvadd (pextract (pbvmul (pzero_extend (- s p) a) b) (- u 1) 0) (pbvmul a c))))
(check-sat)
