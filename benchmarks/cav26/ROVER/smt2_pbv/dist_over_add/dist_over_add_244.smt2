(set-logic PBV)
(declare-const t Int)
(declare-const p Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (= p s))
(assert (= p t))
(assert (= s t))
(assert (distinct (pbvmul a (pbvadd b c)) (pbvadd (pbvmul a b) (pbvmul a c))))
(check-sat)
