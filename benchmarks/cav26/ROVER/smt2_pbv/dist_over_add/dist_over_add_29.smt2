(set-logic PBV)
(declare-const q Int)
(declare-const t Int)
(declare-const p Int)
(declare-const s Int)
(declare-const r Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (> q t))
(assert (= p t))
(assert (> p s))
(assert (< r q))
(assert (> q p))
(assert (> q s))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pbvadd (pzero_extend (- q s) b) (pzero_extend (- q t) c))) (- r 1) 0) (pbvadd (pbvmul a (pzero_extend (- p s) b)) (pbvmul a c))))
(check-sat)
