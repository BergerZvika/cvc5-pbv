(set-logic PBV)
(declare-const s Int)
(declare-const q Int)
(declare-const p Int)
(declare-const t Int)
(declare-const v Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (> s t))
(assert (> v p))
(assert (< p s))
(assert (> v t))
(assert (= q s))
(assert (< p q))
(assert (distinct (pbvmul (pzero_extend (- q p) a) (pbvadd b (pzero_extend (- s t) c))) (pbvadd (pbvmul (pzero_extend (- s p) a) b) (pbvmul (pzero_extend (- v p) a) (pzero_extend (- v t) c)))))
(check-sat)
