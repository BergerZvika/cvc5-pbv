(set-logic PBV)
(declare-const t Int)
(declare-const u Int)
(declare-const r Int)
(declare-const p Int)
(declare-const v Int)
(declare-const q Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (> q s))
(assert (> v t))
(assert (< r v))
(assert (> v u))
(assert (> p s))
(assert (= u p))
(assert (> p q))
(assert (< r p))
(assert (> q t))
(assert (> v p))
(assert (distinct (pextract (pbvmul a (pzero_extend (- p q) (pbvadd (pzero_extend (- q s) b) (pzero_extend (- q t) c)))) (- r 1) 0) (pextract (pbvadd (pzero_extend (- v u) (pbvmul a (pzero_extend (- p s) b))) (pbvmul (pzero_extend (- v p) a) (pzero_extend (- v t) c))) (- r 1) 0)))
(check-sat)
