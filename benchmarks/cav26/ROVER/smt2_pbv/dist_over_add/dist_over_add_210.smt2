(set-logic PBV)
(declare-const t Int)
(declare-const v Int)
(declare-const q Int)
(declare-const p Int)
(declare-const u Int)
(declare-const s Int)
(declare-const r Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (< r u))
(assert (> u v))
(assert (< v p))
(assert (< u s))
(assert (< r q))
(assert (> s p))
(assert (= q s))
(assert (> s t))
(assert (> q p))
(assert (> p t))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pbvadd b (pzero_extend (- s t) c))) (- r 1) 0) (pextract (pbvadd (pextract (pbvmul (pzero_extend (- s p) a) b) (- u 1) 0) (pzero_extend (- u v) (pextract (pbvmul a (pzero_extend (- p t) c)) (- v 1) 0))) (- r 1) 0)))
(check-sat)
