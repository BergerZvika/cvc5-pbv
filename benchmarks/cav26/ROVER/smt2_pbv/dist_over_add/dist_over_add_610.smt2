(set-logic PBV)
(declare-const t Int)
(declare-const s Int)
(declare-const r Int)
(declare-const q Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= q r))
(assert (> q p))
(assert (< p s))
(assert (= s t))
(assert (< r q))
(assert (< p t))
(assert (< q s))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pextract (pbvadd b c) (- q 1) 0)) (- r 1) 0) (pextract (pbvadd (pbvmul (pzero_extend (- s p) a) b) (pbvmul (pzero_extend (- t p) a) c)) (- r 1) 0)))
(check-sat)
