(set-logic PBV)
(declare-const p Int)
(declare-const t Int)
(declare-const s Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> p t))
(assert (> q s))
(assert (> q t))
(assert (= p q))
(assert (> p s))
(assert (distinct (pbvmul a (pbvadd (pzero_extend (- q s) b) (pzero_extend (- q t) c))) (pbvadd (pbvmul a (pzero_extend (- p s) b)) (pbvmul a (pzero_extend (- p t) c)))))
(check-sat)
