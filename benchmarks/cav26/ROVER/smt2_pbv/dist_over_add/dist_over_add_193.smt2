(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const u Int)
(declare-const s Int)
(declare-const t Int)
(declare-const r Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= q r))
(assert (>= u r))
(assert (> s t))
(assert (= q s))
(assert (< u s))
(assert (< r q))
(assert (< r u))
(assert (= p t))
(assert (> s p))
(assert (> q p))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pbvadd b (pzero_extend (- s t) c))) (- r 1) 0) (pextract (pbvadd (pextract (pbvmul (pzero_extend (- s p) a) b) (- u 1) 0) (pbvmul a c)) (- r 1) 0)))
(check-sat)
