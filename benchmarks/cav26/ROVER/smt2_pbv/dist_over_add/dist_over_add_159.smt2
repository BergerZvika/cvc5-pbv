(set-logic PBV)
(declare-const t Int)
(declare-const p Int)
(declare-const s Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (= p s))
(assert (> p t))
(assert (> s t))
(assert (distinct (pbvmul a (pbvadd b (pzero_extend (- s t) c))) (pbvadd (pbvmul a b) (pbvmul a (pzero_extend (- p t) c)))))
(check-sat)
