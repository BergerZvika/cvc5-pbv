(set-logic PBV)
(declare-const p Int)
(declare-const t Int)
(declare-const q Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (= q s))
(assert (< p t))
(assert (< p q))
(assert (= s t))
(assert (< p s))
(assert (distinct (pbvmul (pzero_extend (- q p) a) (pbvadd b c)) (pbvadd (pbvmul (pzero_extend (- s p) a) b) (pbvmul (pzero_extend (- t p) a) c))))
(check-sat)
