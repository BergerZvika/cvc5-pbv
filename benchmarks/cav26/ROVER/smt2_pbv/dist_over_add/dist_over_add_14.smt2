(set-logic PBV)
(declare-const s Int)
(declare-const t Int)
(declare-const u Int)
(declare-const q Int)
(declare-const v Int)
(declare-const r Int)
(declare-const p Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (> u p))
(assert (< r u))
(assert (> u v))
(assert (= v p))
(assert (> p t))
(assert (> q p))
(assert (< r q))
(assert (> q s))
(assert (> q t))
(assert (> u s))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pbvadd (pzero_extend (- q s) b) (pzero_extend (- q t) c))) (- r 1) 0) (pextract (pbvadd (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u s) b)) (pzero_extend (- u v) (pbvmul a (pzero_extend (- p t) c)))) (- r 1) 0)))
(check-sat)
