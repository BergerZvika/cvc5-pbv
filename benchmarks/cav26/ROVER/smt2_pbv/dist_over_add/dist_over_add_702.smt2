(set-logic PBV)
(declare-const s Int)
(declare-const v Int)
(declare-const p Int)
(declare-const t Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= v r))
(assert (> v t))
(assert (> v p))
(assert (> s t))
(assert (< p q))
(assert (< p s))
(assert (= r q))
(assert (< q s))
(assert (distinct (pbvmul (pzero_extend (- q p) a) (pextract (pbvadd b (pzero_extend (- s t) c)) (- q 1) 0)) (pextract (pbvadd (pbvmul (pzero_extend (- s p) a) b) (pbvmul (pzero_extend (- v p) a) (pzero_extend (- v t) c))) (- r 1) 0)))
(check-sat)
