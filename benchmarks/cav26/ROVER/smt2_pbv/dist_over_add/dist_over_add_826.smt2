(set-logic PBV)
(declare-const r Int)
(declare-const v Int)
(declare-const p Int)
(declare-const q Int)
(declare-const u Int)
(declare-const t Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (> s t))
(assert (= u s))
(assert (< r p))
(assert (> p q))
(assert (< p t))
(assert (< p s))
(assert (> u v))
(assert (< q s))
(assert (= v t))
(assert (< r u))
(assert (distinct (pextract (pbvmul a (pzero_extend (- p q) (pextract (pbvadd b (pzero_extend (- s t) c)) (- q 1) 0))) (- r 1) 0) (pextract (pbvadd (pbvmul (pzero_extend (- s p) a) b) (pzero_extend (- u v) (pbvmul (pzero_extend (- t p) a) c))) (- r 1) 0)))
(check-sat)
