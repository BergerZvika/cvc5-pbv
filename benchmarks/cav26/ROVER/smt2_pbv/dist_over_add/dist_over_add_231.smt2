(set-logic PBV)
(declare-const t Int)
(declare-const p Int)
(declare-const r Int)
(declare-const s Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (< r p))
(assert (> p t))
(assert (> p q))
(assert (= q s))
(assert (> s t))
(assert (> p s))
(assert (distinct (pextract (pbvmul a (pzero_extend (- p q) (pbvadd b (pzero_extend (- s t) c)))) (- r 1) 0) (pextract (pbvadd (pbvmul a (pzero_extend (- p s) b)) (pbvmul a (pzero_extend (- p t) c))) (- r 1) 0)))
(check-sat)
