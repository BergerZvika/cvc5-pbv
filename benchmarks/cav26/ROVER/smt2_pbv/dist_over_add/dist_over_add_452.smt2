(set-logic PBV)
(declare-const r Int)
(declare-const q Int)
(declare-const t Int)
(declare-const s Int)
(declare-const v Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= q r))
(assert (>= v r))
(assert (> t s))
(assert (> t p))
(assert (< q t))
(assert (> q p))
(assert (< v t))
(assert (< p s))
(assert (< r q))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pextract (pbvadd (pzero_extend (- t s) b) c) (- q 1) 0)) (- r 1) 0) (pbvadd (pbvmul (pzero_extend (- s p) a) b) (pextract (pbvmul (pzero_extend (- t p) a) c) (- v 1) 0))))
(check-sat)
