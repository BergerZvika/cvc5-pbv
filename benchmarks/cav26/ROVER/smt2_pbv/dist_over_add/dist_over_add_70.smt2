(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-const u Int)
(declare-const s Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= u r))
(assert (< r q))
(assert (> p t))
(assert (< u s))
(assert (> q t))
(assert (> s p))
(assert (> q p))
(assert (> q s))
(assert (= r u))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pbvadd (pzero_extend (- q s) b) (pzero_extend (- q t) c))) (- r 1) 0) (pbvadd (pextract (pbvmul (pzero_extend (- s p) a) b) (- u 1) 0) (pbvmul a (pzero_extend (- p t) c)))))
(check-sat)
