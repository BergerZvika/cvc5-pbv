(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const r Int)
(declare-const s Int)
(declare-const u Int)
(declare-const v Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (> v p))
(assert (> p s))
(assert (< s t))
(assert (> v u))
(assert (> v t))
(assert (> q p))
(assert (= q t))
(assert (< r v))
(assert (< u p))
(assert (< r q))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pbvadd (pzero_extend (- t s) b) c)) (- r 1) 0) (pextract (pbvadd (pzero_extend (- v u) (pextract (pbvmul a (pzero_extend (- p s) b)) (- u 1) 0)) (pbvmul (pzero_extend (- v p) a) (pzero_extend (- v t) c))) (- r 1) 0)))
(check-sat)
