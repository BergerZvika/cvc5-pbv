(set-logic PBV)
(declare-const p Int)
(declare-const v Int)
(declare-const s Int)
(declare-const t Int)
(declare-const q Int)
(declare-const u Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (< u s))
(assert (< v t))
(assert (> s p))
(assert (< p q))
(assert (= s t))
(assert (> t p))
(assert (= u v))
(assert (< q s))
(assert (distinct (pbvmul (pzero_extend (- q p) a) (pextract (pbvadd b c) (- q 1) 0)) (pbvadd (pextract (pbvmul (pzero_extend (- s p) a) b) (- u 1) 0) (pextract (pbvmul (pzero_extend (- t p) a) c) (- v 1) 0))))
(check-sat)
