(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const u Int)
(declare-const s Int)
(declare-const r Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= u r))
(assert (> u p))
(assert (< r q))
(assert (> q s))
(assert (< p t))
(assert (> u s))
(assert (= r u))
(assert (> q p))
(assert (> q t))
(assert (distinct (pextract (pbvmul (pzero_extend (- q p) a) (pbvadd (pzero_extend (- q s) b) (pzero_extend (- q t) c))) (- r 1) 0) (pbvadd (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u s) b)) (pbvmul (pzero_extend (- t p) a) c))))
(check-sat)
