(set-logic PBV)
(declare-const p Int)
(declare-const t Int)
(declare-const s Int)
(declare-const u Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (> u s))
(assert (< p t))
(assert (< p q))
(assert (< s t))
(assert (= q t))
(assert (> u p))
(assert (distinct (pbvmul (pzero_extend (- q p) a) (pbvadd (pzero_extend (- t s) b) c)) (pbvadd (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u s) b)) (pbvmul (pzero_extend (- t p) a) c))))
(check-sat)
