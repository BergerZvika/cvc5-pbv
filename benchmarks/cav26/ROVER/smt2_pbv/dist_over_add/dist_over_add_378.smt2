(set-logic PBV)
(declare-const p Int)
(declare-const s Int)
(declare-const t Int)
(declare-const v Int)
(declare-const r Int)
(declare-const u Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (< q t))
(assert (> u s))
(assert (< r v))
(assert (> t s))
(assert (> v p))
(assert (= p q))
(assert (= r p))
(assert (> u p))
(assert (> v u))
(assert (> v t))
(assert (distinct (pbvmul a (pextract (pbvadd (pzero_extend (- t s) b) c) (- q 1) 0)) (pextract (pbvadd (pzero_extend (- v u) (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u s) b))) (pbvmul (pzero_extend (- v p) a) (pzero_extend (- v t) c))) (- r 1) 0)))
(check-sat)
