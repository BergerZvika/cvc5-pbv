(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const t Int)
(declare-const s Int)
(declare-const q Int)
(declare-const v Int)
(declare-const u Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) s))
(assert (>= q r))
(assert (>= u r))
(assert (>= v r))
(assert (> p q))
(assert (< r p))
(assert (> p s))
(assert (< u p))
(assert (= q t))
(assert (< v p))
(assert (> p t))
(assert (= u v))
(assert (< r u))
(assert (< s t))
(assert (distinct (pextract (pbvmul a (pzero_extend (- p q) (pbvadd (pzero_extend (- t s) b) c))) (- r 1) 0) (pextract (pbvadd (pextract (pbvmul a (pzero_extend (- p s) b)) (- u 1) 0) (pextract (pbvmul a (pzero_extend (- p t) c)) (- v 1) 0)) (- r 1) 0)))
(check-sat)
