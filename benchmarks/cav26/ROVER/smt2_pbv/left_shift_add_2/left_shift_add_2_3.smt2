(set-logic PBV)
(declare-const s Int)
(declare-const p Int)
(declare-const t Int)
(declare-const u Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= u r))
(assert (> s p))
(assert (> s q))
(assert (> u t))
(assert (< r u))
(assert (= u u))
(assert (> u p))
(assert (> s p))
(assert (> u q))
(assert (= r s))
(assert (> s t))
(assert (> s q))
(assert (distinct (pbvshl (pbvadd (pzero_extend (- s p) a) (pzero_extend (- s q) b)) (pzero_extend (- s t) c)) (pextract (pbvadd (pbvshl (pzero_extend (- u p) a) (pzero_extend (- u t) c)) (pbvshl (pzero_extend (- u q) b) (pzero_extend (- u t) c))) (- r 1) 0)))
(check-sat)
