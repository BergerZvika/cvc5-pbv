(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const u Int)
(declare-const r Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u r))
(assert (> s p))
(assert (> s q))
(assert (> t p))
(assert (> t q))
(assert (= r u))
(assert (< u t))
(assert (> s q))
(assert (= s t))
(assert (= u u))
(assert (> s p))
(assert (< r s))
(assert (distinct (pextract (pbvshl (pbvadd (pzero_extend (- s p) a) (pzero_extend (- s q) b)) c) (- r 1) 0) (pbvadd (pextract (pbvshl (pzero_extend (- t p) a) c) (- u 1) 0) (pextract (pbvshl (pzero_extend (- t q) b) c) (- u 1) 0))))
(check-sat)
