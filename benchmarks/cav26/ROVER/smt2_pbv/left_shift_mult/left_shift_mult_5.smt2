(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-const p Int)
(declare-const v Int)
(declare-const q Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(assert (>= t r))
(assert (>= v r))
(assert (> v q))
(assert (= v u))
(assert (< r u))
(assert (> t p))
(assert (> u t))
(assert (< r v))
(assert (> t q))
(assert (< p u))
(assert (distinct (pextract (pbvshl (pzero_extend (- u t) (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) b))) c) (- r 1) 0) (pextract (pbvmul (pbvshl (pzero_extend (- u p) a) c) (pzero_extend (- v q) b)) (- r 1) 0)))
(check-sat)
