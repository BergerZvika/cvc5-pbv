(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const q Int)
(declare-const u Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(assert (>= t r))
(assert (> t u))
(assert (= p u))
(assert (< r t))
(assert (> t p))
(assert (> t q))
(assert (distinct (pextract (pbvshl (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) b)) (pzero_extend (- t u) c)) (- r 1) 0) (pbvmul (pbvshl a c) b)))
(check-sat)
