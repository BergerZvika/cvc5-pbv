(set-logic PBV)
(declare-const u Int)
(declare-const q Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (< p u))
(assert (< p q))
(assert (distinct (pbvshl (pbvmul (pzero_extend (- q p) a) b) c) (pbvmul (pbvshl (pzero_extend (- u p) a) c) b)))
(check-sat)
