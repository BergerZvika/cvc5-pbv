(set-logic PBV)
(declare-const r Int)
(declare-const t Int)
(declare-const q Int)
(declare-const p Int)
(declare-const u Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(assert (>= t r))
(assert (= p q))
(assert (> p u))
(assert (= t p))
(assert (> t u))
(assert (< r t))
(assert (distinct (pextract (pbvshl (pbvmul a b) (pzero_extend (- t u) c)) (- r 1) 0) (pextract (pbvmul (pbvshl a (pzero_extend (- p u) c)) b) (- r 1) 0)))
(check-sat)
