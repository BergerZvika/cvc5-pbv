(set-logic PBV)
(declare-const v Int)
(declare-const t Int)
(declare-const q Int)
(declare-const p Int)
(declare-const u Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> t u))
(assert (= v p))
(assert (= t p))
(assert (> v q))
(assert (> p u))
(assert (> p q))
(assert (distinct (pbvshl (pbvmul a (pzero_extend (- p q) b)) (pzero_extend (- t u) c)) (pbvmul (pbvshl a (pzero_extend (- p u) c)) (pzero_extend (- v q) b))))
(check-sat)
