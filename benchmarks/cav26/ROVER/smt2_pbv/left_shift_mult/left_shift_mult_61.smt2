(set-logic PBV)
(declare-const t Int)
(declare-const u Int)
(declare-const p Int)
(declare-const v Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(assert (>= t r))
(assert (>= v r))
(assert (= t p))
(assert (> q v))
(assert (> p q))
(assert (> u t))
(assert (< v u))
(assert (< r q))
(assert (> u p))
(assert (< r u))
(assert (distinct (pextract (pbvshl (pzero_extend (- u t) (pbvmul a (pzero_extend (- p q) b))) c) (- r 1) 0) (pextract (pbvmul (pzero_extend (- q v) (pextract (pbvshl (pzero_extend (- u p) a) c) (- v 1) 0)) b) (- r 1) 0)))
(check-sat)
