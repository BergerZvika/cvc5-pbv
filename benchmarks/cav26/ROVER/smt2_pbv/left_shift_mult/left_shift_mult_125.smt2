(set-logic PBV)
(declare-const u Int)
(declare-const v Int)
(declare-const t Int)
(declare-const q Int)
(declare-const r Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(assert (>= t r))
(assert (>= v r))
(assert (= t u))
(assert (= r t))
(assert (= v p))
(assert (< r q))
(assert (> q p))
(assert (= p u))
(assert (< t q))
(assert (> q v))
(assert (distinct (pbvshl (pextract (pbvmul (pzero_extend (- q p) a) b) (- t 1) 0) c) (pextract (pbvmul (pzero_extend (- q v) (pbvshl a c)) b) (- r 1) 0)))
(check-sat)
