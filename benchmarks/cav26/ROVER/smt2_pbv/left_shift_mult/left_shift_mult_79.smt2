(set-logic PBV)
(declare-const t Int)
(declare-const p Int)
(declare-const q Int)
(declare-const u Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(assert (> t u))
(assert (= p q))
(assert (> p u))
(assert (= t p))
(assert (distinct (pbvshl (pbvmul a b) (pzero_extend (- t u) c)) (pbvmul (pbvshl a (pzero_extend (- p u) c)) b)))
(check-sat)
