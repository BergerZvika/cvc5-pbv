(set-logic PBV)
(declare-const u Int)
(declare-const r Int)
(declare-const q Int)
(declare-const t Int)
(declare-const v Int)
(declare-const p Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= t r))
(assert (>= v r))
(assert (< r q))
(assert (< r t))
(assert (> t u))
(assert (< t q))
(assert (> q p))
(assert (< v u))
(assert (> u p))
(assert (> q v))
(assert (distinct (pextract (pbvshl (pextract (pbvmul (pzero_extend (- q p) a) b) (- t 1) 0) (pzero_extend (- t u) c)) (- r 1) 0) (pextract (pbvmul (pzero_extend (- q v) (pextract (pbvshl (pzero_extend (- u p) a) c) (- v 1) 0)) b) (- r 1) 0)))
(check-sat)
