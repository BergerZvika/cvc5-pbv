(set-logic PBV)
(declare-const t Int)
(declare-const u Int)
(declare-const p Int)
(declare-const q Int)
(declare-const r Int)
(declare-const v Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(assert (>= t r))
(assert (>= v r))
(assert (> q p))
(assert (< r v))
(assert (> v q))
(assert (> v u))
(assert (> v p))
(assert (= r t))
(assert (= t u))
(assert (< t q))
(assert (distinct (pbvshl (pextract (pbvmul (pzero_extend (- q p) a) b) (- t 1) 0) c) (pextract (pbvmul (pbvshl (pzero_extend (- v p) a) (pzero_extend (- v u) c)) (pzero_extend (- v q) b)) (- r 1) 0)))
(check-sat)
