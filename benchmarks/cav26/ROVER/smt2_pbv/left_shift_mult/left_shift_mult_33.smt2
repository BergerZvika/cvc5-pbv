(set-logic PBV)
(declare-const t Int)
(declare-const v Int)
(declare-const p Int)
(declare-const r Int)
(declare-const q Int)
(declare-const u Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(assert (>= t r))
(assert (>= v r))
(assert (< p u))
(assert (> t p))
(assert (> v q))
(assert (= r v))
(assert (> t q))
(assert (= v u))
(assert (< r t))
(assert (> t u))
(assert (distinct (pextract (pbvshl (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) b)) (pzero_extend (- t u) c)) (- r 1) 0) (pbvmul (pbvshl (pzero_extend (- u p) a) c) (pzero_extend (- v q) b))))
(check-sat)
