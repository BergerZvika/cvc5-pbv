(set-logic PBV)
(declare-const q Int)
(declare-const t Int)
(declare-const r Int)
(declare-const u Int)
(declare-const v Int)
(declare-const p Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= t r))
(assert (>= v r))
(assert (= p u))
(assert (= v p))
(assert (> t u))
(assert (< r t))
(assert (< p q))
(assert (= t q))
(assert (> q v))
(assert (< r q))
(assert (distinct (pextract (pbvshl (pbvmul (pzero_extend (- q p) a) b) (pzero_extend (- t u) c)) (- r 1) 0) (pextract (pbvmul (pzero_extend (- q v) (pbvshl a c)) b) (- r 1) 0)))
(check-sat)
