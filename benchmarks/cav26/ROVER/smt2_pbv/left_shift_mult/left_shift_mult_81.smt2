(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const u Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) u))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (= p q))
(assert (= p u))
(assert (distinct (pbvshl (pbvmul a b) c) (pbvmul (pbvshl a c) b)))
(check-sat)
