(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (= r p))
(assert (> 2 p))
(assert (= p 1))
(assert (< r 2))
(assert (distinct (pextract (pbvmul (pzero_extend (- 2 p) a) (int_to_pbv 2 2)) (- r 1) 0) (pbvshl a (int_to_pbv 1 1))))
(check-sat)
