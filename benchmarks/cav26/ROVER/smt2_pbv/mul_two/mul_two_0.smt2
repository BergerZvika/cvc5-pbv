(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> r 2))
(assert (> r p))
(assert (> r 1))
(assert (distinct (pbvmul (pzero_extend (- r p) a) (pzero_extend (- r 2) (int_to_pbv 2 2))) (pbvshl (pzero_extend (- r p) a) (pzero_extend (- r 1) (int_to_pbv 1 1)))))
(check-sat)
