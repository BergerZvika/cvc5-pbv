(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (< r p))
(assert (> p 2))
(assert (> p 1))
(assert (distinct (pextract (pbvmul a (pzero_extend (- p 2) (int_to_pbv 2 2))) (- r 1) 0) (pextract (pbvshl a (pzero_extend (- p 1) (int_to_pbv 1 1))) (- r 1) 0)))
(check-sat)
