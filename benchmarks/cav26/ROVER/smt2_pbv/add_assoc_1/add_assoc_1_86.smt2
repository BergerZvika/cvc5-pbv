(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const s Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (< t p))
(assert (= r s))
(assert (= p r))
(assert (distinct (pextract (pbvadd (pbvadd a b) c) (- t 1) 0) (pextract (pbvadd a (pbvadd b c)) (- t 1) 0)))
(check-sat)
