(set-logic PBV)
(declare-const s Int)
(declare-const u Int)
(declare-const t Int)
(declare-const r Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= u t))
(assert (= p r))
(assert (< u p))
(assert (< t p))
(assert (> r s))
(assert (= t u))
(assert (> u s))
(assert (distinct (pbvadd (pextract (pbvadd a b) (- u 1) 0) (pzero_extend (- u s) c)) (pextract (pbvadd a (pbvadd b (pzero_extend (- r s) c))) (- t 1) 0)))
(check-sat)
