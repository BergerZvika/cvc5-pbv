(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const t Int)
(declare-const s Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= q t))
(assert (< p r))
(assert (= t p))
(assert (= r s))
(assert (= p q))
(assert (< q r))
(assert (distinct (pextract (pbvadd (pbvadd (pzero_extend (- r p) a) b) c) (- t 1) 0) (pbvadd a (pextract (pbvadd b c) (- q 1) 0))))
(check-sat)
