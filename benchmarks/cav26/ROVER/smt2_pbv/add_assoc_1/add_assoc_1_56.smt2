(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (< r s))
(assert (> p r))
(assert (distinct (pbvadd (pbvadd a (pzero_extend (- p r) b)) c) (pbvadd a (pbvadd (pzero_extend (- s r) b) c))))
(check-sat)
