(set-logic PBV)
(declare-const s Int)
(declare-const r Int)
(declare-const t Int)
(declare-const p Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= q t))
(assert (< t p))
(assert (> p q))
(assert (< q r))
(assert (= r s))
(assert (= p r))
(assert (distinct (pextract (pbvadd (pbvadd a b) c) (- t 1) 0) (pextract (pbvadd a (pzero_extend (- p q) (pextract (pbvadd b c) (- q 1) 0))) (- t 1) 0)))
(check-sat)
