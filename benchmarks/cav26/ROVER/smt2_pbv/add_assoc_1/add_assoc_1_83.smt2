(set-logic PBV)
(declare-const p Int)
(declare-const t Int)
(declare-const q Int)
(declare-const s Int)
(declare-const r Int)
(declare-const u Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q t))
(assert (>= u t))
(assert (> s r))
(assert (= p q))
(assert (< t s))
(assert (> s u))
(assert (= u p))
(assert (= p r))
(assert (< t p))
(assert (< q s))
(assert (distinct (pextract (pbvadd (pzero_extend (- s u) (pbvadd a b)) c) (- t 1) 0) (pextract (pbvadd a (pextract (pbvadd (pzero_extend (- s r) b) c) (- q 1) 0)) (- t 1) 0)))
(check-sat)
