(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-fun x () PBitVec)
(assert (= (pbvsize x) p))
(assert (> q (+ p 2)))
(assert (> q p))
(assert (< p q))
(assert (> q p))
(assert (= 1 p))
(assert (= p 1))
(assert (> q 2))
(assert (distinct (pbvmul (int_to_pbv 1 1) x) (pextract (pbvsub (pbvmul (pzero_extend (- q 2) (int_to_pbv 2 2)) (pzero_extend (- q p) x)) (pzero_extend (- q p) x)) (- p 1) 0)))
(check-sat)
