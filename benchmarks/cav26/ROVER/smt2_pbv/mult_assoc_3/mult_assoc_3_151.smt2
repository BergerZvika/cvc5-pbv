(set-logic PBV)
(declare-const t Int)
(declare-const r Int)
(declare-const p Int)
(declare-const s Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (< t p))
(assert (= r s))
(assert (< q r))
(assert (= p q))
(assert (< p r))
(assert (distinct (pextract (pbvmul (pbvmul (pzero_extend (- r p) a) b) c) (- t 1) 0) (pextract (pbvmul a (pextract (pbvmul b c) (- q 1) 0)) (- t 1) 0)))
(check-sat)
