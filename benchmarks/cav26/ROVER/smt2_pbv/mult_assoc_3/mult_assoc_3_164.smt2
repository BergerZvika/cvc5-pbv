(set-logic PBV)
(declare-const s Int)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const u Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (<= (+ r s) q))
(assert (>= u t))
(assert (> r s))
(assert (< u r))
(assert (> r p))
(assert (> t p))
(assert (> t q))
(assert (= t u))
(assert (> u s))
(assert (< q r))
(assert (distinct (pbvmul (pextract (pbvmul (pzero_extend (- r p) a) b) (- u 1) 0) (pzero_extend (- u s) c)) (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) (pextract (pbvmul b (pzero_extend (- r s) c)) (- q 1) 0)))))
(check-sat)
