(set-logic PBV)
(declare-const p Int)
(declare-const u Int)
(declare-const q Int)
(declare-const r Int)
(declare-const t Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (>= u t))
(assert (> s r))
(assert (> u p))
(assert (< t u))
(assert (< t p))
(assert (> u s))
(assert (= p q))
(assert (> u r))
(assert (< q s))
(assert (distinct (pextract (pbvmul (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u r) b)) (pzero_extend (- u s) c)) (- t 1) 0) (pextract (pbvmul a (pextract (pbvmul (pzero_extend (- s r) b) c) (- q 1) 0)) (- t 1) 0)))
(check-sat)
