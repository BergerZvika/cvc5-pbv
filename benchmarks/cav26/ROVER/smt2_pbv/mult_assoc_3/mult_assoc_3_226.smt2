(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-const s Int)
(declare-const t Int)
(declare-const p Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (<= (+ r s) q))
(assert (>= u t))
(assert (= t u))
(assert (> q p))
(assert (= p r))
(assert (< u p))
(assert (> q s))
(assert (= u s))
(assert (> q r))
(assert (< t q))
(assert (distinct (pbvmul (pextract (pbvmul a b) (- u 1) 0) c) (pextract (pbvmul (pzero_extend (- q p) a) (pbvmul (pzero_extend (- q r) b) (pzero_extend (- q s) c))) (- t 1) 0)))
(check-sat)
