(set-logic PBV)
(declare-const s Int)
(declare-const q Int)
(declare-const t Int)
(declare-const p Int)
(declare-const r Int)
(declare-const u Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q t))
(assert (<= (+ p r) u))
(assert (> r s))
(assert (> t u))
(assert (> t s))
(assert (< t p))
(assert (= p r))
(assert (< u p))
(assert (< q r))
(assert (> p q))
(assert (distinct (pbvmul (pzero_extend (- t u) (pextract (pbvmul a b) (- u 1) 0)) (pzero_extend (- t s) c)) (pextract (pbvmul a (pzero_extend (- p q) (pextract (pbvmul b (pzero_extend (- r s) c)) (- q 1) 0))) (- t 1) 0)))
(check-sat)
