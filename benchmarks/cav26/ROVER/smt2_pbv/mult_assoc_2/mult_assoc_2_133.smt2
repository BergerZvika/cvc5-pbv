(set-logic PBV)
(declare-const r Int)
(declare-const s Int)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-const u Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= q t))
(assert (<= (+ p r) u))
(assert (< t p))
(assert (< p r))
(assert (> r s))
(assert (> p q))
(assert (< t u))
(assert (< q r))
(assert (> u s))
(assert (= u r))
(assert (distinct (pextract (pbvmul (pbvmul (pzero_extend (- r p) a) b) (pzero_extend (- u s) c)) (- t 1) 0) (pextract (pbvmul a (pzero_extend (- p q) (pextract (pbvmul b (pzero_extend (- r s) c)) (- q 1) 0))) (- t 1) 0)))
(check-sat)
