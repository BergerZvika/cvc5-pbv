(set-logic PBV)
(declare-const s Int)
(declare-const q Int)
(declare-const p Int)
(declare-const t Int)
(declare-const u Int)
(declare-const r Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q t))
(assert (<= (+ p r) u))
(assert (> q s))
(assert (> q r))
(assert (> t s))
(assert (> q p))
(assert (= u p))
(assert (> t u))
(assert (< t q))
(assert (= p r))
(assert (distinct (pbvmul (pzero_extend (- t u) (pbvmul a b)) (pzero_extend (- t s) c)) (pextract (pbvmul (pzero_extend (- q p) a) (pbvmul (pzero_extend (- q r) b) (pzero_extend (- q s) c))) (- t 1) 0)))
(check-sat)
