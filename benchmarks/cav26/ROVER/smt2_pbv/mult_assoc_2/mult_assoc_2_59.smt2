(set-logic PBV)
(declare-const q Int)
(declare-const s Int)
(declare-const u Int)
(declare-const p Int)
(declare-const r Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ p r) u))
(assert (> u s))
(assert (= p q))
(assert (> q r))
(assert (> p r))
(assert (= u p))
(assert (> q s))
(assert (distinct (pbvmul (pbvmul a (pzero_extend (- p r) b)) (pzero_extend (- u s) c)) (pbvmul a (pbvmul (pzero_extend (- q r) b) (pzero_extend (- q s) c)))))
(check-sat)
