(set-logic PBV)
(declare-const u Int)
(declare-const t Int)
(declare-const p Int)
(declare-const q Int)
(declare-const s Int)
(declare-const r Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= q t))
(assert (<= (+ p r) u))
(assert (= q r))
(assert (> u p))
(assert (> u r))
(assert (> u s))
(assert (< t q))
(assert (> q p))
(assert (= r s))
(assert (< t u))
(assert (distinct (pextract (pbvmul (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u r) b)) (pzero_extend (- u s) c)) (- t 1) 0) (pextract (pbvmul (pzero_extend (- q p) a) (pbvmul b c)) (- t 1) 0)))
(check-sat)
