(set-logic PBV)
(declare-const t Int)
(declare-const s Int)
(declare-const r Int)
(declare-const u Int)
(declare-const p Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (<= (+ p r) u))
(assert (> r s))
(assert (< t p))
(assert (< u p))
(assert (< t u))
(assert (> u s))
(assert (= p r))
(assert (distinct (pextract (pbvmul (pextract (pbvmul a b) (- u 1) 0) (pzero_extend (- u s) c)) (- t 1) 0) (pextract (pbvmul a (pbvmul b (pzero_extend (- r s) c))) (- t 1) 0)))
(check-sat)
