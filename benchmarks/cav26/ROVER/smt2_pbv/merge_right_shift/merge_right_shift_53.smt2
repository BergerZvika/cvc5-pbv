(set-logic PBV)
(declare-const s Int)
(declare-const q Int)
(declare-const p Int)
(declare-const r Int)
(declare-const t Int)
(declare-const u Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u p))
(assert (> t s))
(assert (> t q))
(assert (> t s))
(assert (> t q))
(assert (< u s))
(assert (< u q))
(assert (< r t))
(assert (= r s))
(assert (> q p))
(assert (> t p))
(assert (distinct (pbvlshr (pzero_extend (- s u) (pextract (pbvlshr (pzero_extend (- q p) a) b) (- u 1) 0)) c) (pextract (pbvlshr (pzero_extend (- t p) a) (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c))) (- r 1) 0)))
(check-sat)
