(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-const u Int)
(declare-const s Int)
(declare-const t Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= u p))
(assert (> t s))
(assert (> t q))
(assert (> r s))
(assert (< p t))
(assert (> u p))
(assert (= r t))
(assert (> t q))
(assert (> r u))
(assert (> t s))
(assert (> u q))
(assert (distinct (pbvlshr (pzero_extend (- r u) (pbvlshr (pzero_extend (- u p) a) (pzero_extend (- u q) b))) (pzero_extend (- r s) c)) (pbvlshr (pzero_extend (- t p) a) (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c)))))
(check-sat)
