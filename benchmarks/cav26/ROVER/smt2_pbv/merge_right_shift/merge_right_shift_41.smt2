(set-logic PBV)
(declare-const q Int)
(declare-const t Int)
(declare-const s Int)
(declare-const p Int)
(declare-const r Int)
(declare-const u Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= u p))
(assert (> t s))
(assert (> t q))
(assert (< p q))
(assert (> t p))
(assert (> t s))
(assert (> r s))
(assert (> t q))
(assert (> r u))
(assert (< r t))
(assert (= u q))
(assert (distinct (pbvlshr (pzero_extend (- r u) (pbvlshr (pzero_extend (- q p) a) b)) (pzero_extend (- r s) c)) (pextract (pbvlshr (pzero_extend (- t p) a) (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c))) (- r 1) 0)))
(check-sat)
