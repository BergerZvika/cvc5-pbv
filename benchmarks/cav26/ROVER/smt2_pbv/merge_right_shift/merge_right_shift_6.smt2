(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const r Int)
(declare-const t Int)
(declare-const u Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= u p))
(assert (> t s))
(assert (> t q))
(assert (< r t))
(assert (> t p))
(assert (> t q))
(assert (> t s))
(assert (= r u))
(assert (= u s))
(assert (> u p))
(assert (> u q))
(assert (distinct (pbvlshr (pbvlshr (pzero_extend (- u p) a) (pzero_extend (- u q) b)) c) (pextract (pbvlshr (pzero_extend (- t p) a) (pbvadd (pzero_extend (- t q) b) (pzero_extend (- t s) c))) (- r 1) 0)))
(check-sat)
