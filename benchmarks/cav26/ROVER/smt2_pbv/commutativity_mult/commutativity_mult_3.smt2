(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> q p))
(assert (< p q))
(assert (distinct (pbvmul (pzero_extend (- q p) a) b) (pbvmul b (pzero_extend (- q p) a))))
(check-sat)
