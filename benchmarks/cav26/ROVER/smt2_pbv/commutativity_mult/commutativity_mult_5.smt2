(set-logic PBV)
(declare-const r Int)
(declare-const q Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (= p q))
(assert (< r q))
(assert (< r p))
(assert (= q p))
(assert (distinct (pextract (pbvmul a b) (- r 1) 0) (pextract (pbvmul b a) (- r 1) 0)))
(check-sat)
