(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const t Int)
(declare-const q Int)
(declare-const u Int)
(declare-const s Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> q p))
(assert (< u s))
(assert (> r p))
(assert (< u r))
(assert (= q r))
(assert (= t s))
(assert (> r s))
(assert (< t q))
(assert (distinct (pbvmul (pzero_extend (- s u) (pextract (pbvmul (pzero_extend (- r p) a) b) (- u 1) 0)) c) (pextract (pbvmul (pzero_extend (- q p) a) (pbvmul b (pzero_extend (- r s) c))) (- t 1) 0)))
(check-sat)
