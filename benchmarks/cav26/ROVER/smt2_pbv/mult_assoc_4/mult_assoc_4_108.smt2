(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const u Int)
(declare-const s Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (< q r))
(assert (= u p))
(assert (> r s))
(assert (> p q))
(assert (> u s))
(assert (> p r))
(assert (distinct (pbvmul (pbvmul a (pzero_extend (- p r) b)) (pzero_extend (- u s) c)) (pbvmul a (pzero_extend (- p q) (pextract (pbvmul b (pzero_extend (- r s) c)) (- q 1) 0)))))
(check-sat)
