(set-logic PBV)
(declare-const t Int)
(declare-const q Int)
(declare-const s Int)
(declare-const p Int)
(declare-const u Int)
(declare-const r Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (= t q))
(assert (= u p))
(assert (> p r))
(assert (> t u))
(assert (> t s))
(assert (> q r))
(assert (< p q))
(assert (> q s))
(assert (distinct (pbvmul (pzero_extend (- t u) (pbvmul a (pzero_extend (- p r) b))) (pzero_extend (- t s) c)) (pbvmul (pzero_extend (- q p) a) (pbvmul (pzero_extend (- q r) b) (pzero_extend (- q s) c)))))
(check-sat)
