(set-logic PBV)
(declare-const u Int)
(declare-const q Int)
(declare-const r Int)
(declare-const s Int)
(declare-const t Int)
(declare-const p Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> s u))
(assert (> q p))
(assert (< t s))
(assert (< u r))
(assert (> r p))
(assert (< q r))
(assert (< t q))
(assert (= r s))
(assert (distinct (pextract (pbvmul (pzero_extend (- s u) (pextract (pbvmul (pzero_extend (- r p) a) b) (- u 1) 0)) c) (- t 1) 0) (pextract (pbvmul (pzero_extend (- q p) a) (pextract (pbvmul b c) (- q 1) 0)) (- t 1) 0)))
(check-sat)
