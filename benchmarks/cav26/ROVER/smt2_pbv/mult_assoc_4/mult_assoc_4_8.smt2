(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const s Int)
(declare-const q Int)
(declare-const u Int)
(declare-const t Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (< q r))
(assert (> t p))
(assert (> t q))
(assert (> t s))
(assert (> u p))
(assert (> r s))
(assert (> u r))
(assert (> t u))
(assert (distinct (pbvmul (pzero_extend (- t u) (pbvmul (pzero_extend (- u p) a) (pzero_extend (- u r) b))) (pzero_extend (- t s) c)) (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) (pextract (pbvmul b (pzero_extend (- r s) c)) (- q 1) 0)))))
(check-sat)
