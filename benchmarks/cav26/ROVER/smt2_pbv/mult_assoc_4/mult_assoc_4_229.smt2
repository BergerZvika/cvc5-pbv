(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-const s Int)
(declare-const t Int)
(declare-const u Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> r s))
(assert (> t u))
(assert (= p q))
(assert (> t s))
(assert (> r p))
(assert (< t p))
(assert (< q r))
(assert (< u r))
(assert (distinct (pbvmul (pzero_extend (- t u) (pextract (pbvmul (pzero_extend (- r p) a) b) (- u 1) 0)) (pzero_extend (- t s) c)) (pextract (pbvmul a (pextract (pbvmul b (pzero_extend (- r s) c)) (- q 1) 0)) (- t 1) 0)))
(check-sat)
