(set-logic PBV)
(declare-const q Int)
(declare-const t Int)
(declare-const u Int)
(declare-const p Int)
(declare-const r Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> p r))
(assert (< t p))
(assert (= p q))
(assert (= t u))
(assert (> u s))
(assert (< u p))
(assert (> q s))
(assert (> q r))
(assert (distinct (pbvmul (pextract (pbvmul a (pzero_extend (- p r) b)) (- u 1) 0) (pzero_extend (- u s) c)) (pextract (pbvmul a (pbvmul (pzero_extend (- q r) b) (pzero_extend (- q s) c))) (- t 1) 0)))
(check-sat)
