(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-const u Int)
(declare-const s Int)
(declare-const t Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (<= (+ r s) q))
(assert (<= (+ p r) u))
(assert (> t p))
(assert (> t q))
(assert (> q s))
(assert (> t u))
(assert (> t s))
(assert (< u r))
(assert (> r p))
(assert (> q r))
(assert (distinct (pbvmul (pzero_extend (- t u) (pextract (pbvmul (pzero_extend (- r p) a) b) (- u 1) 0)) (pzero_extend (- t s) c)) (pbvmul (pzero_extend (- t p) a) (pzero_extend (- t q) (pbvmul (pzero_extend (- q r) b) (pzero_extend (- q s) c))))))
(check-sat)
