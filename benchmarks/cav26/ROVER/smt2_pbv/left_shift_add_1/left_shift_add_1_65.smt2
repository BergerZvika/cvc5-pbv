(set-logic PBV)
(declare-const q Int)
(declare-const t Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (= p t))
(assert (> p q))
(assert (< q t))
(assert (distinct (pbvshl (pbvadd a (pzero_extend (- p q) b)) c) (pbvadd (pbvshl a c) (pbvshl (pzero_extend (- t q) b) c))))
(check-sat)
