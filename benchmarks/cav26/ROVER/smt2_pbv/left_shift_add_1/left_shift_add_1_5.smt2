(set-logic PBV)
(declare-const s Int)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= s r))
(assert (> s q))
(assert (< q t))
(assert (< p t))
(assert (> t s))
(assert (> s p))
(assert (< r t))
(assert (distinct (pextract (pbvshl (pzero_extend (- t s) (pbvadd (pzero_extend (- s p) a) (pzero_extend (- s q) b))) c) (- r 1) 0) (pextract (pbvadd (pbvshl (pzero_extend (- t p) a) c) (pbvshl (pzero_extend (- t q) b) c)) (- r 1) 0)))
(check-sat)
