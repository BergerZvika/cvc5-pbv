(set-logic PBV)
(declare-const q Int)
(declare-const u Int)
(declare-const s Int)
(declare-const t Int)
(declare-const r Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= u r))
(assert (>= s r))
(assert (< r s))
(assert (= r u))
(assert (> u p))
(assert (= u u))
(assert (> u t))
(assert (> q t))
(assert (> s t))
(assert (> s q))
(assert (< u q))
(assert (> s p))
(assert (distinct (pextract (pbvshl (pbvadd (pzero_extend (- s p) a) (pzero_extend (- s q) b)) (pzero_extend (- s t) c)) (- r 1) 0) (pbvadd (pbvshl (pzero_extend (- u p) a) (pzero_extend (- u t) c)) (pextract (pbvshl b (pzero_extend (- q t) c)) (- u 1) 0))))
(check-sat)
