(set-logic PBV)
(declare-const s Int)
(declare-const t Int)
(declare-const q Int)
(declare-const r Int)
(declare-const u Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u r))
(assert (>= s r))
(assert (< r t))
(assert (< u t))
(assert (< s p))
(assert (> t s))
(assert (> p q))
(assert (< u p))
(assert (= r u))
(assert (= u u))
(assert (> t q))
(assert (= p t))
(assert (distinct (pextract (pbvshl (pzero_extend (- t s) (pextract (pbvadd a (pzero_extend (- p q) b)) (- s 1) 0)) c) (- r 1) 0) (pbvadd (pextract (pbvshl a c) (- u 1) 0) (pextract (pbvshl (pzero_extend (- t q) b) c) (- u 1) 0))))
(check-sat)
