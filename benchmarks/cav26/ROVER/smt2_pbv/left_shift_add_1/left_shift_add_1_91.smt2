(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-const t Int)
(declare-const s Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> s t))
(assert (> q t))
(assert (> p t))
(assert (= s p))
(assert (= p q))
(assert (distinct (pbvshl (pbvadd a b) (pzero_extend (- s t) c)) (pbvadd (pbvshl a (pzero_extend (- p t) c)) (pbvshl b (pzero_extend (- q t) c)))))
(check-sat)
