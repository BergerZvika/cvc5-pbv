(set-logic PBV)
(declare-const r Int)
(declare-const q Int)
(declare-const s Int)
(declare-const u Int)
(declare-const p Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u r))
(assert (>= s r))
(assert (> u q))
(assert (> p q))
(assert (< r u))
(assert (= u u))
(assert (> u t))
(assert (> u p))
(assert (= s p))
(assert (= r s))
(assert (> s t))
(assert (distinct (pbvshl (pbvadd a (pzero_extend (- p q) b)) (pzero_extend (- s t) c)) (pextract (pbvadd (pbvshl (pzero_extend (- u p) a) (pzero_extend (- u t) c)) (pbvshl (pzero_extend (- u q) b) (pzero_extend (- u t) c))) (- r 1) 0)))
(check-sat)
