(set-logic PBV)
(declare-const t Int)
(declare-const s Int)
(declare-const r Int)
(declare-const q Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (>= s r))
(assert (= p t))
(assert (= q t))
(assert (> t s))
(assert (< s p))
(assert (= p q))
(assert (< r t))
(assert (distinct (pextract (pbvshl (pzero_extend (- t s) (pextract (pbvadd a b) (- s 1) 0)) c) (- r 1) 0) (pextract (pbvadd (pbvshl a c) (pbvshl b c)) (- r 1) 0)))
(check-sat)
