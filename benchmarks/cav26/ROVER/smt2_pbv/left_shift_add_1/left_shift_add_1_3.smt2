(set-logic PBV)
(declare-const t Int)
(declare-const s Int)
(declare-const p Int)
(declare-const q Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> s q))
(assert (= s t))
(assert (< q t))
(assert (< p t))
(assert (> s p))
(assert (distinct (pbvshl (pbvadd (pzero_extend (- s p) a) (pzero_extend (- s q) b)) c) (pbvadd (pbvshl (pzero_extend (- t p) a) c) (pbvshl (pzero_extend (- t q) b) c))))
(check-sat)
