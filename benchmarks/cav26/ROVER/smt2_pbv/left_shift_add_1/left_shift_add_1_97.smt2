(set-logic PBV)
(declare-const t Int)
(declare-const r Int)
(declare-const q Int)
(declare-const u Int)
(declare-const s Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u r))
(assert (>= s r))
(assert (> t q))
(assert (< u t))
(assert (> t p))
(assert (> t s))
(assert (= p q))
(assert (= u u))
(assert (= s p))
(assert (< r u))
(assert (< r t))
(assert (distinct (pextract (pbvshl (pzero_extend (- t s) (pbvadd a b)) c) (- r 1) 0) (pextract (pbvadd (pextract (pbvshl (pzero_extend (- t p) a) c) (- u 1) 0) (pextract (pbvshl (pzero_extend (- t q) b) c) (- u 1) 0)) (- r 1) 0)))
(check-sat)
