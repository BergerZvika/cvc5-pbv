(set-logic PBV)
(declare-const t Int)
(declare-const p Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (> p q))
(assert (= p t))
(assert (< q t))
(assert (distinct (pextract (pbvshl (pbvadd a (pzero_extend (- p q) b)) c) (- r 1) 0) (pextract (pbvadd (pbvshl a c) (pbvshl (pzero_extend (- t q) b) c)) (- r 1) 0)))
(check-sat)
