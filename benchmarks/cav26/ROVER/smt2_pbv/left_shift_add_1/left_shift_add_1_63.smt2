(set-logic PBV)
(declare-const t Int)
(declare-const p Int)
(declare-const s Int)
(declare-const q Int)
(declare-const u Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (= u u))
(assert (> p t))
(assert (> p q))
(assert (> u t))
(assert (> u q))
(assert (= s p))
(assert (> s t))
(assert (= u p))
(assert (distinct (pbvshl (pbvadd a (pzero_extend (- p q) b)) (pzero_extend (- s t) c)) (pbvadd (pbvshl a (pzero_extend (- p t) c)) (pbvshl (pzero_extend (- u q) b) (pzero_extend (- u t) c)))))
(check-sat)
