(set-logic PBV)
(declare-const q Int)
(declare-const t Int)
(declare-const s Int)
(declare-const p Int)
(declare-const u Int)
(declare-const r Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= u r))
(assert (>= s r))
(assert (= u u))
(assert (< r u))
(assert (= u q))
(assert (> u t))
(assert (< s q))
(assert (= s t))
(assert (> u p))
(assert (< r s))
(assert (> q t))
(assert (> q p))
(assert (distinct (pextract (pbvshl (pextract (pbvadd (pzero_extend (- q p) a) b) (- s 1) 0) c) (- r 1) 0) (pextract (pbvadd (pbvshl (pzero_extend (- u p) a) (pzero_extend (- u t) c)) (pbvshl b (pzero_extend (- q t) c))) (- r 1) 0)))
(check-sat)
