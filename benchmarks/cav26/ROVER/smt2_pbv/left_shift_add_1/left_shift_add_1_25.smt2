(set-logic PBV)
(declare-const q Int)
(declare-const r Int)
(declare-const s Int)
(declare-const p Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= s r))
(assert (> s q))
(assert (= p t))
(assert (< r s))
(assert (= q t))
(assert (> s t))
(assert (> s p))
(assert (distinct (pextract (pbvshl (pbvadd (pzero_extend (- s p) a) (pzero_extend (- s q) b)) (pzero_extend (- s t) c)) (- r 1) 0) (pextract (pbvadd (pbvshl a c) (pbvshl b c)) (- r 1) 0)))
(check-sat)
