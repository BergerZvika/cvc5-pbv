(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const t Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(assert (= q t))
(assert (< p t))
(assert (< p q))
(assert (distinct (pbvshl (pbvadd (pzero_extend (- q p) a) b) c) (pbvadd (pbvshl (pzero_extend (- t p) a) c) (pbvshl b c))))
(check-sat)
