(set-logic PBV)
(declare-const t Int)
(declare-const q Int)
(declare-const r Int)
(declare-const p Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (>= s r))
(assert (> q p))
(assert (< r t))
(assert (> t s))
(assert (< s q))
(assert (< p t))
(assert (= q t))
(assert (distinct (pextract (pbvshl (pzero_extend (- t s) (pextract (pbvadd (pzero_extend (- q p) a) b) (- s 1) 0)) c) (- r 1) 0) (pextract (pbvadd (pbvshl (pzero_extend (- t p) a) c) (pbvshl b c)) (- r 1) 0)))
(check-sat)
