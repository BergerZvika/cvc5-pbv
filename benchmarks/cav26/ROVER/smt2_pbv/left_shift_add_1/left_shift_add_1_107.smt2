(set-logic PBV)
(declare-const u Int)
(declare-const p Int)
(declare-const t Int)
(declare-const q Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (= s q))
(assert (= u u))
(assert (> q t))
(assert (= u q))
(assert (> u t))
(assert (< p q))
(assert (> s t))
(assert (> u p))
(assert (distinct (pbvshl (pbvadd (pzero_extend (- q p) a) b) (pzero_extend (- s t) c)) (pbvadd (pbvshl (pzero_extend (- u p) a) (pzero_extend (- u t) c)) (pbvshl b (pzero_extend (- q t) c)))))
(check-sat)
