(set-logic PBV)
(declare-const s Int)
(declare-const q Int)
(declare-const t Int)
(declare-const r Int)
(declare-const p Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) t))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= s r))
(assert (< p t))
(assert (> p q))
(assert (< q t))
(assert (< r t))
(assert (> t s))
(assert (= s p))
(assert (distinct (pextract (pbvshl (pzero_extend (- t s) (pbvadd a (pzero_extend (- p q) b))) c) (- r 1) 0) (pextract (pbvadd (pbvshl (pzero_extend (- t p) a) c) (pbvshl (pzero_extend (- t q) b) c)) (- r 1) 0)))
(check-sat)
