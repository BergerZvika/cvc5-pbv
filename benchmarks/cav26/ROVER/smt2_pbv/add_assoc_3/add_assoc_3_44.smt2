(set-logic PBV)
(declare-const r Int)
(declare-const u Int)
(declare-const q Int)
(declare-const p Int)
(declare-const s Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (>= q t))
(assert (< p u))
(assert (< r u))
(assert (> u p))
(assert (> q p))
(assert (> s r))
(assert (< t q))
(assert (> u s))
(assert (> u r))
(assert (< q s))
(assert (< t u))
(assert (distinct (pextract (pbvadd (pbvadd (pzero_extend (- u p) a) (pzero_extend (- u r) b)) (pzero_extend (- u s) c)) (- t 1) 0) (pextract (pbvadd (pzero_extend (- q p) a) (pextract (pbvadd (pzero_extend (- s r) b) c) (- q 1) 0)) (- t 1) 0)))
(check-sat)
