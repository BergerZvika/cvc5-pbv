(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-const s Int)
(declare-const r Int)
(declare-const t Int)
(declare-const u Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(assert (>= q t))
(assert (< p u))
(assert (< r u))
(assert (> s r))
(assert (< t p))
(assert (> u r))
(assert (> p q))
(assert (< t s))
(assert (> s u))
(assert (> u p))
(assert (< q s))
(assert (distinct (pextract (pbvadd (pzero_extend (- s u) (pbvadd (pzero_extend (- u p) a) (pzero_extend (- u r) b))) c) (- t 1) 0) (pextract (pbvadd a (pzero_extend (- p q) (pextract (pbvadd (pzero_extend (- s r) b) c) (- q 1) 0))) (- t 1) 0)))
(check-sat)
