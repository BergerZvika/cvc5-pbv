(set-logic PBV)
(declare-const q Int)
(declare-const t Int)
(declare-const u Int)
(declare-const p Int)
(declare-const s Int)
(declare-const r Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (>= q t))
(assert (< p u))
(assert (< r u))
(assert (> q s))
(assert (> u p))
(assert (< t q))
(assert (= t s))
(assert (> q r))
(assert (< u s))
(assert (> u r))
(assert (> q p))
(assert (distinct (pbvadd (pzero_extend (- s u) (pbvadd (pzero_extend (- u p) a) (pzero_extend (- u r) b))) c) (pextract (pbvadd (pzero_extend (- q p) a) (pbvadd (pzero_extend (- q r) b) (pzero_extend (- q s) c))) (- t 1) 0)))
(check-sat)
