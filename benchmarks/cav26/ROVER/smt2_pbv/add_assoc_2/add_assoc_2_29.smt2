(set-logic PBV)
(declare-const u Int)
(declare-const r Int)
(declare-const p Int)
(declare-const q Int)
(declare-const s Int)
(declare-const t Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (< r q))
(assert (< s q))
(assert (>= u t))
(assert (> q p))
(assert (> s u))
(assert (> q r))
(assert (> q s))
(assert (< t q))
(assert (< p r))
(assert (< t s))
(assert (= u r))
(assert (distinct (pextract (pbvadd (pzero_extend (- s u) (pbvadd (pzero_extend (- r p) a) b)) c) (- t 1) 0) (pextract (pbvadd (pzero_extend (- q p) a) (pbvadd (pzero_extend (- q r) b) (pzero_extend (- q s) c))) (- t 1) 0)))
(check-sat)
