(set-logic PBV)
(declare-const u Int)
(declare-const r Int)
(declare-const p Int)
(declare-const t Int)
(declare-const q Int)
(declare-const s Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) s))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) r))
(assert (< r q))
(assert (< s q))
(assert (>= u t))
(assert (= t u))
(assert (> p r))
(assert (< u p))
(assert (> u s))
(assert (> p q))
(assert (> q r))
(assert (< t p))
(assert (> q s))
(assert (distinct (pbvadd (pextract (pbvadd a (pzero_extend (- p r) b)) (- u 1) 0) (pzero_extend (- u s) c)) (pextract (pbvadd a (pzero_extend (- p q) (pbvadd (pzero_extend (- q r) b) (pzero_extend (- q s) c)))) (- t 1) 0)))
(check-sat)
