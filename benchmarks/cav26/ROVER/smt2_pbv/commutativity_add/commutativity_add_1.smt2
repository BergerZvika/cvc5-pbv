(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> p q))
(assert (< q p))
(assert (distinct (pbvadd a (pzero_extend (- p q) b)) (pbvadd (pzero_extend (- p q) b) a)))
(check-sat)
