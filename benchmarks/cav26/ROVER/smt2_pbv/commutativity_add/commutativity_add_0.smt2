(set-logic PBV)
(declare-const r Int)
(declare-const q Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> r q))
(assert (> r p))
(assert (distinct (pbvadd (pzero_extend (- r p) a) (pzero_extend (- r q) b)) (pbvadd (pzero_extend (- r q) b) (pzero_extend (- r p) a))))
(check-sat)
