(set-logic PBV)
(declare-const r Int)
(declare-const p Int)
(declare-const t Int)
(declare-const s Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> t p))
(assert (> t 1))
(assert (>= s (+ p q)))
(assert (< s q))
(assert (= t q))
(assert (< r t))
(assert (< r q))
(assert (> q p))
(assert (> q s))
(assert (> t p))
(assert (> t 1))
(assert (distinct (pextract (pbvadd (pzero_extend (- q s) (pextract (pbvmul (pzero_extend (- q p) a) b) (- s 1) 0)) b) (- r 1) 0) (pextract (pbvmul (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1))) b) (- r 1) 0)))
(check-sat)
