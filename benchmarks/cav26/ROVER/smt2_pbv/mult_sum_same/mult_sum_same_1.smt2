(set-logic PBV)
(declare-const s Int)
(declare-const p Int)
(declare-const r Int)
(declare-const q Int)
(declare-const t Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> t p))
(assert (> t 1))
(assert (>= s (+ p q)))
(assert (> s p))
(assert (= r t))
(assert (> r q))
(assert (> t q))
(assert (> r s))
(assert (> s q))
(assert (> t p))
(assert (> t 1))
(assert (distinct (pbvadd (pzero_extend (- r s) (pbvmul (pzero_extend (- s p) a) (pzero_extend (- s q) b))) (pzero_extend (- r q) b)) (pbvmul (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1))) (pzero_extend (- t q) b))))
(check-sat)
