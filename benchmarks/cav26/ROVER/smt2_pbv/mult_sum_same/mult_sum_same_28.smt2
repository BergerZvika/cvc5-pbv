(set-logic PBV)
(declare-const t Int)
(declare-const q Int)
(declare-const r Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) q))
(assert (> t p))
(assert (> t 1))
(assert (< r t))
(assert (< p q))
(assert (> t q))
(assert (> t p))
(assert (> t 1))
(assert (distinct (pbvadd (pbvmul (pzero_extend (- q p) a) b) b) (pextract (pbvmul (pbvadd (pzero_extend (- t p) a) (pzero_extend (- t 1) (int_to_pbv 1 1))) (pzero_extend (- t q) b)) (- r 1) 0)))
(check-sat)
