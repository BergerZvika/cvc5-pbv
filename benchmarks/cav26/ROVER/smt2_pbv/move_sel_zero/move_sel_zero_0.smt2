(set-logic PBV)
(declare-const p Int)
(declare-const r Int)
(declare-const q Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) 1))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) q))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (>= p 1))
(assert (>= q 1))
(assert (> r q))
(assert (> r p))
(assert (distinct (pbvmul (pzero_extend (- r p) (ite (= (pextract b 0 0) (int_to_pbv 1 1)) (int_to_pbv p 0) a)) (pzero_extend (- r q) c)) (pbvmul (pzero_extend (- r p) a) (pzero_extend (- r q) (ite (= (pextract b 0 0) (int_to_pbv 1 1)) (int_to_pbv q 0) c)))))
(check-sat)
