(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(declare-fun b () PBitVec)
(assert (= (pbvsize b) 1))
(declare-fun c () PBitVec)
(assert (= (pbvsize c) q))
(assert (>= p 1))
(assert (>= q 1))
(assert (< p q))
(assert (distinct (pbvmul (pzero_extend (- q p) (ite (= (pextract b 0 0) (int_to_pbv 1 1)) (int_to_pbv p 0) a)) c) (pbvmul (pzero_extend (- q p) a) (ite (= (pextract b 0 0) (int_to_pbv 1 1)) (int_to_pbv q 0) c))))
(check-sat)
