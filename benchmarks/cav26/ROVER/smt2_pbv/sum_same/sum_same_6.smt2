(set-logic PBV)
(declare-const p Int)
(declare-const q Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (< q p))
(assert (> p 2))
(assert (= p p))
(assert (distinct (pextract (pbvadd a a) (- q 1) 0) (pextract (pbvmul (pzero_extend (- p 2) (int_to_pbv 2 2)) a) (- q 1) 0)))
(check-sat)
