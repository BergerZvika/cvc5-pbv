(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (< q 2))
(assert (> q p))
(assert (> 2 p))
(assert (distinct (pbvadd (pzero_extend (- q p) a) (pzero_extend (- q p) a)) (pextract (pbvmul (int_to_pbv 2 2) (pzero_extend (- 2 p) a)) (- q 1) 0)))
(check-sat)
