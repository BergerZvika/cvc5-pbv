(set-logic PBV)
(declare-const q Int)
(declare-const p Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) p))
(assert (> q 2))
(assert (> q p))
(assert (distinct (pbvadd (pzero_extend (- q p) a) (pzero_extend (- q p) a)) (pbvmul (pzero_extend (- q 2) (int_to_pbv 2 2)) (pzero_extend (- q p) a))))
(check-sat)
