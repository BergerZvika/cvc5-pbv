(set-logic PBV)
(declare-const k Int)
(declare-const m Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) m))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) m))
(assert (> m k))
(assert (let ((_let_0 (pbvshl %X C1))) (let ((_let_1 (pzero_extend (- m k) C2))) (and (pbvult C1 (int_to_pbv m m)) (pbvult C2 (int_to_pbv k k)) (not (= (pbvshl (pextract _let_0 (- k 1) 0) C2) (pextract (pbvand (pbvshl _let_0 _let_1) (pbvshl (pbvsub (pbvshl (int_to_pbv m 1) (int_to_pbv m k)) (int_to_pbv m 1)) _let_1)) (- k 1) 0)))))))
(check-sat)
