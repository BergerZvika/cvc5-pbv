(set-logic PBV)
(declare-const k Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %B () PBitVec)
(assert (= (pbvsize %B) k))
(declare-fun %A () PBitVec)
(assert (= (pbvsize %A) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(assert (let ((_let_0 (pbvadd C2 (int_to_pbv k 1)))) (and (= (pbvand _let_0 (pbvsub _let_0 (int_to_pbv k 1))) (int_to_pbv k 0)) (= (pbvand C1 C2) (int_to_pbv k 0)) (not (= (pbvand (pbvadd (pbvor %A C1) %B) C2) (pbvand (pbvadd %A %B) C2))))))
(check-sat)
