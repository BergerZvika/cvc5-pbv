(set-logic PBV)
(declare-const k Int)
(declare-fun C () PBitVec)
(assert (= (pbvsize C) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (and (pbvult C (int_to_pbv k k)) (not (= (pbvlshr (pbvxor %X C2) C) (pbvxor (pbvlshr %X C) (pbvlshr C2 C))))))
(check-sat)
