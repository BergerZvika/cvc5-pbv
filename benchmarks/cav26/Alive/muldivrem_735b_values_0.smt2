(set-logic PBV)
(declare-const k Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (and (= (pextract (pbvmul (pzero_extend k C1) (pzero_extend k C2)) (- (* 2 k) 1) k) (int_to_pbv k 0)) (not (= C1 (int_to_pbv k 0))) (not (= C2 (int_to_pbv k 0))) (not (= (pbvudiv (pbvudiv %X C1) C2) (pbvudiv %X (pbvmul C1 C2))))))
(check-sat)
