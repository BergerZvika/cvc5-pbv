(set-logic PBV)
(declare-const k Int)
(declare-fun C3 () PBitVec)
(assert (= (pbvsize C3) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %x () PBitVec)
(assert (= (pbvsize %x) k))
(assert (and (pbvult C2 (int_to_pbv k k)) (not (= (pbvxor (pbvlshr (pbvxor %x C1) C2) C3) (pbvxor (pbvlshr %x C2) (pbvxor (pbvlshr C1 C2) C3))))))
(check-sat)
