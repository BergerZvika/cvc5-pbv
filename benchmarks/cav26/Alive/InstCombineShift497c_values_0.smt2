(set-logic PBV)
(declare-const k Int)
(declare-fun C () PBitVec)
(assert (= (pbvsize C) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (and (pbvult C (int_to_pbv k k)) (= (pbvlshr C2 (pbvsub (int_to_pbv k k) (int_to_pbv k 1))) (int_to_pbv k 1)) (not (= (pbvashr (pbvand %X C2) C) (pbvand (pbvashr %X C) (pbvashr C2 C))))))
(check-sat)
