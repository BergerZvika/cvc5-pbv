(set-logic PBV)
(declare-const k Int)
(declare-fun %b () PBitVec)
(assert (= (pbvsize %b) k))
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(assert (not (= (pbvxor (pbvor %a (pbvxor %b (pbvnot (int_to_pbv k 0)))) (pbvor (pbvxor %a (pbvnot (int_to_pbv k 0))) %b)) (pbvxor %a %b))))
(check-sat)
