(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %Z () PBitVec)
(assert (= (pbvsize %Z) k))
(declare-fun %RHS () PBitVec)
(assert (= (pbvsize %RHS) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(assert (and (= C2 (pbvnot C1)) (not (= (pbvadd (pbvadd (pbvxor (pbvor %Z C2) C1) (int_to_pbv k 1)) %RHS) (pbvsub %RHS (pbvand %Z C1))))))
(check-sat)
