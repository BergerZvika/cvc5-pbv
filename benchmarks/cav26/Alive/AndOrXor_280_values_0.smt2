(set-logic PBV)
(declare-const k Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (let ((_let_0 (pbvneg C1))) (and (pbvsle C1 C2) (not (= (and (pbvsge %X C1) (pbvslt %X C2)) (pbvult (pbvadd %X _let_0) (pbvadd _let_0 C2)))))))
(check-sat)
