(set-logic PBV)
(declare-const k Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(assert (let ((_let_0 (pbvslt %X C2))) (and (pbvsle C1 C2) (= C1 (pbvshl (int_to_pbv k 1) (pbvsub (int_to_pbv k k) (int_to_pbv k 1)))) (not (= (and (pbvsge %X C1) _let_0) _let_0)))))
(check-sat)
