(set-logic PBV)
(declare-const k Int)
(declare-fun C () PBitVec)
(assert (= (pbvsize C) k))
(declare-fun %b () PBitVec)
(assert (= (pbvsize %b) k))
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(assert (and (= (pbvand C (pbvsub C (int_to_pbv k 1))) (int_to_pbv k 0)) (not (= (and (pbvult %a C) (pbvult %b C)) (pbvult (pbvor %a %b) C))) (not (= C (int_to_pbv k 0)))))
(check-sat)
