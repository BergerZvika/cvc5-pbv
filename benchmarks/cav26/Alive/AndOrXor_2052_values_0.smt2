(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C () PBitVec)
(assert (= (pbvsize C) k))
(declare-fun %x () PBitVec)
(assert (= (pbvsize %x) k))
(assert (and (not (= (pbvand C C1) (int_to_pbv k 0))) (not (= (pbvor (pbvand %x C1) C) (pbvand (pbvor %x C) (pbvor C C1))))))
(check-sat)
