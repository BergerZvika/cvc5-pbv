(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (let ((_let_0 (pbvlshr %X C1))) (let ((_let_1 (pbvlshr (pbvnot (int_to_pbv k 0)) C1))) (let ((_let_2 (pbvand C2 _let_1))) (and (pbvult C1 (int_to_pbv k k)) (not (= _let_2 _let_1)) (not (= (pbvand _let_0 C2) (pbvand _let_0 _let_2))))))))
(check-sat)
