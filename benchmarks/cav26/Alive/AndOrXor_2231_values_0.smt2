(set-logic PBV)
(declare-const k Int)
(declare-fun %C () PBitVec)
(assert (= (pbvsize %C) k))
(declare-fun %B () PBitVec)
(assert (= (pbvsize %B) k))
(declare-fun %A () PBitVec)
(assert (= (pbvsize %A) k))
(assert (let ((_let_0 (pbvxor %A %B))) (not (= (pbvor _let_0 (pbvxor (pbvxor %B %C) %A)) (pbvor _let_0 %C)))))
(check-sat)
