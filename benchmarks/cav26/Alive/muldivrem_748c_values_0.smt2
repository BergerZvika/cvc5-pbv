(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (and (= (pextract (pbvmul (pzero_extend k %X) (pzero_extend k C1)) (- (* 2 k) 1) k) (int_to_pbv k 0)) (= (pbvurem C2 C1) (int_to_pbv k 0)) (not (= C2 (int_to_pbv k 0))) (not (= (pbvudiv (pbvmul %X C1) C2) (pbvudiv %X (pbvudiv C2 C1))))))
(check-sat)
