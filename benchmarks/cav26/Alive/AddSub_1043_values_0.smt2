(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %Z () PBitVec)
(assert (= (pbvsize %Z) k))
(declare-fun %RHS () PBitVec)
(assert (= (pbvsize %RHS) k))
(assert (not (= (pbvadd (pbvadd (pbvxor (pbvand %Z C1) C1) (int_to_pbv k 1)) %RHS) (pbvsub %RHS (pbvor %Z (pbvnot C1))))))
(check-sat)
