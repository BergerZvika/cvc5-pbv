(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (let ((_let_0 (pbvxor C1 C2))) (and (pbvult C1 C2) (= (pbvand _let_0 (pbvsub _let_0 (int_to_pbv k 1))) (int_to_pbv k 0)) (not (= (or (= %X C1) (= %X C2)) (= (pbvand %X (pbvnot _let_0)) C1))) (not (= _let_0 (int_to_pbv k 0))))))
(check-sat)
