(set-logic PBV)
(declare-const k Int)
(declare-fun %d () PBitVec)
(assert (= (pbvsize %d) k))
(declare-fun %b () PBitVec)
(assert (= (pbvsize %b) k))
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(assert (not (= (and (= (pbvand %a %b) (int_to_pbv k 0)) (= (pbvand %a %d) (int_to_pbv k 0))) (= (pbvand %a (pbvor %b %d)) (int_to_pbv k 0)))))
(check-sat)
