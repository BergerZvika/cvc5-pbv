(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(assert (and (= C1 C2) (= (pbvand C1 (pbvsub C1 (int_to_pbv k 1))) (int_to_pbv k 0)) (not (= (ite (= (pbvand %X C1) (int_to_pbv k 0)) %X (pbvxor %X C2)) (pbvand %X (pbvnot C1)))) (not (= C1 (int_to_pbv k 0)))))
(check-sat)
