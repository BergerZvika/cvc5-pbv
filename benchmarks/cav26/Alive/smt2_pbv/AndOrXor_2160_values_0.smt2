(set-logic PBV)
(declare-const k Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C4 () PBitVec)
(assert (= (pbvsize C4) k))
(declare-fun C3 () PBitVec)
(assert (= (pbvsize C3) k))
(declare-fun %V1 () PBitVec)
(assert (= (pbvsize %V1) k))
(assert (and (= (pbvand C1 C2) (int_to_pbv k 0)) (= (pbvand C3 (pbvnot C1)) (int_to_pbv k 0)) (= (pbvand C4 (pbvnot C2)) (int_to_pbv k 0)) (not (= (pbvor (pbvand (pbvor %V1 C3) C1) (pbvand (pbvor %V1 C4) C2)) (pbvand (pbvor %V1 (pbvor C3 C4)) (pbvor C1 C2))))))
(check-sat)
