(set-logic PBV)
(declare-const k Int)
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C () PBitVec)
(assert (= (pbvsize C) k))
(assert (and (= C2 (pbvadd C (int_to_pbv k 1))) (not (= C (pbvsub (pbvshl (int_to_pbv k 1) (pbvsub (int_to_pbv k k) (int_to_pbv k 1))) (int_to_pbv k 1)))) (not (= (ite (pbvsgt %X C) %X C2) (ite (pbvslt %X C2) C2 %X)))))
(check-sat)
