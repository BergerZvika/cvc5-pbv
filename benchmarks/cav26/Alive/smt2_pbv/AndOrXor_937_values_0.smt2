(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(assert (and (pbvslt C1 C2) (= C1 (pbvsub C2 (int_to_pbv k 1))) (not (= (and (not (= %a C1)) (pbvslt %a C2)) (pbvslt %a C1)))))
(check-sat)
