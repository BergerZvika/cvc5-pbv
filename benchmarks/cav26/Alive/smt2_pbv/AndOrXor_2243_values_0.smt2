(set-logic PBV)
(declare-const k Int)
(declare-fun %C () PBitVec)
(assert (= (pbvsize %C) k))
(declare-fun %A () PBitVec)
(assert (= (pbvsize %A) k))
(declare-fun %B () PBitVec)
(assert (= (pbvsize %B) k))
(assert (not (= (pbvor (pbvand (pbvor %B %C) %A) %B) (pbvor %B (pbvand %A %C)))))
(check-sat)
