(set-logic PBV)
(declare-const k Int)
(declare-fun C () PBitVec)
(assert (= (pbvsize C) k))
(declare-fun %Y () PBitVec)
(assert (= (pbvsize %Y) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (and (pbvult C (int_to_pbv k k)) (not (= (pbvshl (pbvxor %Y (pbvand (pbvlshr %X C) C2)) C) (pbvxor (pbvand %X (pbvshl C2 C)) (pbvshl %Y C))))))
(check-sat)
