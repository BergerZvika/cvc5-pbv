(set-logic PBV)
(declare-const k Int)
(declare-const m Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (> m k))
(assert (and (pbvult C1 (int_to_pbv k k)) (pbvult C2 (int_to_pbv k k)) (pbvsge (pzero_extend (- m k) (pbvadd C1 C2)) (int_to_pbv m k)) (not (= (pbvshl (pbvshl %X C1) C2) (int_to_pbv k 0)))))
(check-sat)
