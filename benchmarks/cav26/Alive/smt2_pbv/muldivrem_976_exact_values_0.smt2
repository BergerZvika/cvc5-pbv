(set-logic PBV)
(declare-const k Int)
(declare-const m Int)
(declare-fun %Y () PBitVec)
(assert (= (pbvsize %Y) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (> m k))
(assert (let ((_let_0 (pzero_extend (- m k) %Y))) (let ((_let_1 (pzero_extend (- m k) %X))) (let ((_let_2 (pbvudiv _let_1 _let_0))) (and (= (pbvmul _let_2 _let_0) _let_1) (not (= _let_0 (int_to_pbv m 0))) (not (= _let_2 (pzero_extend (- m k) (pbvudiv %X %Y)))))))))
(check-sat)
