(set-logic PBV)
(declare-const k Int)
(declare-fun %B () PBitVec)
(assert (= (pbvsize %B) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %A () PBitVec)
(assert (= (pbvsize %A) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(assert (and (= (pbvxor C1 C2) (pbvnot (int_to_pbv k 0))) (not (= (pbvor (pbvand (pbvor %A %B) C1) (pbvand %B C2)) (pbvor (pbvand %A C1) %B)))))
(check-sat)
