(set-logic PBV)
(declare-const k Int)
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(assert (and (= C1 (pbvnot C2)) (= (pbvand C1 (pbvsub C1 (int_to_pbv k 1))) (int_to_pbv k 0)) (not (= (ite (= (pbvand %X C1) (int_to_pbv k 0)) (pbvand %X C2) %X) %X)) (not (= C1 (int_to_pbv k 0)))))
(check-sat)
