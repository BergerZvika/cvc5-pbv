(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(assert (let ((_let_0 (pbvult %a C1))) (and (pbvult C1 C2) (not (= (and _let_0 (not (= %a C2))) _let_0)))))
(check-sat)
