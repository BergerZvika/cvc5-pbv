(set-logic PBV)
(declare-const k Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(assert (let ((_let_0 (pbvugt %a C2))) (and (pbvult C1 C2) (not (= (and (pbvugt %a C1) _let_0) _let_0)))))
(check-sat)
