(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C3 () PBitVec)
(assert (= (pbvsize C3) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(assert (let ((_let_0 (pbvadd %X C3))) (and (= (pbvadd C2 C3) C1) (not (= (or (pbvult _let_0 C1) (= %X C2)) (pbvule _let_0 C1))))))
(check-sat)
