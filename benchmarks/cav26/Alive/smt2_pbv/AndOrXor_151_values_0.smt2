(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (let ((_let_0 (pbvand C1 C2))) (and (= _let_0 C1) (not (= (pbvand (pbvor %X C1) C2) (pbvor (pbvand %X (pbvxor C2 _let_0)) C1))))))
(check-sat)
