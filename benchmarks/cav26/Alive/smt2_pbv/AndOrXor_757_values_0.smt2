(set-logic PBV)
(declare-const k Int)
(declare-fun C4 () PBitVec)
(assert (= (pbvsize C4) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C3 () PBitVec)
(assert (= (pbvsize C3) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(assert (and (= (pbvand (pbvand C1 C3) (pbvxor C2 C4)) (int_to_pbv k 0)) (= (pbvand C1 C2) C2) (= (pbvand C3 C4) C4) (not (= (and (= (pbvand %a C1) C2) (= (pbvand %a C3) C4)) (= (pbvand %a (pbvor C1 C3)) (pbvor C2 C4))))))
(check-sat)
