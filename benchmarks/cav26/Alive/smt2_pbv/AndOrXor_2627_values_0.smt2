(set-logic PBV)
(declare-const k Int)
(declare-fun %c () PBitVec)
(assert (= (pbvsize %c) k))
(declare-fun %b () PBitVec)
(assert (= (pbvsize %b) k))
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(assert (not (= (pbvxor (pbvxor %a %c) (pbvor %a %b)) (pbvxor (pbvand (pbvxor %a (pbvnot (int_to_pbv k 0))) %b) %c))))
(check-sat)
