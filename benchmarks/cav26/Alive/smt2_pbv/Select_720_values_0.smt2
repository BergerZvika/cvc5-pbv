(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %A () PBitVec)
(assert (= (pbvsize %A) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(assert (let ((_let_0 (ite (pbvuge %A C1) %A C1))) (and (pbvugt C1 C2) (not (= (ite (pbvuge _let_0 C2) _let_0 C2) _let_0)))))
(check-sat)
