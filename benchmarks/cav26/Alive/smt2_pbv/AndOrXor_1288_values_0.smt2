(set-logic PBV)
(declare-const k Int)
(declare-fun %C () PBitVec)
(assert (= (pbvsize %C) k))
(declare-fun %B () PBitVec)
(assert (= (pbvsize %B) k))
(declare-fun %A () PBitVec)
(assert (= (pbvsize %A) k))
(assert (let ((_let_0 (pbvxor %A %B))) (not (= (pbvand _let_0 (pbvxor (pbvxor %B %C) %A)) (pbvand _let_0 (pbvxor %C (pbvnot (int_to_pbv k 0))))))))
(check-sat)
