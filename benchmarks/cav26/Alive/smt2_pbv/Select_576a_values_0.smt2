(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (not (= (ite (pbvslt %X (int_to_pbv k 0)) C2 C1) (pbvadd (pbvand (pbvashr %X (pbvsub (int_to_pbv k k) (int_to_pbv k 1))) (pbvsub C2 C1)) C1))))
(check-sat)
