(set-logic PBV)
(declare-const k Int)
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(declare-fun %d () PBitVec)
(assert (= (pbvsize %d) k))
(declare-fun %b () PBitVec)
(assert (= (pbvsize %b) k))
(assert (not (= (and (= (pbvand %a %b) %a) (= (pbvand %a %d) %a)) (= (pbvand %a (pbvand %b %d)) %a))))
(check-sat)
