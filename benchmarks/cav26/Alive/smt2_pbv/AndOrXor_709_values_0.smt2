(set-logic PBV)
(declare-const k Int)
(declare-fun %d () PBitVec)
(assert (= (pbvsize %d) k))
(declare-fun %b () PBitVec)
(assert (= (pbvsize %b) k))
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(assert (let ((_let_0 (pbvor %b %d))) (not (= (and (= (pbvand %a %b) %b) (= (pbvand %a %d) %d)) (= (pbvand %a _let_0) _let_0)))))
(check-sat)
