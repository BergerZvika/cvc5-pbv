(set-logic PBV)
(declare-const k Int)
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(assert (let ((_let_0 (not (= (pbvand %a C1) %a)))) (and (= (pbvor C1 C2) C1) (not (= (and _let_0 (not (= (pbvand %a C2) %a))) _let_0)))))
(check-sat)
