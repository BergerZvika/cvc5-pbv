(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(assert (let ((_let_0 (pbvsgt %X C1))) (and (pbvslt C1 C2) (not (= (or _let_0 (= %X C2)) _let_0)))))
(check-sat)
