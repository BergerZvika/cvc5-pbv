(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (let ((_let_0 (pbvshl %X C1))) (let ((_let_1 (pbvand C2 (pbvshl (pbvnot (int_to_pbv k 0)) C1)))) (and (pbvult C1 (int_to_pbv k k)) (not (= _let_1 (pbvshl (pbvnot (int_to_pbv k 0)) C1))) (not (= _let_1 C2)) (not (= (pbvand _let_0 C2) (pbvand _let_0 _let_1)))))))
(check-sat)
