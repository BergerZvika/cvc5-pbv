(set-logic PBV)
(declare-const k Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun %a () PBitVec)
(assert (= (pbvsize %a) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(assert (and (pbvult C1 C2) (= C2 (pbvadd C1 (int_to_pbv k 1))) (not (= (and (pbvugt %a C1) (not (= %a C2))) (pbvugt %a C2)))))
(check-sat)
