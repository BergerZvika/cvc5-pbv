(set-logic PBV)
(declare-const k Int)
(declare-const m Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) m))
(declare-fun %x () PBitVec)
(assert (= (pbvsize %x) m))
(assert (> m k))
(assert (not (= (pbvand (pextract (pbvand %x C1) (- k 1) 0) C2) (pbvand (pextract %x (- k 1) 0) (pbvand (pextract C1 (- k 1) 0) C2)))))
(check-sat)
