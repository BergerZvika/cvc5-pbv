(set-logic PBV)
(declare-const k Int)
(declare-fun %y () PBitVec)
(assert (= (pbvsize %y) k))
(declare-fun %x () PBitVec)
(assert (= (pbvsize %x) k))
(assert (not (= (pbvxor (pbvand %x %y) (pbvnot (int_to_pbv k 0))) (pbvor (pbvxor %x (pbvnot (int_to_pbv k 0))) (pbvxor %y (pbvnot (int_to_pbv k 0)))))))
(check-sat)
