(set-logic PBV)
(declare-const k Int)
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (not (= (pbvand (pbvor %X C1) C2) (pbvand (pbvor %X (pbvand C1 C2)) C2))))
(check-sat)
