(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(declare-fun C2 () PBitVec)
(assert (= (pbvsize C2) k))
(assert (let ((_let_0 (pbvult %X C1))) (and (pbvult C1 C2) (= C2 (pbvnot (int_to_pbv k 0))) (not (= (or _let_0 (pbvugt %X C2)) _let_0)))))
(check-sat)
