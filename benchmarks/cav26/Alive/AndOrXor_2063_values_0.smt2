(set-logic PBV)
(declare-const k Int)
(declare-fun C () PBitVec)
(assert (= (pbvsize C) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %x () PBitVec)
(assert (= (pbvsize %x) k))
(assert (not (= (pbvor (pbvxor %x C1) C) (pbvxor (pbvor %x C) (pbvand C1 (pbvnot C))))))
(check-sat)
