(set-logic PBV)
(declare-const k Int)
(declare-fun %Op1 () PBitVec)
(assert (= (pbvsize %Op1) k))
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun %X () PBitVec)
(assert (= (pbvsize %X) k))
(assert (not (= (pbvmul (pbvadd %X C1) %Op1) (pbvadd (pbvmul %X %Op1) (pbvmul C1 %Op1)))))
(check-sat)
