(set-logic PBV)
(declare-const k Int)
(declare-fun C1 () PBitVec)
(assert (= (pbvsize C1) k))
(declare-fun C () PBitVec)
(assert (= (pbvsize C) k))
(declare-fun %x () PBitVec)
(assert (= (pbvsize %x) k))
(assert (and (= C1 (pbvshl (int_to_pbv k 1) (pbvsub (int_to_pbv k k) (int_to_pbv k 1)))) (not (= (pbvxor (pbvadd %x C) C1) (pbvadd %x (pbvadd C C1))))))
(check-sat)
