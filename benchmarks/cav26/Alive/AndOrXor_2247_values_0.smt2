(set-logic PBV)
(declare-const k Int)
(declare-fun %B () PBitVec)
(assert (= (pbvsize %B) k))
(declare-fun %A () PBitVec)
(assert (= (pbvsize %A) k))
(assert (not (= (pbvor (pbvxor %A (pbvnot (int_to_pbv k 0))) (pbvxor %B (pbvnot (int_to_pbv k 0)))) (pbvxor (pbvand %A %B) (pbvnot (int_to_pbv k 0))))))
(check-sat)
