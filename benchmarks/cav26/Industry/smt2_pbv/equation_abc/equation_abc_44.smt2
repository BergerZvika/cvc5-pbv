(set-logic PBV)
(declare-const w1 Int)
(declare-const w4 Int)
(declare-const w9 Int)
(declare-const w3 Int)
(declare-const w7 Int)
(declare-const w8 Int)
(declare-fun c () PBitVec)
(assert (= (pbvsize c) w3))
(declare-fun ct () PBitVec)
(assert (= (pbvsize ct) w4))
(declare-fun d () PBitVec)
(assert (= (pbvsize d) w7))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) w1))
(assert (> w8 w1))
(assert (> w8 w4))
(assert (> w9 w4))
(assert (< w7 w3))
(assert (> w1 w7))
(assert (= w7 w7))
(assert (= w8 w8))
(assert (> w9 w4))
(assert (< w7 w8))
(assert (> w8 w1))
(assert (> w8 w4))
(assert (< w7 w1))
(assert (= w9 w9))
(assert (< w7 w9))
(assert (= w3 w3))
(assert (distinct (pbvadd (pbvmul (pextract (pbvsub (pzero_extend (- w8 w4) ct) (pzero_extend (- w8 w1) a)) (- w7 1) 0) (pextract c (- w7 1) 0)) (pextract (pbvmul a (pzero_extend (- w1 w7) d)) (- w7 1) 0)) (pbvadd (pbvmul (pextract c (- w7 1) 0) (pextract (pzero_extend (- w9 w4) ct) (- w7 1) 0)) (pextract (pbvmul a (pzero_extend (- w1 w7) (pbvsub d (pextract c (- w7 1) 0)))) (- w7 1) 0))))
(check-sat)
