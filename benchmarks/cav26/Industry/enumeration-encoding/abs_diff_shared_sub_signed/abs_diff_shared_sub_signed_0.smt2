(set-logic PBV)
(declare-const w Int)
(declare-fun b () PBitVec)
(assert (= (pbvsize b) w))
(declare-fun a () PBitVec)
(assert (= (pbvsize a) w))
(declare-fun s () PBitVec)
(assert (= (pbvsize s) 1))
(assert (= w w))
(assert (distinct (ite (= (pextract s 0 0) (int_to_pbv 1 1)) (pbvsub a b) (pbvsub b a)) (pbvsub (ite (= (pextract s 0 0) (int_to_pbv 1 1)) a b) (ite (= (pextract s 0 0) (int_to_pbv 1 1)) b a))))
(check-sat)
