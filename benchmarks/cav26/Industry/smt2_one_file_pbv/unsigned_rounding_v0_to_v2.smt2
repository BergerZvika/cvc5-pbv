(set-logic PBV)
(declare-const w2 Int)
(declare-fun a () PBitVec)
(assert (= (pbvsize a) (+ w2 1)))
(assert (> w2 1))
(assert (>= (- (+ w2 1) w2) 1))
(assert (< 1 (+ w2 1)))
(assert (> (+ w2 1) 1))
(assert (< w2 (+ w2 1)))
(assert (= w2 w2))
(assert (= (+ w2 1) (+ w2 1)))
(assert (> w2 1))
(assert (distinct (pbvadd (pextract (pbvlshr a (pzero_extend (- (+ w2 1) 1) (int_to_pbv 1 1))) (- w2 1) 0) (pzero_extend (- w2 1) (pextract a (- 1 1) 0))) (pextract (pbvlshr (pbvadd a (pzero_extend (- (+ w2 1) 1) (int_to_pbv 1 1))) (pzero_extend (- (+ w2 1) 1) (int_to_pbv 1 1))) (- w2 1) 0)))
(check-sat)
