; and_sext_multiuse_thm (distributive law)
; ∀ (c : BitVec 1) (x y : BitVec wt) (wt : Int), 1 < wt →
;   signExtend wt c &&& x + signExtend wt c &&& y
;   = signExtend wt c &&& (x + y)
; (sext(c) for c:BitVec 1 is either 0 or -1, both distribute over +)
(set-logic PBV)
(declare-const wt Int)
(declare-const c PBitVec)
(assert (= (pbvsize c) 1))
(declare-const x PBitVec)
(assert (= (pbvsize x) wt))
(declare-const y PBitVec)
(assert (= (pbvsize y) wt))
(assert (< 1 wt))
(assert (not (= (pbvadd (pbvand (psign_extend (- wt 1) c) x) (pbvand (psign_extend (- wt 1) c) y)) (pbvand (psign_extend (- wt 1) c) (pbvadd x y)))))
(check-sat)
