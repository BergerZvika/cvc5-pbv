; test27_thm (generalized)
; ∀ (x1 x2 x : BitVec w) (wt : Int), w < wt →
;   zeroExtend wt (ofBool (x2 ^^^ x1 == x2 ^^^ x)) = zeroExtend wt (ofBool (x1 == x))
; (x2^^^x1 = x2^^^x ↔ x1 = x, by XOR cancellation)
(set-logic PBV)
(declare-const w Int)
(declare-const wt Int)
(declare-const x1 PBitVec)
(assert (= (pbvsize x1) w))
(declare-const x2 PBitVec)
(assert (= (pbvsize x2) w))
(declare-const x PBitVec)
(assert (= (pbvsize x) w))
(assert (< w wt))
(assert (not (= (pzero_extend (- wt 1) (ite (= (pbvxor x2 x1) (pbvxor x2 x)) (int_to_pbv 1 1) (int_to_pbv 1 0))) (pzero_extend (- wt 1) (ite (= x1 x) (int_to_pbv 1 1) (int_to_pbv 1 0))))))
(check-sat)
