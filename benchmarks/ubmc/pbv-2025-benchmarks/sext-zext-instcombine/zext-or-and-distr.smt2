; ∀ (x y z : BitVec wa) (wt : Int), wa < wt →
;   zeroExtend wt (x ||| (y &&& z)) = zeroExtend wt x ||| (zeroExtend wt y &&& zeroExtend wt z)
(set-logic PBV)
(declare-const wa Int)
(declare-const wt Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) wa))
(declare-const y PBitVec)
(assert (= (pbvsize y) wa))
(declare-const z PBitVec)
(assert (= (pbvsize z) wa))
(assert (< wa wt))
(assert (not (= (pzero_extend (- wt wa) (pbvor x (pbvand y z))) (pbvor (pzero_extend (- wt wa) x) (pbvand (pzero_extend (- wt wa) y) (pzero_extend (- wt wa) z))))))
(check-sat)
