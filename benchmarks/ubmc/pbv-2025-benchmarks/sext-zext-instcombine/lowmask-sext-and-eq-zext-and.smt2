; ∀ (x : BitVec wa) (y : BitVec wt), wa < wt →
;   (signExtend wt x &&& y) &&& lowmask(wa,wt) = (zeroExtend wt x &&& y) &&& lowmask(wa,wt)
(set-logic PBV)
(declare-const wa Int)
(declare-const wt Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) wa))
(declare-const y PBitVec)
(assert (= (pbvsize y) wt))
(assert (< wa wt))
(assert (not (= (pbvand (pbvand (psign_extend (- wt wa) x) y) (pzero_extend (- wt wa) (pbvnot (int_to_pbv wa 0)))) (pbvand (pbvand (pzero_extend (- wt wa) x) y) (pzero_extend (- wt wa) (pbvnot (int_to_pbv wa 0)))))))
(check-sat)
