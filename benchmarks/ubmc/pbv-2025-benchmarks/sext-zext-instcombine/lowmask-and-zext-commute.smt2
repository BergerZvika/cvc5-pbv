; lowmask_add_zext_commute_thm (AND variant)
; ∀ (x : BitVec wa) (y : BitVec wt), wa < wt →
;   (y &&& zeroExtend wt x) &&& lowmask(wa,wt)
;   = zeroExtend wt (x &&& truncate wa y)
; where lowmask(wa,wt) = zeroExtend wt (allones wa) = 2^wa - 1 in wt bits
(set-logic PBV)
(declare-const wa Int)
(declare-const wt Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) wa))
(declare-const y PBitVec)
(assert (= (pbvsize y) wt))
(assert (< wa wt))
(assert (not (= (pbvand (pbvand y (pzero_extend (- wt wa) x)) (pzero_extend (- wt wa) (pbvnot (int_to_pbv wa 0)))) (pzero_extend (- wt wa) (pbvand x (pextract y (- wa 1) 0))))))
(check-sat)
