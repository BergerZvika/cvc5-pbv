; sext_xor_sub_2_thm (combined form)
; ∀ (x : BitVec wt) (c : BitVec 1) (wt : Int), 1 < wt →
;   signExtend wt c - (x ^^^ signExtend wt c) = ite(c = 1, x, 0 - x)
(set-logic PBV)
(declare-const wt Int)
(declare-const c PBitVec)
(assert (= (pbvsize c) 1))
(declare-const x PBitVec)
(assert (= (pbvsize x) wt))
(assert (< 1 wt))
(assert (not (= (pbvsub (psign_extend (- wt 1) c) (pbvxor x (psign_extend (- wt 1) c))) (ite (= c (int_to_pbv 1 1)) x (pbvsub (int_to_pbv wt 0) x)))))
(check-sat)
