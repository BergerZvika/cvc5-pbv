; ∀ (a b c d : BitVec w) (wt : Int), w < wt →
;   zeroExtend wt (ofBool (a == b)) &&& zeroExtend wt (ofBool (c == d))
;   = zeroExtend wt (ofBool (a == b) &&& ofBool (c == d))
(set-logic PBV)
(declare-const w Int)
(declare-const wt Int)
(declare-const a PBitVec)
(assert (= (pbvsize a) w))
(declare-const b PBitVec)
(assert (= (pbvsize b) w))
(declare-const c PBitVec)
(assert (= (pbvsize c) w))
(declare-const d PBitVec)
(assert (= (pbvsize d) w))
(assert (< w wt))
(assert (not (= (pbvand (pzero_extend (- wt 1) (ite (= a b) (int_to_pbv 1 1) (int_to_pbv 1 0))) (pzero_extend (- wt 1) (ite (= c d) (int_to_pbv 1 1) (int_to_pbv 1 0)))) (pzero_extend (- wt 1) (pbvand (ite (= a b) (int_to_pbv 1 1) (int_to_pbv 1 0)) (ite (= c d) (int_to_pbv 1 1) (int_to_pbv 1 0)))))))
(check-sat)
