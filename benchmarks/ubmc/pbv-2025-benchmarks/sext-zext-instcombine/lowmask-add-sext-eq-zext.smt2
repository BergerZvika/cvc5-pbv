; ∀ (x : BitVec wa) (y : BitVec wt), wa < wt →
;   (y + signExtend wt x) &&& lowmask(wa,wt)
;   = (y + zeroExtend wt x) &&& lowmask(wa,wt)
; (sext and zext differ only in high bits; addition low bits depend only on low bits of operands)
(set-logic PBV)
(declare-const wa Int)
(declare-const wt Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) wa))
(declare-const y PBitVec)
(assert (= (pbvsize y) wt))
(assert (< wa wt))
(assert (not (= (pbvand (pbvadd y (psign_extend (- wt wa) x)) (pzero_extend (- wt wa) (pbvnot (int_to_pbv wa 0)))) (pbvand (pbvadd y (pzero_extend (- wt wa) x)) (pzero_extend (- wt wa) (pbvnot (int_to_pbv wa 0)))))))
(check-sat)
