; sext_multi_uses_thm.extracted_1._1 (generalized)
; ∀ (x x2 : BitVec wt) (c : BitVec 1) (wt : Int), 1 < wt → c = 1 →
;   x2 * signExtend wt c + ((x ^^^ signExtend wt c) - signExtend wt c) = 0 - (x2 + x)
; (sext(1)=-1; x2*(-1)=-x2; (x^^^-1)-(-1)=~x+1=-x; -x2+(-x)=-(x2+x))
(set-logic PBV)
(declare-const wt Int)
(declare-const c PBitVec)
(assert (= (pbvsize c) 1))
(declare-const x PBitVec)
(assert (= (pbvsize x) wt))
(declare-const x2 PBitVec)
(assert (= (pbvsize x2) wt))
(assert (< 1 wt))
(assert (= c (int_to_pbv 1 1)))
(assert (not (= (pbvadd (pbvmul x2 (psign_extend (- wt 1) c)) (pbvsub (pbvxor x (psign_extend (- wt 1) c)) (psign_extend (- wt 1) c))) (pbvsub (int_to_pbv wt 0) (pbvadd x2 x)))))
(check-sat)
