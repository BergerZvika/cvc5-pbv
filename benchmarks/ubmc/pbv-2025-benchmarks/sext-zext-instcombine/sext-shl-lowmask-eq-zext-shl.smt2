; sext_shl_mask_thm (generalized)
; ∀ (x : BitVec wa) (s : BitVec wt) (wt : Int), wa < wt →
;   signExtend wt x <<< s &&& lowmask(wa,wt)
;   = zeroExtend wt x <<< s &&& lowmask(wa,wt)
; (sext and zext agree on low wa bits; shift doesn't change that for the masked portion)
(set-logic PBV)
(declare-const wa Int)
(declare-const wt Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) wa))
(declare-const s PBitVec)
(assert (= (pbvsize s) wt))
(assert (< wa wt))
(assert (not (= (pbvand (pbvshl (psign_extend (- wt wa) x) s) (pzero_extend (- wt wa) (pbvnot (int_to_pbv wa 0)))) (pbvand (pbvshl (pzero_extend (- wt wa) x) s) (pzero_extend (- wt wa) (pbvnot (int_to_pbv wa 0)))))))
(check-sat)
