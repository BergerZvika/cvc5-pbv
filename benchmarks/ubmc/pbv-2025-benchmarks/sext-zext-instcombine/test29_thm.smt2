(set-logic PBV)
(declare-const w1 Int)
(declare-const w2 Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) w2))
(declare-const y PBitVec)
(assert (= (pbvsize y) w2))
(assert (<= w1 w2))
(assert (not (= (pzero_extend (- w2 w1) (pbvor (pextract y (- w1 1) 0) (pextract x (- w1 1) 0))) (pbvand (pbvor y x) (pzero_extend (- w2 w1) (int_to_pbv w1 -1))))))
(check-sat)
