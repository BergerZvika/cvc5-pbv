; ∀ (x y : BitVec wa) (wt : Int), wa < wt →
;   zeroExtend wt (x * y) = zeroExtend wt x * zeroExtend wt y &&& lowmask(wa,wt)
; (multiplication modulo 2^wa is the same in both)
(set-logic PBV)
(declare-const wa Int)
(declare-const wt Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) wa))
(declare-const y PBitVec)
(assert (= (pbvsize y) wa))
(assert (< wa wt))
(assert (not (= (pzero_extend (- wt wa) (pbvmul x y)) (pbvand (pbvmul (pzero_extend (- wt wa) x) (pzero_extend (- wt wa) y)) (pzero_extend (- wt wa) (pbvnot (int_to_pbv wa 0)))))))
(check-sat)
