; OrZextOr_thm (generalized)
; ∀ (x c : BitVec wa) (d : BitVec wt), wa < wt →
;   zeroExtend wt (x ||| c) ||| d = zeroExtend wt x ||| (zeroExtend wt c ||| d)
(set-logic PBV)
(declare-const wa Int)
(declare-const wt Int)
(declare-const x PBitVec)
(assert (= (pbvsize x) wa))
(declare-const c PBitVec)
(assert (= (pbvsize c) wa))
(declare-const d PBitVec)
(assert (= (pbvsize d) wt))
(assert (< wa wt))
(assert (not (= (pbvor (pzero_extend (- wt wa) (pbvor x c)) d) (pbvor (pzero_extend (- wt wa) x) (pbvor (pzero_extend (- wt wa) c) d)))))
(check-sat)
