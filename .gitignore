# The repository only holds what GitHub Pages needs to run the WebAssembly playground.
# Everything else in this directory (artifact scripts, solvers, benchmarks, ...) stays local.
/*
!/index.html
!/wasm/
!/.nojekyll
!/.gitignore
!/benchmarks/
/benchmarks/*
!/benchmarks/index.json
!/benchmarks/pbv/
!/benchmarks/cav26/
!/benchmarks/eia/
!/benchmarks/oopsla26/
!/paper/
